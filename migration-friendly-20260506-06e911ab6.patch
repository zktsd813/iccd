+      exit 1
+    fi
+  else
+    echo "Error: --numa-node0-cpus must be range format start-end (example: 0-15)" >&2
+    exit 1
+  fi
+fi
+
+if [[ "${BUILD_INITRD}" == "1" ]]; then
+  if ! command -v "${DRACUT_BIN}" >/dev/null 2>&1; then
+    echo "Error: dracut binary not found: ${DRACUT_BIN}" >&2
+    exit 1
+  fi
+
+  KERNEL_DIR_ABS="$(cd "${KERNEL_DIR}" && pwd)"
+  ARTIFACT_DIR_ABS="$(mkdir -p "${ARTIFACT_DIR}" && cd "${ARTIFACT_DIR}" && pwd)"
+  MOD_STAGE="${ARTIFACT_DIR_ABS}/mod-stage"
+  rm -rf "${MOD_STAGE}"
+  mkdir -p "${MOD_STAGE}"
+
+  run_cmd make -C "${KERNEL_DIR_ABS}" -j"${BUILD_JOBS}" bzImage modules
+
+  KREL="$(
+    if [[ "${DRY_RUN}" == "0" ]]; then
+      make -s -C "${KERNEL_DIR_ABS}" kernelrelease
+    else
+      echo "<kernelrelease>"
+    fi
+  )"
+
+  if [[ -z "${INITRD_NAME}" ]]; then
+    INITRD_NAME="initramfs-${KREL}.img"
+  fi
+  INITRD_IMAGE="${ARTIFACT_DIR_ABS}/${INITRD_NAME}"
+
+  if [[ "${STRIP_MODULES}" == "1" ]]; then
+    run_cmd make -C "${KERNEL_DIR_ABS}" modules_install INSTALL_MOD_PATH="${MOD_STAGE}" INSTALL_MOD_STRIP=1
+  else
+    run_cmd make -C "${KERNEL_DIR_ABS}" modules_install INSTALL_MOD_PATH="${MOD_STAGE}"
+  fi
+
+  if [[ "${DRY_RUN}" == "0" ]]; then
+    run_cmd depmod -b "${MOD_STAGE}" "${KREL}"
+  else
+    run_cmd depmod -b "${MOD_STAGE}" "<kernelrelease>"
+  fi
+
+  DRACUT_ARGS=(
+    --force
+    --kver "${KREL}"
+    --kmoddir "${MOD_STAGE}/lib/modules/${KREL}"
+    --add-drivers "virtio virtio_pci virtio_ring virtio_net e1000 e1000e"
+  )
+  if [[ "${HOSTONLY}" == "0" ]]; then
+    DRACUT_ARGS+=( --no-hostonly )
+  fi
+  run_cmd "${DRACUT_BIN}" "${DRACUT_ARGS[@]}" "${INITRD_IMAGE}"
+fi
+
+if [[ ! -f "${KERNEL_IMAGE}" && "${DRY_RUN}" == "0" ]]; then
+  echo "Error: kernel image not found: ${KERNEL_IMAGE}" >&2
+  exit 1
+fi
+
+if [[ -n "${INITRD_IMAGE}" && ! -f "${INITRD_IMAGE}" && "${DRY_RUN}" == "0" ]]; then
+  echo "Error: initrd image not found: ${INITRD_IMAGE}" >&2
+  exit 1
+fi
+
