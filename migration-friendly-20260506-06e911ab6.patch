+#!/usr/bin/env bash
+set -euo pipefail
+
+SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
+REPO_ROOT="$(cd "${SCRIPT_DIR}/../.." && pwd)"
+QEMU_TREE="${QEMU_TREE:-/Serverless/Migration-friendly/qemu}"
+LAUNCHER="${LAUNCHER:-${SCRIPT_DIR}/launch_kernel_qemu.sh}"
+GUEST_SCRIPT="${GUEST_SCRIPT:-${SCRIPT_DIR}/validate_adaptive_migration_smoke.sh}"
+WORKLOAD_SCRIPT="${WORKLOAD_SCRIPT:-${SCRIPT_DIR}/tenant_b_cmd.sh}"
+OUTDIR="${OUTDIR:-${SCRIPT_DIR}/qemu-logs/adaptive_migration_smoke}"
+RUN_ID="${RUN_ID:-$(date -u +%Y%m%dT%H%M%SZ)}"
+SSH_PORT="${SSH_PORT:-10022}"
+SSH_KEY="${SSH_KEY:-${QEMU_TREE}/tests/keys/id_rsa}"
+SSH_USERS="${SSH_USERS:-root ubuntu}"
+SSH_PASSWORD="${SSH_PASSWORD:-}"
+SSH_EXPECT_TIMEOUT="${SSH_EXPECT_TIMEOUT:-600}"
+SSH_CONNECT_TIMEOUT="${SSH_CONNECT_TIMEOUT:-10}"
+SSH_SERVER_ALIVE_INTERVAL="${SSH_SERVER_ALIVE_INTERVAL:-30}"
+SSH_SERVER_ALIVE_COUNT_MAX="${SSH_SERVER_ALIVE_COUNT_MAX:-10}"
+SSH_KEY_RUNTIME="${SSH_KEY_RUNTIME:-${OUTDIR}/id_rsa}"
+SSH_OPTS_COMMON=(
+  -o BatchMode=yes
+  -o StrictHostKeyChecking=no
+  -o UserKnownHostsFile=/dev/null
+  -o ConnectTimeout="${SSH_CONNECT_TIMEOUT}"
+  -o ServerAliveInterval="${SSH_SERVER_ALIVE_INTERVAL}"
+  -o ServerAliveCountMax="${SSH_SERVER_ALIVE_COUNT_MAX}"
+)
+
+ROOTFS="${ROOTFS:-${SCRIPT_DIR}/vm-images/adaptive-migration-base.qcow2}"
+ROOTFS_FORMAT="${ROOTFS_FORMAT:-qcow2}"
+if [[ ! -f "${ROOTFS}" ]]; then
+  ROOTFS="${QEMU_TREE}/build/ubuntu.img"
+  ROOTFS_FORMAT="raw"
+fi
+KERNEL_DIR="${KERNEL_DIR:-${REPO_ROOT}}"
+KERNEL_IMAGE="${KERNEL_IMAGE:-${KERNEL_DIR}/arch/x86/boot/bzImage}"
+QEMU_BIN="${QEMU_BIN:-${QEMU_TREE}/build/qemu-system-x86_64}"
+MEMORY="${MEMORY:-16G}"
+CPUS="${CPUS:-4}"
+NUMA_NODE0_CPUS="${NUMA_NODE0_CPUS:-0-1}"
+NUMA_NODE0_MEM="${NUMA_NODE0_MEM:-8G}"
+NUMA_NODE1_MEM="${NUMA_NODE1_MEM:-8G}"
+VM_NAME="${VM_NAME:-adaptive-migration-smoke}"
+CMDLINE="${CMDLINE:-console=ttyS0 root=/dev/vda2 rw loglevel=7 nokaslr}"
+HOST_LOG="${HOST_LOG:-${OUTDIR}/launch.log}"
+REMOTE_VALIDATION="/root/validate_adaptive_migration_smoke.sh"
+REMOTE_WORKLOAD="/root/adaptive_workload.sh"
+REMOTE_OUTDIR="${REMOTE_OUTDIR:-/tmp/adaptive_migration_smoke}"
+WORKLOAD_CMD="${WORKLOAD_CMD:-${REMOTE_WORKLOAD} 4096 90}"
+GLOBAL_NUMA_BALANCING="${GLOBAL_NUMA_BALANCING:-2}"
+DEMOTION_SRC_NODE="${DEMOTION_SRC_NODE:-0}"
+DEMOTION_DST_NODE="${DEMOTION_DST_NODE:-1}"
+CPU_NODE="${CPU_NODE:-0}"
+MEM_NODE="${MEM_NODE:-1}"
+SAMPLE_SEC="${SAMPLE_SEC:-5}"
+DRY_RUN="${DRY_RUN:-0}"
+QEMU_EXTRA_ARGS="${QEMU_EXTRA_ARGS:-}"
+
+mkdir -p "${OUTDIR}"
+
+SSH_KEY_IS_TEMP=0
+if [[ "${SSH_KEY_RUNTIME}" != "${SSH_KEY}" ]]; then
+  install -m 600 "${SSH_KEY}" "${SSH_KEY_RUNTIME}"
+  SSH_KEY_IS_TEMP=1
+fi
+
+if [[ "${SSH_KEY_IS_TEMP}" == "1" ]]; then
+  SSH_KEY="${SSH_KEY_RUNTIME}"
+fi
+SSH_OPTS=("${SSH_OPTS_COMMON[@]}" -i "${SSH_KEY}")
+
+run_pexpect_cmd() {
+  python3 - "$SSH_PASSWORD" "$SSH_EXPECT_TIMEOUT" "$@" <<'PY'
+import sys
+import pexpect
+
+password = sys.argv[1]
+timeout = int(sys.argv[2])
+cmd = sys.argv[3:]
+child = pexpect.spawn(cmd[0], cmd[1:], encoding="utf-8", timeout=timeout)
+child.logfile = sys.stdout
+
+while True:
+    idx = child.expect([
+        r"Are you sure you want to continue connecting \(yes/no(/\[fingerprint\])?\)\?",
+        r"[Pp]assword:",
+        pexpect.EOF,
+        pexpect.TIMEOUT,
+    ])
+    if idx == 0:
+        child.sendline("yes")
+    elif idx == 1:
+        child.sendline(password)
+    elif idx == 2:
+        break
+    else:
+        raise SystemExit(124)
+
+child.close()
+raise SystemExit(child.exitstatus or 0)
+PY
+}
+
+ssh_run() {
+  if [[ -n "${SSH_PASSWORD}" ]]; then
+    run_pexpect_cmd ssh \
+      -o StrictHostKeyChecking=no \
+      -o UserKnownHostsFile=/dev/null \
+      -o ConnectTimeout="${SSH_CONNECT_TIMEOUT}" \
+      -o ServerAliveInterval="${SSH_SERVER_ALIVE_INTERVAL}" \
+      -o ServerAliveCountMax="${SSH_SERVER_ALIVE_COUNT_MAX}" \
+      -p "${SSH_PORT}" \
+      "$@"
+  else
+    ssh "${SSH_OPTS[@]}" -p "${SSH_PORT}" "$@"
+  fi
+}
+
+scp_run() {
+  if [[ -n "${SSH_PASSWORD}" ]]; then
+    run_pexpect_cmd scp \
+      -o StrictHostKeyChecking=no \
+      -o UserKnownHostsFile=/dev/null \
+      -o ConnectTimeout="${SSH_CONNECT_TIMEOUT}" \
+      -P "${SSH_PORT}" \
+      "$@"
+  else
+    scp "${SSH_OPTS[@]}" -P "${SSH_PORT}" "$@"
+  fi
+}
+
+cleanup() {
+  local rc=$?
+  if [[ "${SSH_KEY_IS_TEMP}" == "1" ]]; then
+    rm -f "${SSH_KEY_RUNTIME}" 2>/dev/null || true
+  fi
+  if [[ -n "${QEMU_PID:-}" ]] && kill -0 "${QEMU_PID}" 2>/dev/null; then
+    kill -INT "${QEMU_PID}" 2>/dev/null || true
+    wait "${QEMU_PID}" 2>/dev/null || true
+  fi
+  return "${rc}"
+}
+trap cleanup EXIT
+
+launch_guest() {
+  local launch_args=(
+    --rootfs "${ROOTFS}"
+    --rootfs-format "${ROOTFS_FORMAT}"
+    --kernel-dir "${KERNEL_DIR}"
+    --kernel-image "${KERNEL_IMAGE}"
+    --qemu-bin "${QEMU_BIN}"
+    --ssh-forward-port "${SSH_PORT}"
+    --memory "${MEMORY}"
+    --cpus "${CPUS}"
+    --numa-node0-cpus "${NUMA_NODE0_CPUS}"
+    --numa-node0-mem "${NUMA_NODE0_MEM}"
+    --numa-node1-mem "${NUMA_NODE1_MEM}"
+    --name "${VM_NAME}"
+    --cmdline "${CMDLINE}"
+  )
+
+  if [[ -n "${QEMU_EXTRA_ARGS}" ]]; then
+    # shellcheck disable=SC2206
+    launch_args+=( ${QEMU_EXTRA_ARGS} )
+  fi
+
+  if [[ "${DRY_RUN}" == "1" ]]; then
+    "${LAUNCHER}" "${launch_args[@]}" --dry-run
+    return 0
+  fi
+
+  echo "[host] launching QEMU"
+  echo "[host] log: ${HOST_LOG}"
+  "${LAUNCHER}" "${launch_args[@]}" > "${HOST_LOG}" 2>&1 &
+  QEMU_PID=$!
+}
+
+wait_for_ssh() {
+  local deadline=$((SECONDS + 300))
+  local user
+
+  while (( SECONDS < deadline )); do
+    for user in ${SSH_USERS}; do
+      if ssh_run "${user}@127.0.0.1" "true" >/dev/null 2>&1; then
+        QEMU_SSH_USER="${user}"
+        return 0
+      fi
+    done
+    sleep 2
+  done
+
+  echo "timed out waiting for guest SSH on port ${SSH_PORT}" >&2
+  return 1
+}
+
+run_guest_validation() {
+  local remote_cmd
+  local kv
+
+  echo "[host] copying guest scripts"
+  scp_run "${GUEST_SCRIPT}" "${QEMU_SSH_USER}@127.0.0.1:${REMOTE_VALIDATION}"
+  scp_run "${WORKLOAD_SCRIPT}" "${QEMU_SSH_USER}@127.0.0.1:${REMOTE_WORKLOAD}"
+  ssh_run "${QEMU_SSH_USER}@127.0.0.1" "chmod +x ${REMOTE_VALIDATION} ${REMOTE_WORKLOAD}"
+
+  remote_cmd="env"
+  for kv in \
+    "OUTDIR=${REMOTE_OUTDIR}" \
+    "WORKLOAD_CMD=${WORKLOAD_CMD}" \
+    "GLOBAL_NUMA_BALANCING=${GLOBAL_NUMA_BALANCING}" \
+    "DEMOTION_SRC_NODE=${DEMOTION_SRC_NODE}" \
+    "DEMOTION_DST_NODE=${DEMOTION_DST_NODE}" \
+    "CPU_NODE=${CPU_NODE}" \
+    "MEM_NODE=${MEM_NODE}" \
+    "SAMPLE_SEC=${SAMPLE_SEC}"
+  do
+    remote_cmd+=" $(printf '%q' "${kv}")"
+  done
+  remote_cmd+=" bash $(printf '%q' "${REMOTE_VALIDATION}")"
+
+  echo "[host] running guest validation as ${QEMU_SSH_USER}"
+  ssh_run "${QEMU_SSH_USER}@127.0.0.1" "${remote_cmd}"
+}
+
+collect_artifacts() {
+  local target="${OUTDIR}/guest-artifacts/${RUN_ID}-${VM_NAME}"
+  mkdir -p "${OUTDIR}/guest-artifacts"
+  rm -rf "${target}"
+  mkdir -p "${target}"
+  scp_run -r "${QEMU_SSH_USER}@127.0.0.1:${REMOTE_OUTDIR}" "${target}/" >/dev/null
+  echo "[host] collected artifacts at ${target}"
+}
+
+if [[ "${DRY_RUN}" == "1" ]]; then
+  launch_guest
+  echo
+  echo "[host] dry-run remote workload: ${WORKLOAD_CMD}"
+  exit 0
+fi
+
+launch_guest
+wait_for_ssh
+echo "[host] guest SSH ready as ${QEMU_SSH_USER}"
+run_guest_validation
+collect_artifacts
+ssh_run "${QEMU_SSH_USER}@127.0.0.1" "sudo -n poweroff" >/dev/null 2>&1 || \
+  ssh_run "${QEMU_SSH_USER}@127.0.0.1" "poweroff" >/dev/null 2>&1 || true
