+wait_for_prefault_ready() {
+  local ready_file="$1"
+  local pid="$2"
+  local timeout_sec="$3"
+  local waited=0
+  local max_wait
+
+  max_wait=$((timeout_sec * 10))
+  while [[ ! -f "${ready_file}" ]]; do
+    if ! kill -0 "${pid}" 2>/dev/null; then
+      return 1
+    fi
+    if (( waited >= max_wait )); then
+      return 124
+    fi
+    sleep 0.1
+    waited=$((waited + 1))
+  done
+
+  return 0
+}
