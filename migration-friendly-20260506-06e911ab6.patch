+  MEM1_BACKEND="memory-backend-ram,id=mem1,size=${NUMA_NODE1_MEM}"
+  if [[ -n "${NUMA_NODE0_HOST_NODES}" ]]; then
+    MEM0_BACKEND+=",host-nodes=${NUMA_NODE0_HOST_NODES},policy=${NUMA_MEM_POLICY}"
+  fi
+  if [[ -n "${NUMA_NODE1_HOST_NODES}" ]]; then
+    MEM1_BACKEND+=",host-nodes=${NUMA_NODE1_HOST_NODES},policy=${NUMA_MEM_POLICY}"
+  fi
+  if [[ "${NUMA_PREALLOC}" == "1" ]]; then
+    MEM0_BACKEND+=",prealloc=on"
+    MEM1_BACKEND+=",prealloc=on"
+  fi
+  QEMU_CMD+=(
+    -object "${MEM0_BACKEND}"
+    -object "${MEM1_BACKEND}"
+    -numa "node,nodeid=0,cpus=${NUMA_NODE0_CPUS},memdev=mem0"
+    -numa "node,nodeid=1,memdev=mem1"
+  )
+fi
+
+if [[ "${USE_KVM}" == "1" ]]; then
+  QEMU_CMD+=( -accel kvm )
+else
+  QEMU_CMD+=( -accel tcg )
+fi
+
+if [[ -n "${INITRD_IMAGE}" ]]; then
+  QEMU_CMD+=( -initrd "${INITRD_IMAGE}" )
+fi
+
+if [[ "${ENABLE_GDB}" == "1" ]]; then
+  QEMU_CMD+=( -S -s )
+fi
+
+RUN_CMD=("${QEMU_CMD[@]}")
+if [[ -n "${HOST_CPUS}" ]]; then
+  RUN_CMD=(taskset -c "${HOST_CPUS}" "${QEMU_CMD[@]}")
+fi
+
+echo "QEMU launch plan"
+echo "  repo root : ${REPO_ROOT}"
+echo "  kernel    : ${KERNEL_IMAGE}"
+echo "  rootfs    : ${ROOTFS_IMAGE}"
+echo "  rootfs fmt: ${ROOTFS_FORMAT}"
+echo "  drive if  : ${DRIVE_IF}"
+echo "  net dev   : ${NET_DEVICE}"
+echo "  machine   : ${MACHINE_TYPE}"
+echo "  root dev  : ${ROOT_DEVICE}"
+if [[ -n "${INITRD_IMAGE}" ]]; then
+  echo "  initrd    : ${INITRD_IMAGE}"
+fi
+if [[ "${BUILD_INITRD}" == "1" ]]; then
+  echo "  build initrd: enabled (jobs=${BUILD_JOBS}, strip=${STRIP_MODULES}, hostonly=${HOSTONLY})"
+fi
+echo "  accel     : $([[ "${USE_KVM}" == "1" ]] && echo kvm || echo tcg)"
+echo "  cpus/mem  : ${CPUS} / ${MEMORY}"
+if [[ -n "${HOST_CPUS}" ]]; then
+  echo "  host cpus : ${HOST_CPUS}"
+fi
+if [[ "${ENABLE_NUMA_LAYOUT}" == "1" ]]; then
+  echo "  numa n0   : cpus=${NUMA_NODE0_CPUS}, mem=${NUMA_NODE0_MEM}"
+  echo "  numa n1   : mem=${NUMA_NODE1_MEM}"
+  if [[ -n "${NUMA_NODE0_HOST_NODES}" || -n "${NUMA_NODE1_HOST_NODES}" ]]; then
+    echo "  host numa : n0=${NUMA_NODE0_HOST_NODES:-default}, n1=${NUMA_NODE1_HOST_NODES:-default}, policy=${NUMA_MEM_POLICY}, prealloc=${NUMA_PREALLOC}"
+  fi
+else
+  echo "  numa      : disabled (--no-numa-layout)"
+fi
+echo "  serial log: ${SERIAL_LOG}"
+echo "  qmp socket: ${QMP_SOCK}"
+echo "  ssh fwd   : host ${SSH_FORWARD_PORT} -> guest 22"
+if [[ "${DAEMONIZE}" == "1" ]]; then
+  echo "  daemonize : enabled"
+fi
+echo
+printf 'Command:\n  '
+printf '%q ' "${RUN_CMD[@]}"
+echo
+
+if [[ "${DRY_RUN}" == "1" ]]; then
+  echo
+  echo "Dry-run mode: command was not executed."
+  exit 0
+fi
+
+exec "${RUN_CMD[@]}"
