+vCPUs: 32 on node0
+arena_size: 16G
+cgroup local capacity: node0 4194304 pages = 16 GiB
+global_numa_on: 0
+node_balancing_on: 2
+kswapd_demotion_on: 1
+off_demotion_on: 1
+numa_scan_size_mb: 2048
+scan_period_scale: 1
