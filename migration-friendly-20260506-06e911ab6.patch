+  REPORT_PATH="${report_dir}/${RUN_ID}-${VM_NAME}-${CASE}.md"
+  python3 "${REPORT_RENDERER}" \
+    --artifact-root "${artifact_dir}" \
+    --report "${REPORT_PATH}" \
+    --run-id "${RUN_ID}" \
+    --case "${CASE}" \
+    --vm-name "${VM_NAME}" \
+    --memory "${MEMORY}" \
+    --cpus "${CPUS}" \
+    --cmd-a "${CMD_A}" \
+    --cmd-b "${CMD_B}" \
+    --scan-scale-a "${SCAN_PERIOD_SCALE_A}" \
+    --scan-scale-b "${SCAN_PERIOD_SCALE_B}" \
+    --hot-threshold-a "${HOT_THRESHOLD_MS_A}" \
+    --hot-threshold-b "${HOT_THRESHOLD_MS_B}" \
+    --capacity-pages "${CAPACITY_PAGES}"
+}
+
+poweroff_guest() {
+  ssh_run "${QEMU_SSH_USER}@127.0.0.1" "sudo -n poweroff" >/dev/null 2>&1 || \
+    ssh_run "${QEMU_SSH_USER}@127.0.0.1" "poweroff" >/dev/null 2>&1 || true
+}
+
+main() {
+  launch_guest
+  wait_for_ssh
+  echo "[host] guest SSH ready as ${QEMU_SSH_USER}"
+  run_guest_validation
+  collect_artifacts
+  generate_report "${LAST_ARTIFACT_DIR}"
+  poweroff_guest
+  wait "${QEMU_PID}" || true
+
+  echo "[done] validation artifacts stored in ${OUTDIR}"
+  echo "[done] guest output: ${LAST_ARTIFACT_DIR}"
+  echo "[done] report: ${REPORT_PATH}"
+}
+
+main "$@"
diff --git a/scripts/kernel/run_qemu_mlc_probe.sh b/scripts/kernel/run_qemu_mlc_probe.sh
new file mode 100755
index 000000000..932cb8066
--- /dev/null
+++ b/scripts/kernel/run_qemu_mlc_probe.sh
@@ -0,0 +1,246 @@
+#!/usr/bin/env bash
+set -euo pipefail
+
+usage() {
+  cat <<'EOF'
+Usage:
+  run_qemu_mlc_probe.sh [options]
+
+Boot a paper-topology VM, run Intel MLC latency and bandwidth matrix probes
+inside the guest, then collect the raw logs back to the host.
+
+Options:
+  --kernel-image <path>     bzImage path
+  --kernel-dir <path>       Kernel tree (default: this repo root)
+  --kernel-label <name>     Label used in result paths (default: current tree name)
+  --rootfs-base <path>      Base paper-workload overlay
+  --local-dram <size>       Guest node0 size (default: 32G)
+  --remote-mem <size>       Guest node1 size (default: 128G)
+  --run-id <id>             Result directory tag
+  --mlc-bin <path>          Host mlc binary to copy into the guest
+  -h, --help                Show this help
+EOF
+}
+
+SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
+REPO_ROOT="$(cd "${SCRIPT_DIR}/../.." && pwd)"
+LAUNCHER="${SCRIPT_DIR}/launch_paper_topology_qemu.sh"
+ROOTFS_BASE="${SCRIPT_DIR}/vm-images/adaptive-migration-paper-workloads.qcow2"
+KERNEL_DIR="${REPO_ROOT}"
+KERNEL_IMAGE=""
+KERNEL_LABEL="$(basename "${REPO_ROOT}")"
+LOCAL_DRAM="32G"
+REMOTE_MEM="128G"
+RUN_ID="$(date -u +%Y%m%dT%H%M%SZ)"
+MLC_BIN="/Serverless/benchmark/mlc/Linux/mlc"
+RESULTS_DIR="${SCRIPT_DIR}/qemu-results/mlc-probe"
+OVERLAY_DIR="${SCRIPT_DIR}/vm-images"
+NBD_DEVICE="${NBD_DEVICE:-/dev/nbd0}"
+MOUNT_DIR="${MOUNT_DIR:-/tmp/paper-mlc-root}"
+RUN_DIR=""
+OVERLAY_IMAGE=""
+HOST_LOG=""
+SERIAL_LOG=""
+ROOT_MAPPER=""
+NBD_ACTIVE=0
+MOUNT_ACTIVE=0
+
+while [[ $# -gt 0 ]]; do
+  case "$1" in
+    --kernel-image)
+      KERNEL_IMAGE="${2:-}"; shift 2 ;;
+    --kernel-dir)
+      KERNEL_DIR="${2:-}"; shift 2 ;;
+    --kernel-label)
+      KERNEL_LABEL="${2:-}"; shift 2 ;;
+    --rootfs-base)
+      ROOTFS_BASE="${2:-}"; shift 2 ;;
+    --local-dram)
+      LOCAL_DRAM="${2:-}"; shift 2 ;;
+    --remote-mem)
+      REMOTE_MEM="${2:-}"; shift 2 ;;
+    --run-id)
+      RUN_ID="${2:-}"; shift 2 ;;
+    --mlc-bin)
+      MLC_BIN="${2:-}"; shift 2 ;;
+    -h|--help)
+      usage; exit 0 ;;
+    *)
+      echo "Unknown option: $1" >&2
+      usage >&2
+      exit 1 ;;
+  esac
+done
+
+if [[ -z "${KERNEL_IMAGE}" ]]; then
+  KERNEL_IMAGE="${KERNEL_DIR}/arch/x86/boot/bzImage"
+fi
+
+if [[ ! -f "${ROOTFS_BASE}" ]]; then
+  echo "base rootfs not found: ${ROOTFS_BASE}" >&2
+  exit 1
+fi
+
+if [[ ! -f "${KERNEL_IMAGE}" ]]; then
+  echo "kernel image not found: ${KERNEL_IMAGE}" >&2
+  exit 1
+fi
+
+if [[ ! -x "${MLC_BIN}" ]]; then
+  echo "mlc binary not found or not executable: ${MLC_BIN}" >&2
+  exit 1
+fi
+
+RUN_DIR="${RESULTS_DIR}/${RUN_ID}-${KERNEL_LABEL}-${LOCAL_DRAM}"
+OVERLAY_IMAGE="${OVERLAY_DIR}/mlc-probe-${RUN_ID}-${KERNEL_LABEL}-${LOCAL_DRAM}.qcow2"
+HOST_LOG="${RUN_DIR}/host-launch.log"
+SERIAL_LOG="${SCRIPT_DIR}/qemu-logs/mlc-${KERNEL_LABEL}-$(date +%Y%m%d_%H%M%S).serial.log"
+
+mkdir -p "${RUN_DIR}" "${OVERLAY_DIR}"
+
+sudo_run() {
+  sudo -n "$@"
+}
+
+cleanup() {
+  local rc=$?
+  if [[ "${MOUNT_ACTIVE}" == "1" ]]; then
+    sudo_run umount "${MOUNT_DIR}" || true
+  fi
+  if [[ -n "${ROOT_MAPPER}" ]]; then
+    sudo_run kpartx -d "${NBD_DEVICE}" >/dev/null || true
+  fi
+  if [[ "${NBD_ACTIVE}" == "1" ]]; then
+    sudo_run qemu-nbd --disconnect "${NBD_DEVICE}" >/dev/null || true
+  fi
+  return "${rc}"
+}
+trap cleanup EXIT
+
+create_overlay() {
+  rm -f "${OVERLAY_IMAGE}"
+  qemu-img create -f qcow2 -F qcow2 -b "${ROOTFS_BASE}" "${OVERLAY_IMAGE}" >/dev/null
+}
+
+mount_overlay() {
+  sudo_run qemu-nbd --disconnect "${NBD_DEVICE}" >/dev/null 2>&1 || true
+  sudo_run qemu-nbd --connect="${NBD_DEVICE}" "${OVERLAY_IMAGE}"
+  NBD_ACTIVE=1
+  sleep 1
+  sudo_run kpartx -av "${NBD_DEVICE}" >/dev/null
+  ROOT_MAPPER="/dev/mapper/$(basename "${NBD_DEVICE}")p2"
+  sudo_run mkdir -p "${MOUNT_DIR}"
+  sudo_run mount "${ROOT_MAPPER}" "${MOUNT_DIR}"
+  MOUNT_ACTIVE=1
+}
+
+unmount_overlay() {
+  if [[ "${MOUNT_ACTIVE}" == "1" ]]; then
+    sudo_run umount "${MOUNT_DIR}"
+    MOUNT_ACTIVE=0
+  fi
+  if [[ -n "${ROOT_MAPPER}" ]]; then
+    sudo_run kpartx -d "${NBD_DEVICE}" >/dev/null || true
+    ROOT_MAPPER=""
+  fi
+  if [[ "${NBD_ACTIVE}" == "1" ]]; then
+    sudo_run qemu-nbd --disconnect "${NBD_DEVICE}" >/dev/null || true
+    NBD_ACTIVE=0
+  fi
+}
+
+inject_guest_service() {
+  sudo_run install -D -m 0755 "${MLC_BIN}" "${MOUNT_DIR}/usr/local/bin/mlc"
+
+  sudo_run tee "${MOUNT_DIR}/usr/local/sbin/paper-mlc-probe.sh" >/dev/null <<'EOF'
+#!/usr/bin/env bash
+set -euo pipefail
+
+LOG=/var/log/paper-mlc-probe.log
+LAT=/var/log/paper-mlc-latency.txt
+BW=/var/log/paper-mlc-bandwidth.txt
+
+exec >>"${LOG}" 2>&1
+
+echo "[paper-mlc] start $(date -u +%Y-%m-%dT%H:%M:%SZ)"
+numactl -H || true
+
+if [[ -w /sys/devices/system/cpu/smt/control ]]; then
+  echo off > /sys/devices/system/cpu/smt/control || true
+fi
+
+if [[ -w /sys/kernel/mm/transparent_hugepage/enabled ]]; then
+  echo never > /sys/kernel/mm/transparent_hugepage/enabled || true
+fi
+if [[ -w /sys/kernel/mm/transparent_hugepage/defrag ]]; then
+  echo never > /sys/kernel/mm/transparent_hugepage/defrag || true
+fi
+
+sudo -n modprobe msr || modprobe msr || true
+
+echo "[paper-mlc] latency_matrix"
+/usr/local/bin/mlc --latency_matrix -X >"${LAT}" 2>&1
+cat "${LAT}"
+
+echo "[paper-mlc] bandwidth_matrix"
+/usr/local/bin/mlc --bandwidth_matrix -X >"${BW}" 2>&1
+cat "${BW}"
+
+sync
+sleep 1
+systemctl --no-block poweroff || poweroff -f || true
+EOF
+  sudo_run chmod 0755 "${MOUNT_DIR}/usr/local/sbin/paper-mlc-probe.sh"
+
+  sudo_run tee "${MOUNT_DIR}/etc/systemd/system/paper-mlc-probe.service" >/dev/null <<'EOF'
+[Unit]
+Description=Paper MLC probe
+After=multi-user.target
+Wants=multi-user.target
+
+[Service]
+Type=oneshot
+ExecStart=/usr/local/sbin/paper-mlc-probe.sh
+TimeoutStartSec=infinity
+
+[Install]
+WantedBy=multi-user.target
+EOF
+
+  sudo_run ln -sfn ../paper-mlc-probe.service "${MOUNT_DIR}/etc/systemd/system/multi-user.target.wants/paper-mlc-probe.service"
+  sudo_run ln -sfn /dev/null "${MOUNT_DIR}/etc/systemd/system/systemd-networkd-wait-online.service"
+}
+
+collect_results() {
+  local name
+  for name in paper-mlc-probe.log paper-mlc-latency.txt paper-mlc-bandwidth.txt; do
+    if [[ -f "${MOUNT_DIR}/var/log/${name}" ]]; then
+      sudo_run cp "${MOUNT_DIR}/var/log/${name}" "${RUN_DIR}/${name}"
+      sudo_run chown "$(id -u):$(id -g)" "${RUN_DIR}/${name}"
+    fi
+  done
+}
+
+create_overlay
+mount_overlay
+inject_guest_service
+unmount_overlay
+
+"${LAUNCHER}" \
+  --rootfs "${OVERLAY_IMAGE}" \
+  --rootfs-format qcow2 \
+  --kernel-dir "${KERNEL_DIR}" \
+  --kernel-image "${KERNEL_IMAGE}" \
+  --local-dram "${LOCAL_DRAM}" \
+  --remote-mem "${REMOTE_MEM}" \
+  --name "mlc-probe" \
+  --serial-log "${SERIAL_LOG}" \
+  > "${HOST_LOG}" 2>&1
+
+mount_overlay
+collect_results
+unmount_overlay
+
+echo "run_dir=${RUN_DIR}"
+echo "latency_log=${RUN_DIR}/paper-mlc-latency.txt"
+echo "bandwidth_log=${RUN_DIR}/paper-mlc-bandwidth.txt"
