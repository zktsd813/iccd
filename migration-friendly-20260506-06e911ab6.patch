@@ -0,0 +1,377 @@
+#!/usr/bin/env bash
+set -euo pipefail
+
+# Validate that scheduler-driven NUMA balancing work is scoped to the memcg
+# whose memory.node_balancing mode is enabled.
+
+SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
+CGROOT="${CGROOT:-/sys/fs/cgroup}"
+CG_A="${CG_A:-numa_scope_A}"
+CG_B="${CG_B:-numa_scope_B}"
+CAPACITY_PAGES="${CAPACITY_PAGES:-2097152}"  # 8GiB / 4KiB
+CMD_A="${CMD_A:-/root/bc -g 26}"
+CMD_B="${CMD_B:-/root/pr -g 26}"
+NODE_BALANCING_MODE_A="${NODE_BALANCING_MODE_A:-2}"
+NODE_BALANCING_MODE_B="${NODE_BALANCING_MODE_B:-0}"
+KSWAPD_DEMOTION_ENABLED="${KSWAPD_DEMOTION_ENABLED:-1}"
+DEMOTION_SRC_NODE="${DEMOTION_SRC_NODE:-0}"
+DEMOTION_DST_NODE="${DEMOTION_DST_NODE:-1}"
+CPU_NODE="${CPU_NODE:-0}"
+OUTDIR="${OUTDIR:-/tmp/memcg_numa_scope_validation}"
+
+if [[ "${EUID}" -ne 0 ]]; then
+  echo "run as root (sudo)" >&2
+  exit 1
+fi
+
+mkdir -p "${OUTDIR}"
+
+expand_cpulist() {
+  local list="$1"
+  local part start end cpu
+  local -a parts
+
+  IFS=',' read -r -a parts <<< "${list}"
+  for part in "${parts[@]}"; do
+    if [[ "${part}" == *-* ]]; then
+      start="${part%-*}"
+      end="${part#*-}"
+      for ((cpu = start; cpu <= end; cpu++)); do
+        echo "${cpu}"
+      done
+    else
+      echo "${part}"
+    fi
+  done
+}
+
+build_split_cpu_sets() {
+  local node="$1"
+  local cpulist_path="/sys/devices/system/node/node${node}/cpulist"
+  local cpulist cpu package core key total half
+  local -a physical_cpus=()
+  local -A seen_cores=()
+  declare -g CPUSET_A CPUSET_B
+
+  cpulist="$(<"${cpulist_path}")"
+  while IFS= read -r cpu; do
+    [[ -z "${cpu}" ]] && continue
+    package="$(<"/sys/devices/system/cpu/cpu${cpu}/topology/physical_package_id")"
+    core="$(<"/sys/devices/system/cpu/cpu${cpu}/topology/core_id")"
+    key="${package}:${core}"
+    if [[ -n "${seen_cores[$key]:-}" ]]; then
+      continue
+    fi
+    seen_cores["$key"]="${cpu}"
+    physical_cpus+=("${cpu}")
+  done < <(expand_cpulist "${cpulist}")
+
+  total="${#physical_cpus[@]}"
+  if (( total < 2 )); then
+    echo "need at least two physical CPUs on node${node}" >&2
+    exit 1
+  fi
+
+  if (( total % 2 == 1 )); then
+    physical_cpus=("${physical_cpus[@]:0:$((total - 1))}")
+    total="${#physical_cpus[@]}"
+  fi
+
+  half=$(( total / 2 ))
+  CPUSET_A="$(IFS=,; echo "${physical_cpus[*]:0:half}")"
+  CPUSET_B="$(IFS=,; echo "${physical_cpus[*]:half:half}")"
+}
+
+read_cpuset_value() {
+  local path="$1"
+  if [[ -f "${path}.effective" ]]; then
+    cat "${path}.effective"
+  elif [[ -f "${path}" ]]; then
+    cat "${path}"
+  else
+    return 1
+  fi
+}
+
+pick_knob_file() {
+  local cg="$1"
+  local name="$2"
+  local f
+  for f in "${cg}/${name}" "${cg}/memory.${name}"; do
+    if [[ -f "${f}" ]]; then
+      echo "${f}"
+      return 0
+    fi
+  done
+  return 1
+}
+
+write_knob() {
+  local cg="$1"
+  local name="$2"
+  local value="$3"
+  local f
+  f="$(pick_knob_file "${cg}" "${name}")" || return 1
+  echo "${value}" > "${f}"
+}
+
+enable_controllers() {
+  local ctrls
+  ctrls="$(<"${CGROOT}/cgroup.controllers")"
+  if [[ "${ctrls}" == *memory* ]]; then
+    echo +memory > "${CGROOT}/cgroup.subtree_control" 2>/dev/null || true
+  fi
+  if [[ "${ctrls}" == *cpuset* ]]; then
+    echo +cpuset > "${CGROOT}/cgroup.subtree_control" 2>/dev/null || true
+  fi
+}
+
+reset_cgroup() {
+  local cg="$1"
+  if [[ ! -d "${cg}" ]]; then
+    return
+  fi
+
+  if [[ -f "${cg}/cgroup.procs" ]]; then
+    while IFS= read -r pid; do
+      [[ -n "${pid}" ]] && echo "${pid}" > "${CGROOT}/cgroup.procs" 2>/dev/null || true
+    done < "${cg}/cgroup.procs"
+  fi
+  rmdir "${cg}" 2>/dev/null || true
+}
+
+setup_cgroup() {
+  local cg="$1"
+  local cpus="$2"
+  local mode="$3"
+  local mems="$4"
+
+  reset_cgroup "${cg}"
+  mkdir -p "${cg}"
+  echo "${mems}" > "${cg}/cpuset.mems"
+  echo "${cpus}" > "${cg}/cpuset.cpus"
+  write_knob "${cg}" node_capacity "0 ${CAPACITY_PAGES}"
+  write_knob "${cg}" node_balancing "${mode}"
+  write_knob "${cg}" kswapd_demotion_enabled "${KSWAPD_DEMOTION_ENABLED}"
+  write_knob "${cg}" node_force_lru_evict "0 1"
+}
+
+snapshot_cgroup_stats() {
+  local cg="$1"
+  local out="$2"
+
+  python3 - "$cg" > "${out}" <<'PY'
+import os
+import sys
+
+cg = sys.argv[1]
+
+def pick(name):
+    for path in (os.path.join(cg, name), os.path.join(cg, f"memory.{name}")):
+        if os.path.isfile(path):
+            return path
+    return None
+
+def parse_stat(path):
+    data = {}
+    if not path:
+        return data
+    with open(path, "r", encoding="utf-8") as f:
+        for raw in f:
+            parts = raw.strip().split()
+            if len(parts) != 2:
+                continue
+            key, value = parts
+            try:
+                data[key] = int(value)
+            except ValueError:
+                pass
+    return data
+
+def parse_kv(path):
+    data = {}
+    if not path:
+        return data
+    with open(path, "r", encoding="utf-8") as f:
+        for raw in f:
+            parts = raw.strip().split(None, 1)
+            if len(parts) == 2:
+                data[parts[0]] = parts[1]
+    return data
+
+stat = parse_stat(pick("stat"))
+reclaimd = parse_kv(pick("reclaimd_state"))
+migrate = parse_kv(pick("numa_migrate_state"))
+
+for key in (
+    "numa_hint_faults",
+    "numa_page_migrate",
+    "pgdemote_kswapd",
+    "pgpromote_success",
+):
+    print(f"MEMSTAT.{key} {stat.get(key, 0)}")
+
+for key in ("wake_count", "run_count"):
+    print(f"RECLAIMD.{key} {int(reclaimd.get(key, '0'))}")
+
+for key in (
+    "numa_migrate_success_total",
+    "numa_migrate_success_promotion",
+    "numa_migrate_success_other",
+):
+    print(f"MIGRATE.{key} {int(migrate.get(key, '0'))}")
+PY
+}
+
+snapshot_vmstat() {
+  local out="$1"
+  python3 > "${out}" <<'PY'
+with open("/proc/vmstat", "r", encoding="utf-8") as f:
+    for raw in f:
+        parts = raw.split()
+        if len(parts) == 2:
+            print(f"{parts[0]} {parts[1]}")
+PY
+}
+
+write_diff() {
+  local before="$1"
+  local after="$2"
+  local out="$3"
+
+  python3 - "$before" "$after" > "${out}" <<'PY'
+import sys
+
+def load(path):
+    data = {}
+    with open(path, "r", encoding="utf-8") as f:
+        for raw in f:
+            parts = raw.strip().split(None, 1)
+            if len(parts) != 2:
+                continue
+            try:
+                data[parts[0]] = int(parts[1])
+            except ValueError:
+                data[parts[0]] = parts[1]
+    return data
+
+before = load(sys.argv[1])
+after = load(sys.argv[2])
+for key in sorted(set(before) | set(after)):
+    b = before.get(key, 0)
+    a = after.get(key, 0)
+    if isinstance(a, int) and isinstance(b, int):
+        print(f"{key} {a - b}")
+PY
+}
+
+summary_report() {
+  local diff_a="$1"
+  local diff_b="$2"
+  local out="$3"
+
+  python3 - "$diff_a" "$diff_b" > "${out}" <<'PY'
+import sys
+
+def load(path):
+    data = {}
+    with open(path, "r", encoding="utf-8") as f:
+        for raw in f:
+            parts = raw.strip().split(None, 1)
+            if len(parts) != 2:
+                continue
+            try:
+                data[parts[0]] = int(parts[1])
+            except ValueError:
+                pass
+    return data
+
+a = load(sys.argv[1])
+b = load(sys.argv[2])
+
+keys = [
+    "MEMSTAT.numa_hint_faults",
+    "MEMSTAT.numa_page_migrate",
+    "MEMSTAT.pgpromote_success",
+    "RECLAIMD.wake_count",
+    "RECLAIMD.run_count",
+    "MIGRATE.numa_migrate_success_total",
+    "MIGRATE.numa_migrate_success_promotion",
+]
+
+print("Metric,A(mode=2),B(mode=0)")
+for key in keys:
+    print(f"{key},{a.get(key, 0)},{b.get(key, 0)}")
+PY
+}
+
+enable_controllers
+build_split_cpu_sets "${CPU_NODE}"
+
+if [[ -f /sys/kernel/mm/numa/demotion_enabled ]]; then
+  echo true > /sys/kernel/mm/numa/demotion_enabled
+  echo "[info] numa demotion enabled"
+else
+  echo "[warn] /sys/kernel/mm/numa/demotion_enabled not found; skip demotion enable"
+fi
+
+if [[ -f /sys/kernel/mm/numa/demotion_target ]]; then
+  echo "${DEMOTION_SRC_NODE} ${DEMOTION_DST_NODE}" > /sys/kernel/mm/numa/demotion_target
+  echo "[info] manual demotion target: node${DEMOTION_SRC_NODE} -> node${DEMOTION_DST_NODE}"
+else
+  echo "[warn] /sys/kernel/mm/numa/demotion_target not found; skip manual target setup"
+fi
+
+echo 0 > /proc/sys/kernel/numa_balancing
+echo 2 > /proc/sys/kernel/numa_balancing
+
+CGPATH_A="${CGROOT}/${CG_A}"
+CGPATH_B="${CGROOT}/${CG_B}"
+CPUSET_MEMS="$(read_cpuset_value "${CGROOT}/cpuset.mems")"
+
+setup_cgroup "${CGPATH_A}" "${CPUSET_A}" "${NODE_BALANCING_MODE_A}" "${CPUSET_MEMS}"
+setup_cgroup "${CGPATH_B}" "${CPUSET_B}" "${NODE_BALANCING_MODE_B}" "${CPUSET_MEMS}"
+
+echo "[info] ${CG_A}: node0 capacity=${CAPACITY_PAGES} pages, node_balancing=${NODE_BALANCING_MODE_A}, kswapd_demotion_enabled=${KSWAPD_DEMOTION_ENABLED}"
+echo "[info] ${CG_B}: node0 capacity=${CAPACITY_PAGES} pages, node_balancing=${NODE_BALANCING_MODE_B}, kswapd_demotion_enabled=${KSWAPD_DEMOTION_ENABLED}"
+echo "[info] ${CG_A}: cpuset.cpus=${CPUSET_A}, cpuset.mems=${CPUSET_MEMS}"
+echo "[info] ${CG_B}: cpuset.cpus=${CPUSET_B}, cpuset.mems=${CPUSET_MEMS}"
+
+snapshot_cgroup_stats "${CGPATH_A}" "${OUTDIR}/A.before"
+snapshot_cgroup_stats "${CGPATH_B}" "${OUTDIR}/B.before"
+snapshot_vmstat "${OUTDIR}/vmstat.before"
+
+cleanup() {
+  local pid
+  for pid in "${PID_A:-}" "${PID_B:-}"; do
+    [[ -n "${pid}" ]] || continue
+    kill -INT "${pid}" 2>/dev/null || true
+    wait "${pid}" 2>/dev/null || true
+  done
+}
+trap cleanup EXIT
+
+bash -lc "echo \$\$ > '${CGPATH_A}/cgroup.procs'; exec /usr/bin/time -f 'execution time %e (s)' ${CMD_A}" \
+  > "${OUTDIR}/A.runner.txt" 2>&1 &
+PID_A=$!
+
+bash -lc "echo \$\$ > '${CGPATH_B}/cgroup.procs'; exec /usr/bin/time -f 'execution time %e (s)' ${CMD_B}" \
+  > "${OUTDIR}/B.runner.txt" 2>&1 &
+PID_B=$!
+
+wait "${PID_A}"
+wait "${PID_B}"
+trap - EXIT
+
+snapshot_cgroup_stats "${CGPATH_A}" "${OUTDIR}/A.after"
+snapshot_cgroup_stats "${CGPATH_B}" "${OUTDIR}/B.after"
+snapshot_vmstat "${OUTDIR}/vmstat.after"
+
+write_diff "${OUTDIR}/A.before" "${OUTDIR}/A.after" "${OUTDIR}/A.diff"
+write_diff "${OUTDIR}/B.before" "${OUTDIR}/B.after" "${OUTDIR}/B.diff"
+write_diff "${OUTDIR}/vmstat.before" "${OUTDIR}/vmstat.after" "${OUTDIR}/vmstat.diff"
+summary_report "${OUTDIR}/A.diff" "${OUTDIR}/B.diff" "${OUTDIR}/summary.csv"
+
+echo "[done] validation output: ${OUTDIR}"
+echo "[done] summary:"
+cat "${OUTDIR}/summary.csv"
