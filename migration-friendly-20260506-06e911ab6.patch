+    shift
+    exec "${ROOT_MB}/mbench" --mode bw --threads "${THREADS:-4}" \
+      --bw-kernel copy --bw-stride 4 --bw-block 2M \
+      --arena-size "${ARENA:-16G}" --window-size "${WINDOW:-16G}" \
+      --move-policy fixed \
