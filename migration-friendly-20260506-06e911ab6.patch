+  -name "${VM_NAME}"
+  -machine "${MACHINE_TYPE}"
+  -cpu "${CPU_MODEL}"
+  -smp "${CPUS}"
+  -m "${MEMORY}"
+  -kernel "${KERNEL_IMAGE}"
+  -append "${CMDLINE}"
+  -drive "file=${ROOTFS_IMAGE},if=${DRIVE_IF},format=${ROOTFS_FORMAT}"
+  -netdev user,id=net0,hostfwd=tcp::${SSH_FORWARD_PORT}-:22
+  -device "${NET_DEVICE}",netdev=net0
+  -serial "file:${SERIAL_LOG}"
+  -qmp "unix:${QMP_SOCK},server,wait=off"
+)
+
+if [[ "${DAEMONIZE}" == "1" ]]; then
+  QEMU_CMD+=( -display none -monitor none -daemonize )
+else
+  QEMU_CMD+=( -nographic -monitor stdio )
+fi
+
+if [[ "${ENABLE_NUMA_LAYOUT}" == "1" ]]; then
