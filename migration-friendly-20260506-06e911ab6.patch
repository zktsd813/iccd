+
+reset_cgroup_dir() {
+  local cg="$1"
+  local pid
+
+  if [[ ! -d "${cg}" ]]; then
+    return 0
+  fi
+
+  if [[ -f "${cg}/cgroup.procs" && -f "${CGROOT}/cgroup.procs" ]]; then
+    while IFS= read -r pid; do
+      [[ -n "${pid}" ]] || continue
+      echo "${pid}" > "${CGROOT}/cgroup.procs" 2>/dev/null || true
+    done < "${cg}/cgroup.procs"
+  fi
+
+  rmdir "${cg}" 2>/dev/null || true
+}
