+}
+
+#endif
diff --git a/Microbenchmark/src/kernels/mbench_mix.c b/Microbenchmark/src/kernels/mbench_mix.c
new file mode 100644
index 000000000..07a294c39
--- /dev/null
+++ b/Microbenchmark/src/kernels/mbench_mix.c
@@ -0,0 +1,147 @@
+#define _GNU_SOURCE
+
+#include "mbench_kernels.h"
+
+#include <errno.h>
+#include <stdlib.h>
+
+struct mbench_mix_sync {
+    pthread_mutex_t mutex;
+    pthread_cond_t ready_cond;
+    pthread_cond_t start_cond;
+    size_t ready;
+    size_t total;
+    int start;
+    int cancel;
+};
+
+struct mbench_mix_thread_ctx {
+    const struct mbench_mix_worker *worker;
+    struct mbench_mix_sync *sync;
+    int rc;
+};
+
+static void mbench_mix_sync_init(struct mbench_mix_sync *sync, size_t total)
+{
+    (void)pthread_mutex_init(&sync->mutex, NULL);
+    (void)pthread_cond_init(&sync->ready_cond, NULL);
+    (void)pthread_cond_init(&sync->start_cond, NULL);
+    sync->ready = 0;
+    sync->total = total;
+    sync->start = 0;
+    sync->cancel = 0;
+}
+
+static void mbench_mix_sync_destroy(struct mbench_mix_sync *sync)
+{
+    (void)pthread_cond_destroy(&sync->start_cond);
+    (void)pthread_cond_destroy(&sync->ready_cond);
+    (void)pthread_mutex_destroy(&sync->mutex);
+}
+
+static void mbench_mix_wait_for_start(struct mbench_mix_sync *sync)
+{
+    (void)pthread_mutex_lock(&sync->mutex);
+    sync->ready++;
+    if (sync->ready == sync->total) {
+        (void)pthread_cond_broadcast(&sync->ready_cond);
+    }
+    while (!sync->start && !sync->cancel) {
+        (void)pthread_cond_wait(&sync->start_cond, &sync->mutex);
+    }
+    (void)pthread_mutex_unlock(&sync->mutex);
+}
+
+static void *mbench_mix_thread_main(void *arg)
+{
+    struct mbench_mix_thread_ctx *ctx = arg;
+
+    mbench_mix_wait_for_start(ctx->sync);
+    if (ctx->sync->cancel) {
+        ctx->rc = -ECANCELED;
+        return NULL;
+    }
+
+    switch (ctx->worker->role) {
+    case MBENCH_MIX_ROLE_PC:
+        ctx->rc = mbench_run_pc(&ctx->worker->job.pc);
+        break;
+    case MBENCH_MIX_ROLE_BW:
+        ctx->rc = mbench_run_bw(&ctx->worker->job.bw);
+        break;
+    case MBENCH_MIX_ROLE_SKEWED:
+        ctx->rc = mbench_run_skewed_hotset(&ctx->worker->job.skew);
+        break;
+    case MBENCH_MIX_ROLE_IRREGULAR:
+        ctx->rc = mbench_run_irregular(&ctx->worker->job.irregular);
+        break;
+    default:
+        ctx->rc = -EINVAL;
+        break;
+    }
+
+    return NULL;
+}
+
+int mbench_run_mix(const struct mbench_mix_group *group)
+{
+    if (group == NULL || group->workers == NULL || group->worker_count == 0) {
+        return -EINVAL;
+    }
+
+    pthread_t *threads = calloc(group->worker_count, sizeof(*threads));
+    struct mbench_mix_thread_ctx *ctxs = calloc(group->worker_count, sizeof(*ctxs));
+    int rc = 0;
+    size_t started = 0;
+    struct mbench_mix_sync sync;
+
+    if (threads == NULL || ctxs == NULL) {
+        free(threads);
+        free(ctxs);
+        return -ENOMEM;
+    }
+
+    mbench_mix_sync_init(&sync, group->worker_count);
+
+    for (size_t i = 0; i < group->worker_count; ++i) {
+        ctxs[i].worker = &group->workers[i];
+        ctxs[i].sync = &sync;
+        ctxs[i].rc = 0;
+
+        int err = pthread_create(&threads[i], NULL, mbench_mix_thread_main, &ctxs[i]);
+        if (err != 0) {
+            rc = -err;
+            break;
+        }
+        started++;
+    }
+
+    if (rc != 0) {
+        (void)pthread_mutex_lock(&sync.mutex);
+        sync.cancel = 1;
+        sync.start = 1;
+        (void)pthread_cond_broadcast(&sync.ready_cond);
+        (void)pthread_cond_broadcast(&sync.start_cond);
+        (void)pthread_mutex_unlock(&sync.mutex);
+    } else {
+        (void)pthread_mutex_lock(&sync.mutex);
+        while (sync.ready < group->worker_count) {
+            (void)pthread_cond_wait(&sync.ready_cond, &sync.mutex);
+        }
+        sync.start = 1;
+        (void)pthread_cond_broadcast(&sync.start_cond);
+        (void)pthread_mutex_unlock(&sync.mutex);
+    }
+
+    for (size_t i = 0; i < started; ++i) {
+        (void)pthread_join(threads[i], NULL);
+        if (rc == 0 && ctxs[i].rc != 0) {
+            rc = ctxs[i].rc;
+        }
+    }
+
+    mbench_mix_sync_destroy(&sync);
+    free(ctxs);
+    free(threads);
+    return rc;
+}
diff --git a/Microbenchmark/src/kernels/mbench_pc.c b/Microbenchmark/src/kernels/mbench_pc.c
new file mode 100644
index 000000000..35e72c96a
--- /dev/null
+++ b/Microbenchmark/src/kernels/mbench_pc.c
@@ -0,0 +1,91 @@
+#define _GNU_SOURCE
+
+#include "mbench_kernels.h"
+
+#include <errno.h>
+#include <stdlib.h>
+#include <string.h>
+
+static inline uint64_t mbench_xorshift64(uint64_t *state)
+{
+    uint64_t x = *state;
+
+    x ^= x << 13;
+    x ^= x >> 7;
+    x ^= x << 17;
+    *state = x;
+    return x * 2685821657736338717ULL;
+}
+
+int mbench_init_pc_ring(uint32_t *ring, size_t nodes, uint64_t seed)
+{
+    if (ring == NULL || nodes < 2 || nodes > UINT32_MAX) {
+        return -EINVAL;
+    }
+
+    uint32_t *perm = malloc(nodes * sizeof(*perm));
+    if (perm == NULL) {
+        return -ENOMEM;
+    }
+
+    for (size_t i = 0; i < nodes; ++i) {
+        perm[i] = (uint32_t)i;
+    }
+
+    uint64_t state = seed != 0 ? seed : 0x9e3779b97f4a7c15ULL;
+    for (size_t i = nodes - 1; i > 0; --i) {
+        size_t j = (size_t)(mbench_xorshift64(&state) % (uint64_t)(i + 1));
+        uint32_t tmp = perm[i];
+        perm[i] = perm[j];
+        perm[j] = tmp;
+    }
+
+    for (size_t i = 0; i + 1 < nodes; ++i) {
+        ring[perm[i]] = perm[i + 1];
+    }
+    ring[perm[nodes - 1]] = perm[0];
+
+    free(perm);
+    return 0;
+}
+
+int mbench_init_pc_heads(uint32_t *heads, size_t chains, size_t nodes, uint64_t seed)
+{
+    if (heads == NULL || chains == 0 || nodes == 0 || nodes > UINT32_MAX) {
+        return -EINVAL;
+    }
+
+    uint64_t state = seed != 0 ? seed : 0x6a09e667f3bcc909ULL;
+    for (size_t chain = 0; chain < chains; ++chain) {
+        uint64_t base = ((uint64_t)chain * (uint64_t)nodes) / (uint64_t)chains;
+        uint64_t jitter = mbench_xorshift64(&state) % (uint64_t)nodes;
+        heads[chain] = (uint32_t)((base + jitter) % (uint64_t)nodes);
+    }
+
+    return 0;
+}
+
+int mbench_run_pc(const struct mbench_pc_job *job)
+{
+    if (job == NULL || job->ring == NULL || job->heads == NULL ||
+        job->nodes < 2 || job->chains == 0 || job->passes == 0) {
+        return -EINVAL;
+    }
+
+    uint64_t checksum = 0;
+
+    for (size_t pass = 0; pass < job->passes; ++pass) {
+        for (size_t chain = 0; chain < job->chains; ++chain) {
+            uint32_t idx = job->heads[chain];
+            idx = job->ring[idx];
+            job->heads[chain] = idx;
+            checksum += (uint64_t)idx + 1ULL;
+        }
+    }
+
+    if (job->sink != NULL) {
+        *job->sink = checksum;
+    }
+
+    return 0;
+}
diff --git a/Microbenchmark/src/kernels/mbench_skewed.c b/Microbenchmark/src/kernels/mbench_skewed.c
new file mode 100644
index 000000000..c1f9d042e
--- /dev/null
+++ b/Microbenchmark/src/kernels/mbench_skewed.c
@@ -0,0 +1,67 @@
+#define _GNU_SOURCE
+
+#include "mbench_kernels.h"
+
+#include <errno.h>
+
+static inline uint64_t mbench_xorshift64(uint64_t *state)
+{
+    uint64_t x = *state;
+
+    x ^= x << 13;
+    x ^= x >> 7;
+    x ^= x << 17;
+    if (x == 0) {
+        x = 0x9e3779b97f4a7c15ULL;
+    }
+    *state = x;
+    return x;
+}
+
+int mbench_run_skewed_hotset(const struct mbench_skew_job *job)
+{
+    if (!job || !job->data || job->data_words == 0 || job->page_words == 0 ||
+        job->hot_pages == 0 || job->ops == 0 || job->hot_prob_pct > 100U ||
+        job->read_pct + job->write_pct + job->rmw_pct != 100U) {
+        return -EINVAL;
+    }
+
+    size_t total_pages = job->data_words / job->page_words;
+    if (total_pages == 0 || job->hot_pages > total_pages) {
+        return -EINVAL;
+    }
+
+    size_t cold_pages = total_pages - job->hot_pages;
+    uint64_t state = job->seed ? job->seed : 0x6a09e667f3bcc909ULL;
+    uint64_t checksum = 0;
+
+    for (size_t op = 0; op < job->ops; ++op) {
+        uint64_t choose = mbench_xorshift64(&state);
+        uint64_t value = mbench_xorshift64(&state);
+        size_t page;
+        if (cold_pages == 0 || (choose % 100ULL) < (uint64_t)job->hot_prob_pct) {
+            page = (size_t)(mbench_xorshift64(&state) % (uint64_t)job->hot_pages);
+        } else {
+            page = job->hot_pages +
+                (size_t)(mbench_xorshift64(&state) % (uint64_t)cold_pages);
+        }
+
+        size_t word = (size_t)(mbench_xorshift64(&state) % (uint64_t)job->page_words);
+        size_t slot = page * job->page_words + word;
+        uint64_t op_kind = choose % 100ULL;
+        if (op_kind < (uint64_t)job->read_pct) {
+            checksum += job->data[slot] + (uint64_t)slot;
+        } else if (op_kind < (uint64_t)job->read_pct + (uint64_t)job->write_pct) {
+            job->data[slot] = value;
+            checksum += value ^ (uint64_t)slot;
+        } else {
+            job->data[slot] ^= value;
+            checksum += job->data[slot];
+        }
+    }
+
+    if (job->sink) {
+        *job->sink = checksum;
+    }
+    return 0;
+}
diff --git a/docs/migration-friendly-experiment-2026-05-06.md b/docs/migration-friendly-experiment-2026-05-06.md
new file mode 100644
index 000000000..106774dd9
--- /dev/null
+++ b/docs/migration-friendly-experiment-2026-05-06.md
@@ -0,0 +1,433 @@
+# Migration-friendly NUMA balancing experiment notes
+
+Date: 2026-05-06 UTC
+
+This note summarizes the migration-friendly kernel and microbenchmark debugging
+session.  The main thread of the work was to make cgroup-scoped NUMA balancing
+and local-node capacity control behave predictably, then to find and validate a
+microbenchmark where migration should help.
+
+## Repository and trees
+
+The workspace used two kernel/source trees:
+
+- `/Serverless/iccd/linux`: the kernel actually booted for the final QEMU
+  experiments.  The booted kernel reported `Linux 6.18.0modified #125`.
+- `/Serverless/iccd/Adaptive-Migration`: the git working tree containing the
+  QEMU wrappers, guest scripts, and `Microbenchmark` source used in the final
+  experiments.
+
+The final QEMU runs explicitly used:
+
+```bash
+KERNEL_IMAGE=/Serverless/iccd/linux/arch/x86/boot/bzImage
+INITRD_IMAGE=/Serverless/iccd/Adaptive-Migration/scripts/kernel/kernel-artifacts/initramfs-6.18.0modified-mglru120.img
+```
+
+The `Adaptive-Migration` kernel image was not suitable for the final validation:
+it booted an older `5.15.0-ODM+` kernel and did not expose the new cgroup NUMA
+control files.  Booting `/Serverless/iccd/linux/arch/x86/boot/bzImage` without
+an initramfs also failed because `CONFIG_VIRTIO_BLK=m`, so the root device
+`/dev/vda2` was unavailable.  Passing the matching `6.18.0modified` initramfs
+resolved that.
+
+## Kernel semantics investigated
+
+### Demotion mode normalization
+
+The user request was not to expose a new `0x3` setting to userspace.  The desired
+semantic was:
+
+- `demotion_enabled=0`: demotion off.
+- `demotion_enabled=0x1`, or any non-zero value accepted by the interface:
+  behave like the previous mode 3 implementation.
+
+The practical target was one stable behavior rather than multiple historical
+mode variants.  The cgroup-local demotion policy was then driven by local node
+capacity watermarks.
+
+### Local-node capacity watermarks
+
+The local node capacity target used during the experiments was:
+
+- `memory.node_capacity`: `node0 4194304` pages, i.e. 16 GiB.
+- low watermark: 95 percent of the capacity.
+- high watermark: 98 percent of the capacity.
+
+In the guest runner this appeared as:
+
+```text
+capacity_pages=4194304
+reclaimd_node0_low_wmark=3984588
+reclaimd_node0_high_wmark=4110417
+```
+
+The intended demotion semantics were:
+
+- kswapd/reclaim demotion should begin once usage crosses the high watermark.
+- demotion should stop when usage returns near the low watermark.
+- promotion should be permitted while the projected local-node usage has enough
+  headroom under the high watermark.
+
+Earlier promotion checks used an overly conservative global-node watermark plus
+`max(1GB, node/16)` style reserve.  That was too strict for the cgroup-local
+capacity semantics and blocked promotion even when the cgroup-local local-node
+usage was in the intended low-to-high watermark band.  The later policy uses
+cgroup-local projected usage and headroom relative to the high watermark.  The
+live experiments below confirm that promotion was no longer blocked:
+
+```text
+numa_migrate_fail_promotion_blocked = 0
+numa_migrate_fail_promotion_over_high = 0
+numa_migrate_fail_promotion_alloc = 0
+```
+
+### cgroup NUMA balancing versus global NUMA balancing
+
+The desired hierarchy is that cgroup-level NUMA balancing is an explicit
+per-cgroup policy, not merely a subordinate switch masked by the global sysctl.
+The final experiments used:
+
+```text
+global_numa_on=0
+node_balancing_on=2
+```
+
+That means the global sysctl was disabled while the test cgroup enabled
+memory-tiering style NUMA balancing.  The successful promotion counters in the
+`on` policy runs show that the cgroup knob was effective even with global
+balancing disabled.
+
+Important implementation/observation points from the code-level investigation:
+
+- `task_numa_balancing_mode(p)` is the effective predicate used by the NUMA
+  scanner and hint-fault paths.
+- The kernel maintains a cgroup NUMA-balancing reference count
+  (`numa_balancing_count`) so cgroup enablement can update scheduler state.
+- The scanner is not an independent kernel thread.  `task_tick_numa()` schedules
+  `task_work` on userspace tasks.
+- Scan progress is driven by per-task runtime (`se.sum_exec_runtime`), not by a
+  single `mm_struct` runtime counter.
+- Shared mm state such as `numa_next_scan`, `numa_scan_offset`, and
+  `numa_scan_seq` still coordinates the address-space scan.
+
+This per-task runtime detail became critical for the microbenchmark debugging
+below.
+
+### Dynamic off semantics
+
+The session also checked the intended dynamic-off behavior:
+
+- If cgroup NUMA balancing/migration is turned off in the middle of execution,
+  later faults should not perform migration.
+- In particular, a `pte_none` or hinting-related fault after the policy is off
+  should see migration rejected by the effective cgroup policy.
+
+The semantic goal was that disabling migration is immediate for future faults.
+This avoids stale migration after a policy transition.
+
+### MGLRU interaction
+
+The multi-generation LRU path was reviewed because MGLRU has its own
+generation-based reclaim selection.  The relevant conclusion was:
+
+- MGLRU still uses reclaim/kswapd infrastructure, but its generation-based
+  reclaim does not natively understand the custom per-cgroup node capacity
+  target.
+- If cgroup node capacity is enforced only in the classic LRU reclaim path,
+  enabling MGLRU can bypass or weaken the intended local-node capacity control.
+- The MGLRU-aware fix therefore has to hook the cgroup capacity/demotion policy
+  into the MGLRU generation reclaim path as well.
+
+The final experiments in this note are not primarily MGLRU experiments; the
+important point is that cgroup capacity control must be considered at the
+generation reclaim boundary, not only in classic LRU helpers.
+
+## Microbenchmark challenge: non-persistent workers
+
+The initial 4G hot-window workload looked like it should be migration-friendly,
+but hint faults and promotion appeared late or inconsistently.  The main cause
+was the microbenchmark execution model.
+
+Before the fix:
+
+- `mbench_execute_loop()` repeatedly called a one-pass helper.
+- Each pass called `mbench_run_mix()`.
+- `mbench_run_mix()` created `--threads` pthreads, ran one fixed pass, joined
+  the threads, and freed the worker state.
+- With `--ops-per-pass=65536` and 32 threads, each pass was short.
+
+That model is a bad fit for Linux automatic NUMA balancing because scan progress
+is tied to per-task runtime.  The benchmark process was long-lived, but the
+worker threads that actually touched memory were short-lived.  Each worker
+accumulated little runtime before exiting, so the NUMA scanner had less stable
+per-thread state to drive early scanning.
+
+The fix added:
+
+```text
+--persistent-workers
+```
+
+For `skewed-hotset`, this creates the worker pthreads once and keeps them alive
+until the runtime stop flag is set.  Each persistent worker loops over jobs for
+its slice of the current window.  This makes per-thread runtime accumulate and
+lets `task_tick_numa()` drive hinting promptly.
+
+Files changed:
+
+- `Microbenchmark/include/mbench.h`: add `persistent_workers`.
+- `Microbenchmark/src/core/config.c`: parse and print `--persistent-workers`.
+- `Microbenchmark/src/core/execute.c`: add persistent skewed-hotset worker loop.
+- `scripts/kernel/run_phase_candidate_microbench_guest.sh`: add persistent
+  candidate presets.
+
+Smoke test:
+
+```bash
+make -C /Serverless/iccd/Adaptive-Migration/Microbenchmark -j$(nproc)
+/Serverless/iccd/Adaptive-Migration/Microbenchmark/mbench --help | grep persistent
+```
+
+The local short run also completed with `MBENCH_FORCE_DURATION_MS=500`.
+
+## Prefault and measurement hygiene
+
+The measurement script used a prefault gate to avoid charging prefault effects
+to the measured phase.
+
+For the final runs:
+
+- The arena was faulted while the cgroup `cpuset.mems` was restricted to the
+  remote node.
+- After prefault completion, `cpuset.mems` was restored to `0,1`.
+- The guest script waited for reclaim/demotion to settle.
+- cgroup and vmstat counters were reset by taking fresh `before` snapshots only
+  after prefault.
+- Then the benchmark start file was touched and the live sampler began.
+
+This was necessary because otherwise prefault placement and first-touch effects
+polluted the migration counters and phase throughput.
+
+## Key experiment setup
+
+Common settings:
+
+```text
