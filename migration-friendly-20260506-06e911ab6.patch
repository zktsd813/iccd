+#!/usr/bin/env bash
+set -euo pipefail
+
+usage() {
+  cat <<'EOF'
+Usage:
+  run_qemu_paper_cli_elapsed.sh [options]
+
+Boot a paper-topology VM, apply the ourwork NUMA-tiering runtime knobs inside
+the guest, run one workload command derived from
+/Serverless/Migration-friendly/scripts/bench_V2/run_benchmark.py, and collect
+elapsed time.
+
+Options:
+  --workload <name>         pr|bc|silo|liblinear|FT|LU|SP|gups (default: bc)
+  --kernel-image <path>     bzImage path
+  --kernel-dir <path>       Kernel tree (default: this repo root)
+  --kernel-label <name>     Label used in result paths (default: current tree name)
+  --rootfs-base <path>      Base paper-workload overlay
+  --local-dram <size>       Guest node0 size: 16G|32G|48G (default: 32G)
+  --remote-mem <size>       Guest node1 size (default: 128G)
+  --timeout-sec <n>         In-guest workload timeout in seconds (default: 0)
+  --run-id <id>             Result directory tag
+  --global-numa-balancing <n>
+                            /proc/sys/kernel/numa_balancing value (default: 2)
+  --demotion-enabled <bool> true|false for /sys/kernel/mm/numa/demotion_enabled
+                            (default: true)
+  --demote-scale-factor <n> /proc/sys/vm/demote_scale_factor value (default: 400)
+  --demotion-src-node <id>  Source node for optional demotion_target (default: 0)
+  --demotion-dst-node <id>  Destination node for optional demotion_target (default: 1)
+  -h, --help                Show this help
+EOF
+}
+
+SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
+REPO_ROOT="$(cd "${SCRIPT_DIR}/../.." && pwd)"
+LAUNCHER="${SCRIPT_DIR}/launch_paper_topology_qemu.sh"
+ROOTFS_BASE="${SCRIPT_DIR}/vm-images/adaptive-migration-paper-workloads.qcow2"
+KERNEL_DIR="${REPO_ROOT}"
+KERNEL_IMAGE=""
+KERNEL_LABEL="$(basename "${REPO_ROOT}")"
+WORKLOAD="bc"
+LOCAL_DRAM="32G"
+REMOTE_MEM="128G"
+TIMEOUT_SEC="0"
+RUN_ID="$(date -u +%Y%m%dT%H%M%SZ)"
+RESULTS_DIR="${SCRIPT_DIR}/qemu-results/paper-cli-elapsed"
+OVERLAY_DIR="${SCRIPT_DIR}/vm-images"
+NBD_DEVICE="${NBD_DEVICE:-/dev/nbd0}"
+MOUNT_DIR="${MOUNT_DIR:-/tmp/paper-cli-elapsed-root}"
+GLOBAL_NUMA_BALANCING="2"
+DEMOTION_ENABLED="true"
+DEMOTE_SCALE_FACTOR="400"
+DEMOTION_SRC_NODE="0"
+DEMOTION_DST_NODE="1"
+RUN_DIR=""
+OVERLAY_IMAGE=""
+SUMMARY_PATH=""
+HOST_LOG=""
+GUEST_LOG_COPY=""
+GUEST_OUT_COPY=""
+GUEST_TIMELOG_COPY=""
+SERIAL_LOG=""
+ROOT_MAPPER=""
+NBD_ACTIVE=0
+MOUNT_ACTIVE=0
+GUEST_EXTRA_LIB_DIR="/usr/local/lib/paper-workloads"
+HOST_LIB_CANDIDATES=(
+  /lib/x86_64-linux-gnu/libgfortran.so.5
+  /lib/x86_64-linux-gnu/libgfortran.so.5.*
+  /lib/x86_64-linux-gnu/libquadmath.so.0
+  /lib/x86_64-linux-gnu/libquadmath.so.0.*
+  /lib/x86_64-linux-gnu/libgomp.so.1
+  /lib/x86_64-linux-gnu/libgomp.so.1.*
+  /lib/x86_64-linux-gnu/libstdc++.so.6
+  /lib/x86_64-linux-gnu/libstdc++.so.6.*
+  /lib/x86_64-linux-gnu/libgcc_s.so.1
+  /lib/x86_64-linux-gnu/libnuma.so.1
+  /lib/x86_64-linux-gnu/libjemalloc.so.2
+  /lib/x86_64-linux-gnu/libdb_cxx-5.3.so
+)
+
+while [[ $# -gt 0 ]]; do
+  case "$1" in
+    --workload)
+      WORKLOAD="${2:-}"; shift 2 ;;
+    --kernel-image)
+      KERNEL_IMAGE="${2:-}"; shift 2 ;;
+    --kernel-dir)
+      KERNEL_DIR="${2:-}"; shift 2 ;;
+    --kernel-label)
+      KERNEL_LABEL="${2:-}"; shift 2 ;;
+    --rootfs-base)
+      ROOTFS_BASE="${2:-}"; shift 2 ;;
+    --local-dram)
+      LOCAL_DRAM="${2:-}"; shift 2 ;;
+    --remote-mem)
+      REMOTE_MEM="${2:-}"; shift 2 ;;
+    --timeout-sec)
+      TIMEOUT_SEC="${2:-}"; shift 2 ;;
+    --run-id)
+      RUN_ID="${2:-}"; shift 2 ;;
+    --global-numa-balancing)
+      GLOBAL_NUMA_BALANCING="${2:-}"; shift 2 ;;
+    --demotion-enabled)
+      DEMOTION_ENABLED="${2:-}"; shift 2 ;;
+    --demote-scale-factor)
+      DEMOTE_SCALE_FACTOR="${2:-}"; shift 2 ;;
+    --demotion-src-node)
+      DEMOTION_SRC_NODE="${2:-}"; shift 2 ;;
+    --demotion-dst-node)
+      DEMOTION_DST_NODE="${2:-}"; shift 2 ;;
+    -h|--help)
+      usage; exit 0 ;;
+    *)
+      echo "Unknown option: $1" >&2
+      usage >&2
+      exit 1 ;;
+  esac
+done
+
+if [[ -z "${KERNEL_IMAGE}" ]]; then
+  KERNEL_IMAGE="${KERNEL_DIR}/arch/x86/boot/bzImage"
+fi
+
+if [[ ! -f "${ROOTFS_BASE}" ]]; then
+  echo "base rootfs not found: ${ROOTFS_BASE}" >&2
+  exit 1
+fi
+
+if [[ ! -f "${KERNEL_IMAGE}" ]]; then
+  echo "kernel image not found: ${KERNEL_IMAGE}" >&2
+  exit 1
+fi
+
+case "${WORKLOAD}" in
+  pr)
+    GUEST_CMD='/Serverless/benchmark/gapbs/pr -g28 -i1000 -t1e-4 -n20'
+    ;;
+  bc)
+    GUEST_CMD='/Serverless/benchmark/gapbs/bc -g28'
+    ;;
+  silo)
+    GUEST_CMD='LD_LIBRARY_PATH=/Serverless/benchmark/paper-workloads/lib${LD_LIBRARY_PATH:+:$LD_LIBRARY_PATH} /Serverless/benchmark/silo/out-perf.masstree/benchmarks/dbtest --verbose --num-threads 32 --bench ycsb --scale-factor 550000 --ops-per-worker=200000000'
+    ;;
+  liblinear)
+    GUEST_CMD='/Serverless/benchmark/liblinear-multicore-2.47/train -s 6 -m 32 /Serverless/benchmark/liblinear-multicore-2.47/datasets/kdd12'
+    ;;
+  FT)
+    GUEST_CMD='/Serverless/benchmark/NPB3.4.3/NPB3.4-OMP/bin/ft.H.x'
+    ;;
+  LU)
+    GUEST_CMD='/Serverless/benchmark/NPB3.4.3/NPB3.4-OMP/bin/lu.H.x'
+    ;;
+  SP)
+    GUEST_CMD='/Serverless/benchmark/NPB3.4.3/NPB3.4-OMP/bin/sp.H.x'
+    ;;
+  gups)
+    GUEST_CMD='/Serverless/benchmark/vmitosis-workloads/bin/bench_gups_mt'
+    ;;
+  *)
+    echo "unsupported workload: ${WORKLOAD}" >&2
+    exit 1
+    ;;
+esac
+
+RUN_DIR="${RESULTS_DIR}/${RUN_ID}-${KERNEL_LABEL}-${WORKLOAD}-${LOCAL_DRAM}"
+OVERLAY_IMAGE="${OVERLAY_DIR}/paper-cli-elapsed-${RUN_ID}-${KERNEL_LABEL}-${WORKLOAD}-${LOCAL_DRAM}.qcow2"
+SUMMARY_PATH="${RUN_DIR}/summary.txt"
+HOST_LOG="${RUN_DIR}/host-launch.log"
+GUEST_LOG_COPY="${RUN_DIR}/guest-paper-elapsed.log"
+GUEST_OUT_COPY="${RUN_DIR}/guest-paper-elapsed.out"
+GUEST_TIMELOG_COPY="${RUN_DIR}/guest-paper-elapsed.time"
+SERIAL_LOG="${SCRIPT_DIR}/qemu-logs/elapsed-${KERNEL_LABEL}-${WORKLOAD}-$(date +%Y%m%d_%H%M%S).serial.log"
+
+mkdir -p "${RUN_DIR}" "${OVERLAY_DIR}"
+
+sudo_run() {
+  sudo -n "$@"
+}
+
+cleanup() {
+  local rc=$?
+  if [[ "${MOUNT_ACTIVE}" == "1" ]]; then
+    sudo_run umount "${MOUNT_DIR}" || true
+  fi
+  if [[ -n "${ROOT_MAPPER}" ]]; then
+    sudo_run kpartx -d "${NBD_DEVICE}" >/dev/null || true
+  fi
+  if [[ "${NBD_ACTIVE}" == "1" ]]; then
+    sudo_run qemu-nbd --disconnect "${NBD_DEVICE}" >/dev/null || true
+  fi
+  return "${rc}"
+}
+trap cleanup EXIT
+
+create_overlay() {
+  rm -f "${OVERLAY_IMAGE}"
+  qemu-img create -f qcow2 -F qcow2 -b "${ROOTFS_BASE}" "${OVERLAY_IMAGE}" >/dev/null
+}
+
+mount_overlay() {
+  sudo_run qemu-nbd --disconnect "${NBD_DEVICE}" >/dev/null 2>&1 || true
+  sudo_run qemu-nbd --connect="${NBD_DEVICE}" "${OVERLAY_IMAGE}"
+  NBD_ACTIVE=1
+  sleep 1
+  sudo_run kpartx -av "${NBD_DEVICE}" >/dev/null
+  ROOT_MAPPER="/dev/mapper/$(basename "${NBD_DEVICE}")p2"
+  sudo_run mkdir -p "${MOUNT_DIR}"
+  sudo_run mount "${ROOT_MAPPER}" "${MOUNT_DIR}"
+  MOUNT_ACTIVE=1
+}
+
+unmount_overlay() {
+  if [[ "${MOUNT_ACTIVE}" == "1" ]]; then
+    sudo_run umount "${MOUNT_DIR}"
+    MOUNT_ACTIVE=0
+  fi
+  if [[ -n "${ROOT_MAPPER}" ]]; then
+    sudo_run kpartx -d "${NBD_DEVICE}" >/dev/null || true
+    ROOT_MAPPER=""
+  fi
+  if [[ "${NBD_ACTIVE}" == "1" ]]; then
+    sudo_run qemu-nbd --disconnect "${NBD_DEVICE}" >/dev/null || true
+    NBD_ACTIVE=0
+  fi
+}
+
+inject_guest_service() {
+  sudo_run mkdir -p "${MOUNT_DIR}${GUEST_EXTRA_LIB_DIR}"
+  for pattern in "${HOST_LIB_CANDIDATES[@]}"; do
+    shopt -s nullglob
+    for src in ${pattern}; do
+      sudo_run cp -a "${src}" "${MOUNT_DIR}${GUEST_EXTRA_LIB_DIR}/"
+    done
+    shopt -u nullglob
+  done
+
+  sudo_run tee "${MOUNT_DIR}/usr/local/sbin/paper-cli-elapsed.sh" >/dev/null <<EOF
+#!/usr/bin/env bash
+set -euo pipefail
+
+WORKLOAD="${WORKLOAD}"
+TIMEOUT_SEC="${TIMEOUT_SEC}"
+CMD='${GUEST_CMD}'
+GLOBAL_NUMA_BALANCING="${GLOBAL_NUMA_BALANCING}"
+DEMOTION_ENABLED="${DEMOTION_ENABLED}"
+DEMOTE_SCALE_FACTOR="${DEMOTE_SCALE_FACTOR}"
+DEMOTION_SRC_NODE="${DEMOTION_SRC_NODE}"
+DEMOTION_DST_NODE="${DEMOTION_DST_NODE}"
+export LD_LIBRARY_PATH="${GUEST_EXTRA_LIB_DIR}\${LD_LIBRARY_PATH:+:\${LD_LIBRARY_PATH}}"
+LOG=/var/log/paper-cli-elapsed.log
+OUT=/var/log/paper-cli-elapsed.\${WORKLOAD}.out
+TIMELOG=/var/log/paper-cli-elapsed.\${WORKLOAD}.time
+SUMMARY=/var/log/paper-cli-elapsed.summary
+
+exec >>"\${LOG}" 2>&1
+
+echo "[paper-elapsed] start \$(date -u +%Y-%m-%dT%H:%M:%SZ)"
+echo "[paper-elapsed] workload \${WORKLOAD}"
+echo "[paper-elapsed] cmd \${CMD}"
+numactl -H || true
+
+if [[ -w /sys/devices/system/cpu/smt/control ]]; then
+  echo off > /sys/devices/system/cpu/smt/control || true
+fi
+
+if [[ -w /sys/kernel/mm/transparent_hugepage/enabled ]]; then
+  echo never > /sys/kernel/mm/transparent_hugepage/enabled || true
+fi
+if [[ -w /sys/kernel/mm/transparent_hugepage/defrag ]]; then
+  echo never > /sys/kernel/mm/transparent_hugepage/defrag || true
+fi
+
+sync
+if [[ -w /proc/sys/vm/drop_caches ]]; then
+  echo 3 > /proc/sys/vm/drop_caches || true
+fi
+
+if [[ -w /sys/kernel/mm/numa/demotion_enabled ]]; then
+  echo "\${DEMOTION_ENABLED}" > /sys/kernel/mm/numa/demotion_enabled || true
+fi
+if [[ "\${DEMOTION_ENABLED}" != "false" ]]; then
+  if [[ -w /proc/sys/vm/demote_scale_factor ]]; then
+    echo "\${DEMOTE_SCALE_FACTOR}" > /proc/sys/vm/demote_scale_factor || true
+  fi
+  if [[ -w /sys/kernel/mm/numa/demotion_target ]]; then
+    echo "\${DEMOTION_SRC_NODE} \${DEMOTION_DST_NODE}" > /sys/kernel/mm/numa/demotion_target || true
+  fi
+fi
+if [[ -w /proc/sys/kernel/numa_balancing ]]; then
+  echo 0 > /proc/sys/kernel/numa_balancing || true
+  echo "\${GLOBAL_NUMA_BALANCING}" > /proc/sys/kernel/numa_balancing || true
+fi
+
+set +e
+if [[ "\${TIMEOUT_SEC}" == "0" ]]; then
+  /usr/bin/time -v bash -lc "\${CMD}" >"\${OUT}" 2>"\${TIMELOG}"
+  rc=\$?
+else
+  /usr/bin/time -v timeout --signal=INT "\${TIMEOUT_SEC}" bash -lc "\${CMD}" >"\${OUT}" 2>"\${TIMELOG}"
+  rc=\$?
+fi
+set -e
+
+maxrss_kb=\$(awk -F: '/Maximum resident set size/ {gsub(/^[[:space:]]+/, "", \$2); print \$2}' "\${TIMELOG}" | tail -n1)
+elapsed=\$(awk -F': ' '/Elapsed \\(wall clock\\) time/ {print \$2}' "\${TIMELOG}" | tail -n1)
+kernel_numa_balancing=\$(cat /proc/sys/kernel/numa_balancing 2>/dev/null || echo missing)
+demotion_enabled=\$(cat /sys/kernel/mm/numa/demotion_enabled 2>/dev/null || echo missing)
+demote_scale_factor_current=\$(cat /proc/sys/vm/demote_scale_factor 2>/dev/null || echo missing)
+demotion_target=\$(tr '\n' ' ' < /sys/kernel/mm/numa/demotion_target 2>/dev/null | sed 's/[[:space:]]\\+/ /g;s/[[:space:]]\$//' || echo missing)
+thp_enabled=\$(tr '\n' ' ' < /sys/kernel/mm/transparent_hugepage/enabled 2>/dev/null | sed 's/[[:space:]]\\+/ /g;s/[[:space:]]\$//' || echo missing)
+thp_defrag=\$(tr '\n' ' ' < /sys/kernel/mm/transparent_hugepage/defrag 2>/dev/null | sed 's/[[:space:]]\\+/ /g;s/[[:space:]]\$//' || echo missing)
+smt_control=\$(cat /sys/devices/system/cpu/smt/control 2>/dev/null || echo missing)
+
+{
+  echo "workload=\${WORKLOAD}"
+  echo "exit_code=\${rc}"
+  echo "elapsed=\${elapsed:-missing}"
+  echo "maxrss_kb=\${maxrss_kb:-missing}"
+  echo "kernel_numa_balancing=\${kernel_numa_balancing}"
+  echo "demotion_enabled=\${demotion_enabled}"
+  echo "demote_scale_factor=\${demote_scale_factor_current}"
+  echo "demotion_target=\${demotion_target:-missing}"
+  echo "thp_enabled=\${thp_enabled}"
+  echo "thp_defrag=\${thp_defrag}"
+  echo "smt_control=\${smt_control}"
+  echo "cmd=\${CMD}"
+} > "\${SUMMARY}"
+
+cat "\${SUMMARY}"
+sync
+sleep 1
+systemctl --no-block poweroff || poweroff -f || true
+EOF
+  sudo_run chmod 0755 "${MOUNT_DIR}/usr/local/sbin/paper-cli-elapsed.sh"
+
+  sudo_run tee "${MOUNT_DIR}/etc/systemd/system/paper-cli-elapsed.service" >/dev/null <<'EOF'
+[Unit]
+Description=Paper CLI elapsed-time probe
+After=multi-user.target
+Wants=multi-user.target
+
+[Service]
+Type=oneshot
+ExecStart=/usr/local/sbin/paper-cli-elapsed.sh
+TimeoutStartSec=infinity
+
+[Install]
+WantedBy=multi-user.target
+EOF
+
+  sudo_run ln -sfn ../paper-cli-elapsed.service "${MOUNT_DIR}/etc/systemd/system/multi-user.target.wants/paper-cli-elapsed.service"
+  sudo_run ln -sfn /dev/null "${MOUNT_DIR}/etc/systemd/system/systemd-networkd-wait-online.service"
+}
+
+collect_results() {
+  if [[ -f "${MOUNT_DIR}/var/log/paper-cli-elapsed.log" ]]; then
+    sudo_run cp "${MOUNT_DIR}/var/log/paper-cli-elapsed.log" "${GUEST_LOG_COPY}"
+    sudo_run chown "$(id -u):$(id -g)" "${GUEST_LOG_COPY}"
+  fi
+  if [[ -f "${MOUNT_DIR}/var/log/paper-cli-elapsed.${WORKLOAD}.out" ]]; then
+    sudo_run cp "${MOUNT_DIR}/var/log/paper-cli-elapsed.${WORKLOAD}.out" "${GUEST_OUT_COPY}"
+    sudo_run chown "$(id -u):$(id -g)" "${GUEST_OUT_COPY}"
+  fi
+  if [[ -f "${MOUNT_DIR}/var/log/paper-cli-elapsed.${WORKLOAD}.time" ]]; then
+    sudo_run cp "${MOUNT_DIR}/var/log/paper-cli-elapsed.${WORKLOAD}.time" "${GUEST_TIMELOG_COPY}"
+    sudo_run chown "$(id -u):$(id -g)" "${GUEST_TIMELOG_COPY}"
+  fi
+  if [[ -f "${MOUNT_DIR}/var/log/paper-cli-elapsed.summary" ]]; then
+    sudo_run cp "${MOUNT_DIR}/var/log/paper-cli-elapsed.summary" "${SUMMARY_PATH}"
+    sudo_run chown "$(id -u):$(id -g)" "${SUMMARY_PATH}"
+  fi
+}
+
+create_overlay
+mount_overlay
+inject_guest_service
+unmount_overlay
+
+if [[ "${TIMEOUT_SEC}" == "0" ]]; then
+  "${LAUNCHER}" \
+    --rootfs "${OVERLAY_IMAGE}" \
+    --rootfs-format qcow2 \
+    --kernel-dir "${KERNEL_DIR}" \
+    --kernel-image "${KERNEL_IMAGE}" \
+    --local-dram "${LOCAL_DRAM}" \
+    --remote-mem "${REMOTE_MEM}" \
+    --name "elapsed-${WORKLOAD}" \
+    --serial-log "${SERIAL_LOG}" \
+    > "${HOST_LOG}" 2>&1
+else
+  timeout --signal=INT $(( TIMEOUT_SEC + 180 )) \
+    "${LAUNCHER}" \
+      --rootfs "${OVERLAY_IMAGE}" \
+      --rootfs-format qcow2 \
+      --kernel-dir "${KERNEL_DIR}" \
+      --kernel-image "${KERNEL_IMAGE}" \
+      --local-dram "${LOCAL_DRAM}" \
+      --remote-mem "${REMOTE_MEM}" \
+      --name "elapsed-${WORKLOAD}" \
+      --serial-log "${SERIAL_LOG}" \
+      > "${HOST_LOG}" 2>&1
+fi
+
+mount_overlay
+collect_results
+unmount_overlay
+
+if [[ -f "${SUMMARY_PATH}" ]]; then
+  cat "${SUMMARY_PATH}"
+else
+  echo "summary file missing: ${SUMMARY_PATH}" >&2
+  exit 1
+fi
diff --git a/scripts/kernel/run_qemu_paper_cli_elapsed_sweep.sh b/scripts/kernel/run_qemu_paper_cli_elapsed_sweep.sh
new file mode 100755
index 000000000..7073c4403
--- /dev/null
+++ b/scripts/kernel/run_qemu_paper_cli_elapsed_sweep.sh
@@ -0,0 +1,159 @@
+#!/usr/bin/env bash
+set -euo pipefail
+
+usage() {
+  cat <<'EOF'
+Usage:
+  run_qemu_paper_cli_elapsed_sweep.sh [options]
+
+Run one or more paper workloads across multiple guest local-DRAM sizes and
+collect elapsed-time summaries.
+
+Options:
+  --kernel-image <path>     bzImage path
+  --kernel-dir <path>       Kernel tree (default: this repo root)
+  --kernel-label <name>     Label used in result paths
+  --local-drams <csv>       Comma-separated guest node0 sizes (default: 16G,32G,48G)
+  --remote-mem <size>       Guest node1 size (default: 128G)
+  --timeout-sec <n>         Per-run timeout in seconds, 0 disables timeout (default: 0)
+  --run-id <id>             Suite result directory tag
+  --workloads <csv>         Comma-separated list. Default: bc
+  --global-numa-balancing <n>
+                            /proc/sys/kernel/numa_balancing value (default: 2)
+  --demotion-enabled <bool> true|false for /sys/kernel/mm/numa/demotion_enabled
+                            (default: true)
+  --demote-scale-factor <n> /proc/sys/vm/demote_scale_factor value (default: 400)
+  --demotion-src-node <id>  Source node for optional demotion_target (default: 0)
+  --demotion-dst-node <id>  Destination node for optional demotion_target (default: 1)
+  -h, --help                Show this help
+EOF
+}
+
+SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
+REPO_ROOT="$(cd "${SCRIPT_DIR}/../.." && pwd)"
+RUNNER="${SCRIPT_DIR}/run_qemu_paper_cli_elapsed.sh"
+KERNEL_DIR="${REPO_ROOT}"
+KERNEL_IMAGE=""
+KERNEL_LABEL="$(basename "${REPO_ROOT}")"
+LOCAL_DRAMS_CSV="16G,32G,48G"
+REMOTE_MEM="128G"
+TIMEOUT_SEC="0"
+RUN_ID="$(date -u +%Y%m%dT%H%M%SZ)"
+WORKLOADS_CSV="bc"
+GLOBAL_NUMA_BALANCING="2"
+DEMOTION_ENABLED="true"
+DEMOTE_SCALE_FACTOR="400"
+DEMOTION_SRC_NODE="0"
+DEMOTION_DST_NODE="1"
+SUITE_DIR=""
+SUMMARY_CSV=""
+
+while [[ $# -gt 0 ]]; do
+  case "$1" in
+    --kernel-image)
+      KERNEL_IMAGE="${2:-}"; shift 2 ;;
+    --kernel-dir)
+      KERNEL_DIR="${2:-}"; shift 2 ;;
+    --kernel-label)
+      KERNEL_LABEL="${2:-}"; shift 2 ;;
+    --local-drams)
+      LOCAL_DRAMS_CSV="${2:-}"; shift 2 ;;
+    --remote-mem)
+      REMOTE_MEM="${2:-}"; shift 2 ;;
+    --timeout-sec)
+      TIMEOUT_SEC="${2:-}"; shift 2 ;;
+    --run-id)
+      RUN_ID="${2:-}"; shift 2 ;;
+    --workloads)
+      WORKLOADS_CSV="${2:-}"; shift 2 ;;
+    --global-numa-balancing)
+      GLOBAL_NUMA_BALANCING="${2:-}"; shift 2 ;;
+    --demotion-enabled)
+      DEMOTION_ENABLED="${2:-}"; shift 2 ;;
+    --demote-scale-factor)
+      DEMOTE_SCALE_FACTOR="${2:-}"; shift 2 ;;
+    --demotion-src-node)
+      DEMOTION_SRC_NODE="${2:-}"; shift 2 ;;
+    --demotion-dst-node)
+      DEMOTION_DST_NODE="${2:-}"; shift 2 ;;
+    -h|--help)
+      usage; exit 0 ;;
+    *)
+      echo "Unknown option: $1" >&2
+      usage >&2
+      exit 1 ;;
+  esac
+done
+
+if [[ -z "${KERNEL_IMAGE}" ]]; then
+  KERNEL_IMAGE="${KERNEL_DIR}/arch/x86/boot/bzImage"
+fi
+
+if [[ ! -f "${KERNEL_IMAGE}" ]]; then
+  echo "kernel image not found: ${KERNEL_IMAGE}" >&2
+  exit 1
+fi
+
+SUITE_DIR="${SCRIPT_DIR}/qemu-results/paper-cli-elapsed-sweep/${RUN_ID}-${KERNEL_LABEL}"
+SUMMARY_CSV="${SUITE_DIR}/summary.csv"
+mkdir -p "${SUITE_DIR}"
+
+printf 'local_dram,workload,exit_code,elapsed,maxrss_kb,kernel_numa_balancing,demotion_enabled,demote_scale_factor,thp_enabled,smt_control,summary_path\n' > "${SUMMARY_CSV}"
+
+IFS=',' read -r -a LOCAL_DRAMS <<< "${LOCAL_DRAMS_CSV}"
+IFS=',' read -r -a WORKLOADS <<< "${WORKLOADS_CSV}"
+
+for local_dram in "${LOCAL_DRAMS[@]}"; do
+  local_dram="${local_dram// /}"
+  [[ -z "${local_dram}" ]] && continue
+
+  for workload in "${WORKLOADS[@]}"; do
+    workload="${workload// /}"
+    [[ -z "${workload}" ]] && continue
+
+    echo "== ${local_dram} / ${workload} =="
+    "${RUNNER}" \
+      --kernel-dir "${KERNEL_DIR}" \
+      --kernel-image "${KERNEL_IMAGE}" \
+      --kernel-label "${KERNEL_LABEL}" \
+      --workload "${workload}" \
+      --local-dram "${local_dram}" \
+      --remote-mem "${REMOTE_MEM}" \
+      --timeout-sec "${TIMEOUT_SEC}" \
+      --run-id "${RUN_ID}" \
+      --global-numa-balancing "${GLOBAL_NUMA_BALANCING}" \
+      --demotion-enabled "${DEMOTION_ENABLED}" \
+      --demote-scale-factor "${DEMOTE_SCALE_FACTOR}" \
+      --demotion-src-node "${DEMOTION_SRC_NODE}" \
+      --demotion-dst-node "${DEMOTION_DST_NODE}"
+
+    summary_path="${SCRIPT_DIR}/qemu-results/paper-cli-elapsed/${RUN_ID}-${KERNEL_LABEL}-${workload}-${local_dram}/summary.txt"
+    if [[ -f "${summary_path}" ]]; then
+      exit_code="$(awk -F= '/^exit_code=/{print $2}' "${summary_path}")"
+      elapsed="$(awk -F= '/^elapsed=/{print $2}' "${summary_path}")"
+      maxrss_kb="$(awk -F= '/^maxrss_kb=/{print $2}' "${summary_path}")"
+      kernel_numa_balancing="$(awk -F= '/^kernel_numa_balancing=/{print $2}' "${summary_path}")"
+      demotion_enabled="$(awk -F= '/^demotion_enabled=/{print $2}' "${summary_path}")"
+      demote_scale_factor="$(awk -F= '/^demote_scale_factor=/{print $2}' "${summary_path}")"
+      thp_enabled="$(awk -F= '/^thp_enabled=/{print $2}' "${summary_path}")"
+      smt_control="$(awk -F= '/^smt_control=/{print $2}' "${summary_path}")"
+      printf '%s,%s,%s,%s,%s,%s,%s,%s,%s,%s,%s\n' \
+        "${local_dram}" \
+        "${workload}" \
+        "${exit_code}" \
+        "${elapsed}" \
+        "${maxrss_kb}" \
+        "${kernel_numa_balancing}" \
+        "${demotion_enabled}" \
+        "${demote_scale_factor}" \
+        "${thp_enabled}" \
+        "${smt_control}" \
+        "${summary_path}" >> "${SUMMARY_CSV}"
+    else
+      printf '%s,%s,missing,missing,missing,missing,missing,missing,missing,missing,%s\n' \
+        "${local_dram}" "${workload}" "${summary_path}" >> "${SUMMARY_CSV}"
+    fi
+  done
+done
+
+cat "${SUMMARY_CSV}"
diff --git a/scripts/kernel/run_qemu_paper_cli_rss.sh b/scripts/kernel/run_qemu_paper_cli_rss.sh
new file mode 100755
index 000000000..cd716f5f3
--- /dev/null
+++ b/scripts/kernel/run_qemu_paper_cli_rss.sh
@@ -0,0 +1,341 @@
+#!/usr/bin/env bash
+set -euo pipefail
+
+usage() {
+  cat <<'EOF'
+Usage:
+  run_qemu_paper_cli_rss.sh [options]
+
+Boot a paper-topology VM, run one workload command derived from
+/Serverless/Migration-friendly/scripts/bench_V2/run_benchmark.py inside the
+guest, and collect maximum RSS.
+
+Options:
+  --workload <name>         pr|bc|silo|liblinear|FT|LU|SP|gups (default: liblinear)
+  --kernel-image <path>     bzImage path
+  --kernel-dir <path>       Kernel tree (default: this repo root)
+  --kernel-label <name>     Label used in result paths (default: current tree name)
+  --rootfs-base <path>      Base paper-workload overlay
+  --local-dram <size>       Guest node0 size: 16G|32G|48G (default: 32G)
+  --remote-mem <size>       Guest node1 size (default: 128G)
+  --timeout-sec <n>         In-guest workload timeout in seconds (default: 300)
+  --run-id <id>             Result directory tag
+  -h, --help                Show this help
+EOF
+}
+
+SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
+REPO_ROOT="$(cd "${SCRIPT_DIR}/../.." && pwd)"
+LAUNCHER="${SCRIPT_DIR}/launch_paper_topology_qemu.sh"
+ROOTFS_BASE="${SCRIPT_DIR}/vm-images/adaptive-migration-paper-workloads.qcow2"
+KERNEL_DIR="${REPO_ROOT}"
+KERNEL_IMAGE=""
+KERNEL_LABEL="$(basename "${REPO_ROOT}")"
+WORKLOAD="liblinear"
+LOCAL_DRAM="32G"
+REMOTE_MEM="128G"
+TIMEOUT_SEC="300"
+RUN_ID="$(date -u +%Y%m%dT%H%M%SZ)"
+RESULTS_DIR="${SCRIPT_DIR}/qemu-results/paper-cli-rss"
+OVERLAY_DIR="${SCRIPT_DIR}/vm-images"
+NBD_DEVICE="${NBD_DEVICE:-/dev/nbd0}"
+MOUNT_DIR="${MOUNT_DIR:-/tmp/paper-cli-rss-root}"
+RUN_DIR=""
+OVERLAY_IMAGE=""
+SUMMARY_PATH=""
+HOST_LOG=""
+GUEST_LOG_COPY=""
+GUEST_OUT_COPY=""
+GUEST_TIMELOG_COPY=""
+SERIAL_LOG=""
+ROOT_MAPPER=""
+NBD_ACTIVE=0
+MOUNT_ACTIVE=0
+GUEST_EXTRA_LIB_DIR="/usr/local/lib/paper-workloads"
+HOST_LIB_CANDIDATES=(
+  /lib/x86_64-linux-gnu/libgfortran.so.5
+  /lib/x86_64-linux-gnu/libgfortran.so.5.*
+  /lib/x86_64-linux-gnu/libquadmath.so.0
+  /lib/x86_64-linux-gnu/libquadmath.so.0.*
+  /lib/x86_64-linux-gnu/libgomp.so.1
+  /lib/x86_64-linux-gnu/libgomp.so.1.*
+  /lib/x86_64-linux-gnu/libstdc++.so.6
+  /lib/x86_64-linux-gnu/libstdc++.so.6.*
+  /lib/x86_64-linux-gnu/libgcc_s.so.1
+  /lib/x86_64-linux-gnu/libnuma.so.1
+  /lib/x86_64-linux-gnu/libjemalloc.so.2
+  /lib/x86_64-linux-gnu/libdb_cxx-5.3.so
+)
+
+while [[ $# -gt 0 ]]; do
+  case "$1" in
+    --workload)
+      WORKLOAD="${2:-}"; shift 2 ;;
+    --kernel-image)
+      KERNEL_IMAGE="${2:-}"; shift 2 ;;
+    --kernel-dir)
+      KERNEL_DIR="${2:-}"; shift 2 ;;
+    --kernel-label)
+      KERNEL_LABEL="${2:-}"; shift 2 ;;
+    --rootfs-base)
+      ROOTFS_BASE="${2:-}"; shift 2 ;;
+    --local-dram)
+      LOCAL_DRAM="${2:-}"; shift 2 ;;
+    --remote-mem)
+      REMOTE_MEM="${2:-}"; shift 2 ;;
+    --timeout-sec)
+      TIMEOUT_SEC="${2:-}"; shift 2 ;;
+    --run-id)
+      RUN_ID="${2:-}"; shift 2 ;;
+    -h|--help)
+      usage; exit 0 ;;
+    *)
+      echo "Unknown option: $1" >&2
+      usage >&2
+      exit 1 ;;
+  esac
+done
+
+if [[ -z "${KERNEL_IMAGE}" ]]; then
+  KERNEL_IMAGE="${KERNEL_DIR}/arch/x86/boot/bzImage"
+fi
+
+if [[ ! -f "${ROOTFS_BASE}" ]]; then
+  echo "base rootfs not found: ${ROOTFS_BASE}" >&2
+  exit 1
+fi
+
+if [[ ! -f "${KERNEL_IMAGE}" ]]; then
+  echo "kernel image not found: ${KERNEL_IMAGE}" >&2
+  exit 1
+fi
+
+case "${WORKLOAD}" in
+  pr)
+    GUEST_CMD='/Serverless/benchmark/gapbs/pr -g28 -i1000 -t1e-4 -n20'
+    ;;
+  bc)
+    GUEST_CMD='/Serverless/benchmark/gapbs/bc -g28'
+    ;;
+  silo)
+    GUEST_CMD='LD_LIBRARY_PATH=/Serverless/benchmark/paper-workloads/lib${LD_LIBRARY_PATH:+:$LD_LIBRARY_PATH} /Serverless/benchmark/silo/out-perf.masstree/benchmarks/dbtest --verbose --num-threads 32 --bench ycsb --scale-factor 550000 --ops-per-worker=200000000'
+    ;;
+  liblinear)
+    GUEST_CMD='/Serverless/benchmark/liblinear-multicore-2.47/train -s 6 -m 32 /Serverless/benchmark/liblinear-multicore-2.47/datasets/kdd12'
+    ;;
+  FT)
+    GUEST_CMD='/Serverless/benchmark/NPB3.4.3/NPB3.4-OMP/bin/ft.H.x'
+    ;;
+  LU)
+    GUEST_CMD='/Serverless/benchmark/NPB3.4.3/NPB3.4-OMP/bin/lu.H.x'
+    ;;
+  SP)
+    GUEST_CMD='/Serverless/benchmark/NPB3.4.3/NPB3.4-OMP/bin/sp.H.x'
+    ;;
+  gups)
+    GUEST_CMD='/Serverless/benchmark/vmitosis-workloads/bin/bench_gups_mt'
+    ;;
+  *)
+    echo "unsupported workload: ${WORKLOAD}" >&2
+    exit 1
+    ;;
+esac
+
+RUN_DIR="${RESULTS_DIR}/${RUN_ID}-${KERNEL_LABEL}-${WORKLOAD}-${LOCAL_DRAM}"
+OVERLAY_IMAGE="${OVERLAY_DIR}/paper-cli-rss-${RUN_ID}-${KERNEL_LABEL}-${WORKLOAD}-${LOCAL_DRAM}.qcow2"
+SUMMARY_PATH="${RUN_DIR}/summary.txt"
+HOST_LOG="${RUN_DIR}/host-launch.log"
+GUEST_LOG_COPY="${RUN_DIR}/guest-paper-rss.log"
+GUEST_OUT_COPY="${RUN_DIR}/guest-paper-rss.out"
+GUEST_TIMELOG_COPY="${RUN_DIR}/guest-paper-rss.time"
+SERIAL_LOG="${SCRIPT_DIR}/qemu-logs/rss-${KERNEL_LABEL}-${WORKLOAD}-$(date +%Y%m%d_%H%M%S).serial.log"
+
+mkdir -p "${RUN_DIR}" "${OVERLAY_DIR}"
+
+sudo_run() {
+  sudo -n "$@"
+}
+
+cleanup() {
+  local rc=$?
+  if [[ "${MOUNT_ACTIVE}" == "1" ]]; then
+    sudo_run umount "${MOUNT_DIR}" || true
+  fi
+  if [[ -n "${ROOT_MAPPER}" ]]; then
+    sudo_run kpartx -d "${NBD_DEVICE}" >/dev/null || true
+  fi
+  if [[ "${NBD_ACTIVE}" == "1" ]]; then
+    sudo_run qemu-nbd --disconnect "${NBD_DEVICE}" >/dev/null || true
+  fi
+  return "${rc}"
+}
+trap cleanup EXIT
+
+create_overlay() {
+  rm -f "${OVERLAY_IMAGE}"
+  qemu-img create -f qcow2 -F qcow2 -b "${ROOTFS_BASE}" "${OVERLAY_IMAGE}" >/dev/null
+}
+
+mount_overlay() {
+  sudo_run qemu-nbd --disconnect "${NBD_DEVICE}" >/dev/null 2>&1 || true
+  sudo_run qemu-nbd --connect="${NBD_DEVICE}" "${OVERLAY_IMAGE}"
+  NBD_ACTIVE=1
+  sleep 1
+  sudo_run kpartx -av "${NBD_DEVICE}" >/dev/null
+  ROOT_MAPPER="/dev/mapper/$(basename "${NBD_DEVICE}")p2"
+  sudo_run mkdir -p "${MOUNT_DIR}"
+  sudo_run mount "${ROOT_MAPPER}" "${MOUNT_DIR}"
+  MOUNT_ACTIVE=1
+}
+
+unmount_overlay() {
+  if [[ "${MOUNT_ACTIVE}" == "1" ]]; then
+    sudo_run umount "${MOUNT_DIR}"
+    MOUNT_ACTIVE=0
+  fi
+  if [[ -n "${ROOT_MAPPER}" ]]; then
+    sudo_run kpartx -d "${NBD_DEVICE}" >/dev/null || true
+    ROOT_MAPPER=""
+  fi
+  if [[ "${NBD_ACTIVE}" == "1" ]]; then
+    sudo_run qemu-nbd --disconnect "${NBD_DEVICE}" >/dev/null || true
+    NBD_ACTIVE=0
+  fi
+}
+
+inject_guest_service() {
+  sudo_run mkdir -p "${MOUNT_DIR}${GUEST_EXTRA_LIB_DIR}"
+  for pattern in "${HOST_LIB_CANDIDATES[@]}"; do
+    shopt -s nullglob
+    for src in ${pattern}; do
+      sudo_run cp -a "${src}" "${MOUNT_DIR}${GUEST_EXTRA_LIB_DIR}/"
+    done
+    shopt -u nullglob
+  done
+
+  sudo_run tee "${MOUNT_DIR}/usr/local/sbin/paper-cli-rss.sh" >/dev/null <<EOF
+#!/usr/bin/env bash
+set -euo pipefail
+
+WORKLOAD="${WORKLOAD}"
+TIMEOUT_SEC="${TIMEOUT_SEC}"
+CMD='${GUEST_CMD}'
+export LD_LIBRARY_PATH="${GUEST_EXTRA_LIB_DIR}\${LD_LIBRARY_PATH:+:\${LD_LIBRARY_PATH}}"
+LOG=/var/log/paper-cli-rss.log
+OUT=/var/log/paper-cli-rss.\${WORKLOAD}.out
+TIMELOG=/var/log/paper-cli-rss.\${WORKLOAD}.time
+SUMMARY=/var/log/paper-cli-rss.summary
+
+exec >>"\${LOG}" 2>&1
+
+echo "[paper-rss] start \$(date -u +%Y-%m-%dT%H:%M:%SZ)"
+echo "[paper-rss] workload \${WORKLOAD}"
+echo "[paper-rss] cmd \${CMD}"
+numactl -H || true
+
+set +e
+if [[ "\${TIMEOUT_SEC}" == "0" ]]; then
+  /usr/bin/time -v bash -lc "\${CMD}" >"\${OUT}" 2>"\${TIMELOG}"
+  rc=\$?
+else
+  /usr/bin/time -v timeout --signal=INT "\${TIMEOUT_SEC}" bash -lc "\${CMD}" >"\${OUT}" 2>"\${TIMELOG}"
+  rc=\$?
+fi
+set -e
+
+maxrss_kb=\$(awk -F: '/Maximum resident set size/ {gsub(/^[[:space:]]+/, "", \$2); print \$2}' "\${TIMELOG}" | tail -n1)
+elapsed=\$(awk -F': ' '/Elapsed \\(wall clock\\) time/ {print \$2}' "\${TIMELOG}" | tail -n1)
+
+{
+  echo "workload=\${WORKLOAD}"
+  echo "exit_code=\${rc}"
+  echo "maxrss_kb=\${maxrss_kb:-missing}"
+  echo "elapsed=\${elapsed:-missing}"
+  echo "cmd=\${CMD}"
+} > "\${SUMMARY}"
+
+cat "\${SUMMARY}"
+sync
+sleep 1
+systemctl --no-block poweroff || poweroff -f || true
+EOF
+  sudo_run chmod 0755 "${MOUNT_DIR}/usr/local/sbin/paper-cli-rss.sh"
+
+  sudo_run tee "${MOUNT_DIR}/etc/systemd/system/paper-cli-rss.service" >/dev/null <<'EOF'
+[Unit]
+Description=Paper CLI RSS probe
+After=multi-user.target
+Wants=multi-user.target
+
+[Service]
+Type=oneshot
+ExecStart=/usr/local/sbin/paper-cli-rss.sh
+TimeoutStartSec=infinity
+
+[Install]
+WantedBy=multi-user.target
+EOF
+
+  sudo_run ln -sfn ../paper-cli-rss.service "${MOUNT_DIR}/etc/systemd/system/multi-user.target.wants/paper-cli-rss.service"
+  sudo_run ln -sfn /dev/null "${MOUNT_DIR}/etc/systemd/system/systemd-networkd-wait-online.service"
+}
+
+collect_results() {
+  if [[ -f "${MOUNT_DIR}/var/log/paper-cli-rss.log" ]]; then
+    sudo_run cp "${MOUNT_DIR}/var/log/paper-cli-rss.log" "${GUEST_LOG_COPY}"
+    sudo_run chown "$(id -u):$(id -g)" "${GUEST_LOG_COPY}"
+  fi
+  if [[ -f "${MOUNT_DIR}/var/log/paper-cli-rss.${WORKLOAD}.out" ]]; then
+    sudo_run cp "${MOUNT_DIR}/var/log/paper-cli-rss.${WORKLOAD}.out" "${GUEST_OUT_COPY}"
+    sudo_run chown "$(id -u):$(id -g)" "${GUEST_OUT_COPY}"
+  fi
+  if [[ -f "${MOUNT_DIR}/var/log/paper-cli-rss.${WORKLOAD}.time" ]]; then
+    sudo_run cp "${MOUNT_DIR}/var/log/paper-cli-rss.${WORKLOAD}.time" "${GUEST_TIMELOG_COPY}"
+    sudo_run chown "$(id -u):$(id -g)" "${GUEST_TIMELOG_COPY}"
+  fi
+  if [[ -f "${MOUNT_DIR}/var/log/paper-cli-rss.summary" ]]; then
+    sudo_run cp "${MOUNT_DIR}/var/log/paper-cli-rss.summary" "${SUMMARY_PATH}"
+    sudo_run chown "$(id -u):$(id -g)" "${SUMMARY_PATH}"
+  fi
+}
+
+create_overlay
+mount_overlay
+inject_guest_service
+unmount_overlay
+
+if [[ "${TIMEOUT_SEC}" == "0" ]]; then
+  "${LAUNCHER}" \
+    --rootfs "${OVERLAY_IMAGE}" \
+    --rootfs-format qcow2 \
+    --kernel-dir "${KERNEL_DIR}" \
+    --kernel-image "${KERNEL_IMAGE}" \
+    --local-dram "${LOCAL_DRAM}" \
+    --remote-mem "${REMOTE_MEM}" \
+    --name "rss-${WORKLOAD}" \
+    --serial-log "${SERIAL_LOG}" \
+    > "${HOST_LOG}" 2>&1
+else
+  timeout --signal=INT $(( TIMEOUT_SEC + 180 )) \
+    "${LAUNCHER}" \
+      --rootfs "${OVERLAY_IMAGE}" \
+      --rootfs-format qcow2 \
+      --kernel-dir "${KERNEL_DIR}" \
+      --kernel-image "${KERNEL_IMAGE}" \
+      --local-dram "${LOCAL_DRAM}" \
+      --remote-mem "${REMOTE_MEM}" \
+      --name "rss-${WORKLOAD}" \
+      --serial-log "${SERIAL_LOG}" \
+      > "${HOST_LOG}" 2>&1
+fi
+
+mount_overlay
+collect_results
+unmount_overlay
+
+if [[ -f "${SUMMARY_PATH}" ]]; then
+  cat "${SUMMARY_PATH}"
+else
+  echo "summary file missing: ${SUMMARY_PATH}" >&2
+  exit 1
+fi
diff --git a/scripts/kernel/run_qemu_paper_cli_rss_suite.sh b/scripts/kernel/run_qemu_paper_cli_rss_suite.sh
new file mode 100755
index 000000000..b705b246e
--- /dev/null
+++ b/scripts/kernel/run_qemu_paper_cli_rss_suite.sh
@@ -0,0 +1,109 @@
+#!/usr/bin/env bash
+set -euo pipefail
+
+usage() {
+  cat <<'EOF'
+Usage:
+  run_qemu_paper_cli_rss_suite.sh [options]
+
+Run the paper workload set sequentially inside paper-topology VMs and collect
+RSS summaries.
+
+Options:
+  --kernel-image <path>     bzImage path
+  --kernel-dir <path>       Kernel tree (default: this repo root)
+  --kernel-label <name>     Label used in result paths
+  --local-dram <size>       Guest node0 size: 16G|32G|48G (default: 32G)
+  --remote-mem <size>       Guest node1 size (default: 128G)
+  --timeout-sec <n>         Per-workload timeout in seconds, 0 disables timeout (default: 43200)
+  --run-id <id>             Suite result directory tag
+  --workloads <csv>         Comma-separated list. Default: FT,LU,SP,liblinear,gups,silo,bc,pr
+  -h, --help                Show this help
+EOF
+}
+
+SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
+REPO_ROOT="$(cd "${SCRIPT_DIR}/../.." && pwd)"
+RUNNER="${SCRIPT_DIR}/run_qemu_paper_cli_rss.sh"
+KERNEL_DIR="${REPO_ROOT}"
+KERNEL_IMAGE=""
+KERNEL_LABEL="$(basename "${REPO_ROOT}")"
+LOCAL_DRAM="32G"
+REMOTE_MEM="128G"
+TIMEOUT_SEC="43200"
+RUN_ID="$(date -u +%Y%m%dT%H%M%SZ)"
+WORKLOADS_CSV="FT,LU,SP,liblinear,gups,silo,bc,pr"
+SUITE_DIR=""
+SUMMARY_CSV=""
+
+while [[ $# -gt 0 ]]; do
+  case "$1" in
+    --kernel-image)
+      KERNEL_IMAGE="${2:-}"; shift 2 ;;
+    --kernel-dir)
+      KERNEL_DIR="${2:-}"; shift 2 ;;
+    --kernel-label)
+      KERNEL_LABEL="${2:-}"; shift 2 ;;
+    --local-dram)
+      LOCAL_DRAM="${2:-}"; shift 2 ;;
+    --remote-mem)
+      REMOTE_MEM="${2:-}"; shift 2 ;;
+    --timeout-sec)
+      TIMEOUT_SEC="${2:-}"; shift 2 ;;
+    --run-id)
+      RUN_ID="${2:-}"; shift 2 ;;
+    --workloads)
+      WORKLOADS_CSV="${2:-}"; shift 2 ;;
+    -h|--help)
+      usage; exit 0 ;;
+    *)
+      echo "Unknown option: $1" >&2
+      usage >&2
+      exit 1 ;;
+  esac
+done
+
+if [[ -z "${KERNEL_IMAGE}" ]]; then
+  KERNEL_IMAGE="${KERNEL_DIR}/arch/x86/boot/bzImage"
+fi
+
+if [[ ! -f "${KERNEL_IMAGE}" ]]; then
+  echo "kernel image not found: ${KERNEL_IMAGE}" >&2
+  exit 1
+fi
+
+SUITE_DIR="${SCRIPT_DIR}/qemu-results/paper-cli-rss-suite/${RUN_ID}-${KERNEL_LABEL}-${LOCAL_DRAM}"
+SUMMARY_CSV="${SUITE_DIR}/summary.csv"
+mkdir -p "${SUITE_DIR}"
+
+printf 'workload,exit_code,maxrss_kb,elapsed,summary_path\n' > "${SUMMARY_CSV}"
+
+IFS=',' read -r -a WORKLOADS <<< "${WORKLOADS_CSV}"
+
+for workload in "${WORKLOADS[@]}"; do
+  workload="${workload// /}"
+  [[ -z "${workload}" ]] && continue
+
+  echo "== ${workload} =="
+  "${RUNNER}" \
+    --kernel-dir "${KERNEL_DIR}" \
+    --kernel-image "${KERNEL_IMAGE}" \
+    --kernel-label "${KERNEL_LABEL}" \
+    --workload "${workload}" \
+    --local-dram "${LOCAL_DRAM}" \
+    --remote-mem "${REMOTE_MEM}" \
+    --timeout-sec "${TIMEOUT_SEC}" \
+    --run-id "${RUN_ID}"
+
+  summary_path="${SCRIPT_DIR}/qemu-results/paper-cli-rss/${RUN_ID}-${KERNEL_LABEL}-${workload}-${LOCAL_DRAM}/summary.txt"
+  if [[ -f "${summary_path}" ]]; then
+    exit_code="$(awk -F= '/^exit_code=/{print $2}' "${summary_path}")"
+    maxrss_kb="$(awk -F= '/^maxrss_kb=/{print $2}' "${summary_path}")"
+    elapsed="$(awk -F= '/^elapsed=/{print $2}' "${summary_path}")"
+    printf '%s,%s,%s,%s,%s\n' "${workload}" "${exit_code}" "${maxrss_kb}" "${elapsed}" "${summary_path}" >> "${SUMMARY_CSV}"
+  else
+    printf '%s,missing,missing,missing,%s\n' "${workload}" "${summary_path}" >> "${SUMMARY_CSV}"
+  fi
+done
+
+cat "${SUMMARY_CSV}"
diff --git a/scripts/kernel/run_qemu_phase_candidate_microbench.sh b/scripts/kernel/run_qemu_phase_candidate_microbench.sh
new file mode 100755
index 000000000..9e44187a3
--- /dev/null
+++ b/scripts/kernel/run_qemu_phase_candidate_microbench.sh
@@ -0,0 +1,387 @@
+#!/usr/bin/env bash
+set -euo pipefail
+
+# Host-side wrapper for the guest candidate runner.
+# It boots a disposable qcow2 overlay VM, uploads the mbench binary and
+# guest script, runs the candidate scan, collects artifacts, and powers off.
+
+SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
+REPO_ROOT="$(cd "${SCRIPT_DIR}/../.." && pwd)"
+
+LAUNCHER="${LAUNCHER:-${SCRIPT_DIR}/launch_kernel_qemu.sh}"
+GUEST_SCRIPT="${GUEST_SCRIPT:-${SCRIPT_DIR}/run_phase_candidate_microbench_guest.sh}"
+MBENCH_BIN="${MBENCH_BIN:-${REPO_ROOT}/Microbenchmark/mbench}"
+OUTDIR="${OUTDIR:-${SCRIPT_DIR}/qemu-logs/phase_candidate_microbench}"
+RUN_ID="${RUN_ID:-$(date -u +%Y%m%dT%H%M%SZ)}"
+
+QEMU_TREE="${QEMU_TREE:-/Serverless/Migration-friendly/qemu}"
+SHARED_ROOTFS_DEFAULT="${SHARED_ROOTFS_DEFAULT:-${QEMU_TREE}/build/ubuntu.img}"
+LOCAL_ROOTFS_DEFAULT="${LOCAL_ROOTFS_DEFAULT:-${SCRIPT_DIR}/vm-images/adaptive-migration-base.qcow2}"
+if [[ -z "${ROOTFS_BASE+x}" ]]; then
+  if [[ -f "${LOCAL_ROOTFS_DEFAULT}" ]]; then
+    ROOTFS_BASE="${LOCAL_ROOTFS_DEFAULT}"
+  else
+    ROOTFS_BASE="${SHARED_ROOTFS_DEFAULT}"
+  fi
+fi
+ROOTFS_BASE_FORMAT="${ROOTFS_BASE_FORMAT:-}"
+if [[ -z "${ROOTFS_BASE_FORMAT}" ]]; then
+  case "${ROOTFS_BASE}" in
+    *.qcow2) ROOTFS_BASE_FORMAT="qcow2" ;;
+    *) ROOTFS_BASE_FORMAT="raw" ;;
+  esac
+fi
+ROOTFS_OVERLAY="${ROOTFS_OVERLAY:-${OUTDIR}/${RUN_ID}/ubuntu-overlay.qcow2}"
+KREL_DETECT="$(make -s -C "${REPO_ROOT}" kernelrelease 2>/dev/null || true)"
+if [[ -z "${KERNEL_IMAGE+x}" ]]; then
+  KERNEL_IMAGE="${REPO_ROOT}/arch/x86/boot/bzImage"
+fi
+if [[ -z "${INITRD_IMAGE+x}" ]]; then
+  AUTO_INITRD="${SCRIPT_DIR}/kernel-artifacts/initramfs-${KREL_DETECT}.img"
+  if [[ -n "${KREL_DETECT}" && -f "${AUTO_INITRD}" ]]; then
+    INITRD_IMAGE="${AUTO_INITRD}"
+  else
+    INITRD_IMAGE=""
+  fi
+fi
+QEMU_BIN="${QEMU_BIN:-${QEMU_TREE}/build/qemu-system-x86_64}"
+QEMU_IMG="${QEMU_IMG:-${QEMU_TREE}/build/qemu-img}"
+QEMU_NBD="${QEMU_NBD:-${QEMU_TREE}/build/qemu-nbd}"
+SSH_KEY="${SSH_KEY:-${QEMU_TREE}/tests/keys/id_rsa}"
+SSH_PUB_KEY="${SSH_PUB_KEY:-${QEMU_TREE}/tests/keys/id_rsa.pub}"
+SSH_KEY_RUNTIME="${SSH_KEY_RUNTIME:-${OUTDIR}/${RUN_ID}/id_rsa}"
+SSH_PORT="${SSH_PORT:-10032}"
+SSH_USERS="${SSH_USERS:-root ubuntu}"
+SSH_CONNECT_TIMEOUT="${SSH_CONNECT_TIMEOUT:-10}"
+SSH_WAIT_SEC="${SSH_WAIT_SEC:-300}"
+VM_NAME="${VM_NAME:-phase-candidate}"
+MEMORY="${MEMORY:-72G}"
+CPUS="${CPUS:-32}"
+HOST_CPU_NODE="${HOST_CPU_NODE:-0}"
+HOST_FAST_MEM_NODE="${HOST_FAST_MEM_NODE:-0}"
+HOST_SLOW_MEM_NODE="${HOST_SLOW_MEM_NODE:-2}"
+HOST_CPUS="${HOST_CPUS:-}"
+if [[ -z "${HOST_CPUS}" && -r "/sys/devices/system/node/node${HOST_CPU_NODE}/cpulist" ]]; then
+  HOST_CPUS="$(<"/sys/devices/system/node/node${HOST_CPU_NODE}/cpulist")"
+fi
+NUMA_NODE0_CPUS="${NUMA_NODE0_CPUS:-0-31}"
+NUMA_NODE0_MEM="${NUMA_NODE0_MEM:-24G}"
+NUMA_NODE1_MEM="${NUMA_NODE1_MEM:-48G}"
+NUMA_NODE0_HOST_NODES="${NUMA_NODE0_HOST_NODES:-${HOST_FAST_MEM_NODE}}"
+NUMA_NODE1_HOST_NODES="${NUMA_NODE1_HOST_NODES:-${HOST_SLOW_MEM_NODE}}"
+NUMA_MEM_POLICY="${NUMA_MEM_POLICY:-bind}"
+NUMA_PREALLOC="${NUMA_PREALLOC:-1}"
+CMDLINE="${CMDLINE:-console=ttyS0 root=/dev/vda2 rw loglevel=7 nokaslr}"
+USE_SUDO_QEMU="${USE_SUDO_QEMU:-auto}"
+INJECT_SSH_KEY="${INJECT_SSH_KEY:-1}"
+
+REMOTE_MB="/root/mbench"
+REMOTE_SCRIPT="/root/run_phase_candidate_microbench_guest.sh"
+REMOTE_OUTDIR="${REMOTE_OUTDIR:-/tmp/phase_candidate_microbench}"
+HOST_RUN_DIR="${OUTDIR}/${RUN_ID}"
+HOST_LOG="${HOST_RUN_DIR}/qemu-launch.log"
+
+log() {
+  printf '[phase-candidate-host] %s\n' "$*"
+}
+
+mkdir -p "${HOST_RUN_DIR}"
+
+if [[ ! -x "${MBENCH_BIN}" ]]; then
+  log "building mbench"
+  make -C "${REPO_ROOT}/Microbenchmark"
+fi
+
+if [[ ! -x "${MBENCH_BIN}" ]]; then
+  echo "mbench binary not executable: ${MBENCH_BIN}" >&2
+  exit 1
+fi
+
+if [[ ! -f "${ROOTFS_BASE}" ]]; then
+  echo "rootfs base not found: ${ROOTFS_BASE}" >&2
+  exit 1
+fi
+
+if [[ ! -x "${QEMU_IMG}" ]]; then
+  echo "qemu-img not executable: ${QEMU_IMG}" >&2
+  exit 1
+fi
+
+install -m 600 "${SSH_KEY}" "${SSH_KEY_RUNTIME}"
+
+SSH_OPTS=(
+  -o BatchMode=yes
+  -o StrictHostKeyChecking=no
+  -o UserKnownHostsFile=/dev/null
+  -o ConnectTimeout="${SSH_CONNECT_TIMEOUT}"
+  -i "${SSH_KEY_RUNTIME}"
+  -p "${SSH_PORT}"
+)
+
+ssh_run() {
+  ssh "${SSH_OPTS[@]}" "$@"
+}
+
+scp_run() {
+  scp -o BatchMode=yes \
+    -o StrictHostKeyChecking=no \
+    -o UserKnownHostsFile=/dev/null \
+    -o ConnectTimeout="${SSH_CONNECT_TIMEOUT}" \
+    -i "${SSH_KEY_RUNTIME}" \
+    -P "${SSH_PORT}" \
+    "$@"
+}
+
+cleanup() {
+  local rc=$?
+  if [[ -n "${QEMU_PID:-}" ]] && kill -0 "${QEMU_PID}" 2>/dev/null; then
+    kill -INT "${QEMU_PID}" 2>/dev/null || true
+    wait "${QEMU_PID}" 2>/dev/null || true
+  fi
+  return "${rc}"
+}
+trap cleanup EXIT
+
+create_overlay() {
+  if [[ -f "${ROOTFS_OVERLAY}" ]]; then
+    rm -f "${ROOTFS_OVERLAY}"
+  fi
+  log "creating overlay ${ROOTFS_OVERLAY}"
+  "${QEMU_IMG}" create -f qcow2 -F "${ROOTFS_BASE_FORMAT}" -b "${ROOTFS_BASE}" "${ROOTFS_OVERLAY}" >/dev/null
+}
+
+inject_ssh_key() {
+  local nbd=""
+  local candidate
+  local mount_dir
+  local pub_key
+  local ubuntu_ids
+
+  if [[ "${INJECT_SSH_KEY}" != "1" ]]; then
+    return 0
+  fi
+  if [[ ! -f "${SSH_PUB_KEY}" ]]; then
+    echo "ssh public key not found: ${SSH_PUB_KEY}" >&2
+    exit 1
+  fi
+
+  sudo -n modprobe nbd max_part=8
+  for candidate in /dev/nbd{0..15}; do
+    if [[ -b "${candidate}" && "$(cat "/sys/block/${candidate##*/}/size" 2>/dev/null || echo 1)" == "0" ]]; then
+      nbd="${candidate}"
+      break
+    fi
+  done
+  if [[ -z "${nbd}" ]]; then
+    echo "no free /dev/nbd device found for overlay key injection" >&2
+    exit 1
+  fi
+
+  mount_dir="$(mktemp -d "${TMPDIR:-/tmp}/phasecand-root.XXXXXX")"
+  pub_key="$(cat "${SSH_PUB_KEY}")"
+
+  cleanup_nbd() {
+    sudo -n umount "${mount_dir}" >/dev/null 2>&1 || true
+    sudo -n "${QEMU_NBD:-${REPO_ROOT}/qemu/build/qemu-nbd}" -d "${nbd}" >/dev/null 2>&1 || true
+    rmdir "${mount_dir}" >/dev/null 2>&1 || true
+  }
+
+  log "injecting SSH key into overlay via ${nbd}"
+  sudo -n "${QEMU_NBD:-${REPO_ROOT}/qemu/build/qemu-nbd}" -c "${nbd}" "${ROOTFS_OVERLAY}"
+  sudo -n partprobe "${nbd}" || true
+  sleep 1
+  sudo -n mount "${nbd}p2" "${mount_dir}"
+
+  sudo -n install -d -m 700 "${mount_dir}/root/.ssh"
+  if ! sudo -n grep -Fqx "${pub_key}" "${mount_dir}/root/.ssh/authorized_keys" 2>/dev/null; then
+    printf '%s\n' "${pub_key}" | sudo -n tee -a "${mount_dir}/root/.ssh/authorized_keys" >/dev/null
+  fi
+  sudo -n chmod 600 "${mount_dir}/root/.ssh/authorized_keys"
+  sudo -n chown -R 0:0 "${mount_dir}/root/.ssh"
+
+  sudo -n install -d -m 700 "${mount_dir}/home/ubuntu/.ssh"
+  if ! sudo -n grep -Fqx "${pub_key}" "${mount_dir}/home/ubuntu/.ssh/authorized_keys" 2>/dev/null; then
+    printf '%s\n' "${pub_key}" | sudo -n tee -a "${mount_dir}/home/ubuntu/.ssh/authorized_keys" >/dev/null
+  fi
+  sudo -n chmod 600 "${mount_dir}/home/ubuntu/.ssh/authorized_keys"
+  ubuntu_ids="$(awk -F: '$1 == "ubuntu" { print $3 ":" $4 }' "${mount_dir}/etc/passwd" 2>/dev/null || true)"
+  if [[ -n "${ubuntu_ids}" ]]; then
+    sudo -n chown -R "${ubuntu_ids}" "${mount_dir}/home/ubuntu/.ssh"
+  fi
+
+  cleanup_nbd
+}
+
+qemu_needs_sudo() {
+  if [[ "${USE_SUDO_QEMU}" == "1" ]]; then
+    return 0
+  fi
+  if [[ "${USE_SUDO_QEMU}" == "0" ]]; then
+    return 1
+  fi
+  if [[ -r /dev/kvm && -w /dev/kvm ]]; then
+    return 1
+  fi
+  command -v sudo >/dev/null 2>&1 && sudo -n true >/dev/null 2>&1
+}
+
+launch_guest() {
+  local launch_args=(
+    --rootfs "${ROOTFS_OVERLAY}"
+    --rootfs-format qcow2
+    --kernel-image "${KERNEL_IMAGE}"
+    --qemu-bin "${QEMU_BIN}"
+    --ssh-forward-port "${SSH_PORT}"
+    --memory "${MEMORY}"
+    --cpus "${CPUS}"
+    --numa-node0-cpus "${NUMA_NODE0_CPUS}"
+    --numa-node0-mem "${NUMA_NODE0_MEM}"
+    --numa-node1-mem "${NUMA_NODE1_MEM}"
+    --name "${VM_NAME}"
+    --cmdline "${CMDLINE}"
+  )
+
+  if [[ -n "${INITRD_IMAGE}" ]]; then
+    launch_args+=( --initrd "${INITRD_IMAGE}" )
+  fi
+  if [[ -n "${HOST_CPUS}" ]]; then
+    launch_args+=( --host-cpus "${HOST_CPUS}" )
+  fi
+  if [[ -n "${NUMA_NODE0_HOST_NODES}" ]]; then
+    launch_args+=( --numa-node0-host-nodes "${NUMA_NODE0_HOST_NODES}" )
+  fi
+  if [[ -n "${NUMA_NODE1_HOST_NODES}" ]]; then
+    launch_args+=( --numa-node1-host-nodes "${NUMA_NODE1_HOST_NODES}" )
+  fi
+  if [[ -n "${NUMA_NODE0_HOST_NODES}" || -n "${NUMA_NODE1_HOST_NODES}" ]]; then
+    launch_args+=( --numa-mem-policy "${NUMA_MEM_POLICY}" )
+  fi
+  if [[ "${NUMA_PREALLOC}" == "1" ]]; then
+    launch_args+=( --numa-prealloc )
+  fi
+
+  log "launching VM, log=${HOST_LOG}"
+  if qemu_needs_sudo; then
+    sudo -n "${LAUNCHER}" "${launch_args[@]}" > "${HOST_LOG}" 2>&1 &
+  else
+    "${LAUNCHER}" "${launch_args[@]}" > "${HOST_LOG}" 2>&1 &
+  fi
+  QEMU_PID=$!
+}
+
+wait_for_ssh() {
+  local deadline=$((SECONDS + SSH_WAIT_SEC))
+  local user
+
+  while (( SECONDS < deadline )); do
+    for user in ${SSH_USERS}; do
+      if ssh_run "${user}@127.0.0.1" "true" >/dev/null 2>&1; then
+        QEMU_SSH_USER="${user}"
+        log "guest SSH ready as ${QEMU_SSH_USER}"
+        return 0
+      fi
+    done
+    sleep 2
+  done
+
+  echo "timed out waiting for SSH on port ${SSH_PORT}" >&2
+  tail -n 80 "${HOST_LOG}" >&2 || true
+  return 1
+}
+
+remote_root_prefix() {
+  if [[ "${QEMU_SSH_USER}" == "root" ]]; then
+    echo ""
+  else
+    echo "sudo -n"
+  fi
+}
+
+stage_guest_files() {
+  local sudo_prefix
+  sudo_prefix="$(remote_root_prefix)"
+
+  log "copying mbench and guest runner"
+  scp_run "${MBENCH_BIN}" "${QEMU_SSH_USER}@127.0.0.1:/tmp/mbench"
+  scp_run "${GUEST_SCRIPT}" "${QEMU_SSH_USER}@127.0.0.1:/tmp/run_phase_candidate_microbench_guest.sh"
+
+  ssh_run "${QEMU_SSH_USER}@127.0.0.1" \
+    "${sudo_prefix} install -m 755 /tmp/mbench ${REMOTE_MB} && ${sudo_prefix} install -m 755 /tmp/run_phase_candidate_microbench_guest.sh ${REMOTE_SCRIPT} && ${sudo_prefix} ldd ${REMOTE_MB}"
+}
+
+run_guest_scan() {
+  local sudo_prefix remote_cmd
+  sudo_prefix="$(remote_root_prefix)"
+
+  remote_cmd="env"
+  for kv in \
+    "RUN_ID=${RUN_ID}" \
+    "OUTDIR=${REMOTE_OUTDIR}" \
+    "MBENCH=${REMOTE_MB}" \
+    "LOCAL_NODE=${LOCAL_NODE:-0}" \
+    "REMOTE_NODE=${REMOTE_NODE:-1}" \
+    "CPUSET_CPUS=${CPUSET_CPUS:-0-31}" \
+    "CPUSET_MEMS=${CPUSET_MEMS:-0,1}" \
