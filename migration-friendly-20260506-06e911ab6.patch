+#!/usr/bin/env bash
+set -euo pipefail
+
+# Run inside VM as root.
+# Creates two cgroups, enforces node0 capacity=8GiB for each, and runs two tenant commands concurrently.
+
+SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
+CGROOT="${CGROOT:-/sys/fs/cgroup}"
+CG_A="${CG_A:-tenantA}"
+CG_B="${CG_B:-tenantB}"
+CAPACITY_PAGES="${CAPACITY_PAGES:-2097152}"  # 8GiB / 4KiB
+CMD_1="${CMD_1:-/root/bc -g 26}"
+CMD_2="${CMD_2:-/root/pr -g 26}"
+NODE_BALANCING_MODE="${NODE_BALANCING_MODE:-0}"
+KSWAPD_DEMOTION_ENABLED="${KSWAPD_DEMOTION_ENABLED:-1}"
+DEMOTION_SRC_NODE="${DEMOTION_SRC_NODE:-0}"
+DEMOTION_DST_NODE="${DEMOTION_DST_NODE:-1}"
+CPU_NODE="${CPU_NODE:-0}"
+
+if [[ "${EUID}" -ne 0 ]]; then
+  echo "run as root (sudo)" >&2
+  exit 1
+fi
+
+if [[ ! -d "${CGROOT}" ]]; then
+  echo "cgroup root not found: ${CGROOT}" >&2
+  exit 1
+fi
+
+if [[ -f /sys/kernel/mm/numa/demotion_enabled ]]; then
+  echo true > /sys/kernel/mm/numa/demotion_enabled
+  echo "[info] numa demotion enabled"
+else
+  echo "[warn] /sys/kernel/mm/numa/demotion_enabled not found; skip demotion enable"
+fi
+
+if [[ -f /sys/kernel/mm/numa/demotion_target ]]; then
+  echo "${DEMOTION_SRC_NODE} ${DEMOTION_DST_NODE}" > /sys/kernel/mm/numa/demotion_target
+  echo "[info] manual demotion target: node${DEMOTION_SRC_NODE} -> node${DEMOTION_DST_NODE}"
+  while IFS= read -r line; do
+    echo "[info] demotion_target ${line}"
+  done < /sys/kernel/mm/numa/demotion_target
+else
+  echo "[warn] /sys/kernel/mm/numa/demotion_target not found; skip manual target setup"
+fi
+
+pick_knob_file() {
+  local cg="$1"
+  local name="$2"
+  local f
+  for f in "${cg}/${name}" "${cg}/memory.${name}"; do
+    if [[ -f "${f}" ]]; then
+      echo "${f}"
+      return 0
+    fi
+  done
+  return 1
+}
+
+write_knob() {
+  local cg="$1"
+  local name="$2"
+  local value="$3"
+  local f
+  f="$(pick_knob_file "${cg}" "${name}")" || return 1
+  echo "${value}" > "${f}"
+}
+
+read_cpuset_value() {
+  local path="$1"
+  if [[ -f "${path}.effective" ]]; then
+    cat "${path}.effective"
+  elif [[ -f "${path}" ]]; then
+    cat "${path}"
+  else
+    return 1
+  fi
+}
+
+if [[ -f "${CGROOT}/cgroup.controllers" ]]; then
+  if grep -qw memory "${CGROOT}/cgroup.controllers"; then
+    grep -qw memory "${CGROOT}/cgroup.subtree_control" || echo +memory > "${CGROOT}/cgroup.subtree_control" || true
+  fi
+  if grep -qw cpuset "${CGROOT}/cgroup.controllers"; then
+    grep -qw cpuset "${CGROOT}/cgroup.subtree_control" || echo +cpuset > "${CGROOT}/cgroup.subtree_control" || true
+  fi
+fi
+
+mkdir -p "${CGROOT}/${CG_A}" "${CGROOT}/${CG_B}"
+
+CPUSET_CPUS="$(cat "/sys/devices/system/node/node${CPU_NODE}/cpulist")"
+CPUSET_MEMS="$(read_cpuset_value "${CGROOT}/cpuset.mems")"
+
+if [[ -z "${CPUSET_CPUS}" || -z "${CPUSET_MEMS}" ]]; then
+  echo "failed: unable to resolve cpuset configuration" >&2
+  exit 1
+fi
+
+echo "${CPUSET_MEMS}" > "${CGROOT}/${CG_A}/cpuset.mems"
+echo "${CPUSET_MEMS}" > "${CGROOT}/${CG_B}/cpuset.mems"
+echo "${CPUSET_CPUS}" > "${CGROOT}/${CG_A}/cpuset.cpus"
+echo "${CPUSET_CPUS}" > "${CGROOT}/${CG_B}/cpuset.cpus"
+
+if ! write_knob "${CGROOT}/${CG_A}" "node_capacity" "0 ${CAPACITY_PAGES}"; then
+  echo "failed: node_capacity knob not found in ${CGROOT}/${CG_A}" >&2
+  exit 1
+fi
+if ! write_knob "${CGROOT}/${CG_B}" "node_capacity" "0 ${CAPACITY_PAGES}"; then
+  echo "failed: node_capacity knob not found in ${CGROOT}/${CG_B}" >&2
+  exit 1
+fi
+
+if ! write_knob "${CGROOT}/${CG_A}" "node_balancing" "${NODE_BALANCING_MODE}"; then
+  echo "failed: node_balancing knob not found in ${CGROOT}/${CG_A}" >&2
+  exit 1
+fi
+if ! write_knob "${CGROOT}/${CG_B}" "node_balancing" "${NODE_BALANCING_MODE}"; then
+  echo "failed: node_balancing knob not found in ${CGROOT}/${CG_B}" >&2
+  exit 1
+fi
+if ! write_knob "${CGROOT}/${CG_A}" "kswapd_demotion_enabled" "${KSWAPD_DEMOTION_ENABLED}"; then
+  echo "failed: kswapd_demotion_enabled knob not found in ${CGROOT}/${CG_A}" >&2
+  exit 1
+fi
+if ! write_knob "${CGROOT}/${CG_B}" "kswapd_demotion_enabled" "${KSWAPD_DEMOTION_ENABLED}"; then
+  echo "failed: kswapd_demotion_enabled knob not found in ${CGROOT}/${CG_B}" >&2
+  exit 1
+fi
+if ! write_knob "${CGROOT}/${CG_A}" "node_force_lru_evict" "0 1"; then
+  echo "failed: node_force_lru_evict knob not found in ${CGROOT}/${CG_A}" >&2
+  exit 1
+fi
+if ! write_knob "${CGROOT}/${CG_B}" "node_force_lru_evict" "0 1"; then
+  echo "failed: node_force_lru_evict knob not found in ${CGROOT}/${CG_B}" >&2
+  exit 1
+fi
+
+echo "[info] ${CG_A}: node0 capacity=${CAPACITY_PAGES} pages (8GiB), node_balancing=${NODE_BALANCING_MODE}, kswapd_demotion_enabled=${KSWAPD_DEMOTION_ENABLED}"
+echo "[info] ${CG_B}: node0 capacity=${CAPACITY_PAGES} pages (8GiB), node_balancing=${NODE_BALANCING_MODE}, kswapd_demotion_enabled=${KSWAPD_DEMOTION_ENABLED}"
+echo "[info] ${CG_A}/${CG_B}: cpuset.cpus=${CPUSET_CPUS} (node${CPU_NODE}), cpuset.mems=${CPUSET_MEMS}"
+
+CG_A_PROCS="${CGROOT}/${CG_A}/cgroup.procs"
+CG_B_PROCS="${CGROOT}/${CG_B}/cgroup.procs"
+
+bash -lc "echo \$$ > '${CG_A_PROCS}'; exec ${CMD_1}" > /tmp/${CG_A}.log 2>&1 &
+PID_A=$!
+bash -lc "echo \$$ > '${CG_B_PROCS}'; exec ${CMD_2}" > /tmp/${CG_B}.log 2>&1 &
+PID_B=$!
+
+echo "[run] tenantA pid=${PID_A}, tenantB pid=${PID_B}"
+echo "[log] /tmp/${CG_A}.log /tmp/${CG_B}.log"
+
+wait "${PID_A}"
+wait "${PID_B}"
+
+echo "[done] both tenants completed"
