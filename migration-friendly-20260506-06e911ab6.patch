+fi
+
+LOG_DIR="${SCRIPT_DIR}/qemu-logs"
+mkdir -p "${LOG_DIR}"
+STAMP="$(date +%Y%m%d_%H%M%S)"
+SERIAL_LOG="${LOG_DIR}/${VM_NAME}_${STAMP}.serial.log"
+QMP_SOCK="${LOG_DIR}/${VM_NAME}_${STAMP}.qmp.sock"
+
+if command -v ss >/dev/null 2>&1; then
+  if ss -ltn "( sport = :${SSH_FORWARD_PORT} )" 2>/dev/null | tail -n +2 | grep -q .; then
+    echo "Error: host port ${SSH_FORWARD_PORT} is already in use. Set --ssh-forward-port to another port." >&2
+    exit 1
+  fi
+fi
+
+QEMU_CMD=(
