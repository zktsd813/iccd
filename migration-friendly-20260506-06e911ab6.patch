+#!/usr/bin/env bash
+set -euo pipefail
+
+SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
+BASE_IMAGE="${BASE_IMAGE:-/Serverless/Migration-friendly/qemu/build/ubuntu.img}"
+OVERLAY_IMAGE="${OVERLAY_IMAGE:-${SCRIPT_DIR}/vm-images/adaptive-migration-base.qcow2}"
+QEMU_IMG_BIN="${QEMU_IMG_BIN:-/usr/local/bin/qemu-img}"
+FORCE="${FORCE:-0}"
+
+if [[ "${1:-}" == "--force" ]]; then
+  FORCE="1"
+fi
+
+if [[ ! -f "${BASE_IMAGE}" ]]; then
+  echo "base image not found: ${BASE_IMAGE}" >&2
+  exit 1
+fi
+
+if ! command -v "${QEMU_IMG_BIN}" >/dev/null 2>&1; then
+  echo "qemu-img not found: ${QEMU_IMG_BIN}" >&2
+  exit 1
+fi
+
+mkdir -p "$(dirname "${OVERLAY_IMAGE}")"
+
+if [[ -f "${OVERLAY_IMAGE}" && "${FORCE}" != "1" ]]; then
+  echo "overlay already exists: ${OVERLAY_IMAGE}"
+  exit 0
+fi
+
+if [[ -f "${OVERLAY_IMAGE}" ]]; then
+  rm -f "${OVERLAY_IMAGE}"
+fi
+
+"${QEMU_IMG_BIN}" create -f qcow2 -F raw -b "${BASE_IMAGE}" "${OVERLAY_IMAGE}" >/dev/null
+echo "created overlay: ${OVERLAY_IMAGE}"
diff --git a/scripts/kernel/readmem_probe.c b/scripts/kernel/readmem_probe.c
new file mode 100644
index 000000000..931259a20
--- /dev/null
+++ b/scripts/kernel/readmem_probe.c
@@ -0,0 +1,100 @@
+#define _GNU_SOURCE
+#define _POSIX_C_SOURCE 200809L
+
+#include <errno.h>
+#include <inttypes.h>
+#include <stdint.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+#include <sys/mman.h>
+#include <time.h>
+#include <unistd.h>
+
+static double monotonic_seconds(void)
+{
+	struct timespec ts;
+
+	if (clock_gettime(CLOCK_MONOTONIC, &ts) != 0) {
+		perror("clock_gettime");
+		exit(1);
+	}
+
+	return (double)ts.tv_sec + (double)ts.tv_nsec / 1e9;
+}
+
+static size_t parse_size(const char *s, const char *name)
+{
+	char *end = NULL;
+	unsigned long long v = strtoull(s, &end, 10);
+
+	if (!s[0] || (end && *end) || v == 0) {
+		fprintf(stderr, "invalid %s: %s\n", name, s);
+		exit(1);
+	}
+
+	return (size_t)v;
+}
+
+int main(int argc, char **argv)
+{
+	size_t size_mb = 2048;
+	size_t duration_sec = 30;
+	size_t stride_bytes = 64;
+	size_t page_size = (size_t)sysconf(_SC_PAGESIZE);
+	size_t size_bytes;
+	uint8_t *buf;
+	volatile uint64_t sum = 0;
+	double start, now;
+	size_t i;
+
+	for (i = 1; i < (size_t)argc; i++) {
+		if (!strcmp(argv[i], "--size-mb") && i + 1 < (size_t)argc) {
+			size_mb = parse_size(argv[++i], "size-mb");
+		} else if (!strcmp(argv[i], "--seconds") && i + 1 < (size_t)argc) {
+			duration_sec = parse_size(argv[++i], "seconds");
+		} else if (!strcmp(argv[i], "--stride") && i + 1 < (size_t)argc) {
+			stride_bytes = parse_size(argv[++i], "stride");
+		} else {
+			fprintf(stderr,
+				"usage: %s [--size-mb N] [--seconds N] [--stride BYTES]\n",
+				argv[0]);
+			return 1;
+		}
+	}
+
+	if (stride_bytes == 0) {
+		fprintf(stderr, "stride must be > 0\n");
+		return 1;
+	}
+
+	size_bytes = size_mb * 1024ULL * 1024ULL;
+	buf = mmap(NULL, size_bytes, PROT_READ | PROT_WRITE,
+		   MAP_PRIVATE | MAP_ANONYMOUS, -1, 0);
+	if (buf == MAP_FAILED) {
+		perror("mmap");
+		return 1;
+	}
+
+	/*
+	 * Materialize anonymous pages once so the timed loop can stay read-only.
+	 */
+	for (i = 0; i < size_bytes; i += page_size)
+		buf[i] = (uint8_t)(i / page_size);
+
+	start = monotonic_seconds();
+	do {
+		for (i = 0; i < size_bytes; i += stride_bytes)
+			sum += buf[i];
+		now = monotonic_seconds();
+	} while (now - start < (double)duration_sec);
+
+	printf("checksum=%" PRIu64 "\n", (uint64_t)sum);
+
+	if (munmap(buf, size_bytes) != 0) {
+		perror("munmap");
+		return 1;
+	}
+
+	return 0;
+}
diff --git a/scripts/kernel/render_memcg_numa_knob_report.py b/scripts/kernel/render_memcg_numa_knob_report.py
new file mode 100644
index 000000000..7960c0775
--- /dev/null
+++ b/scripts/kernel/render_memcg_numa_knob_report.py
@@ -0,0 +1,199 @@
+#!/usr/bin/env python3
+"""Render a readable markdown summary from memcg NUMA knob validation artifacts."""
+
+from __future__ import annotations
+
+import argparse
+import csv
+import pathlib
+import re
+
+
+def parse_args() -> argparse.Namespace:
+    parser = argparse.ArgumentParser()
+    parser.add_argument("--artifact-root", required=True)
+    parser.add_argument("--report", required=True)
+    parser.add_argument("--run-id", required=True)
+    parser.add_argument("--case", required=True)
+    parser.add_argument("--vm-name", required=True)
+    parser.add_argument("--memory", required=True)
+    parser.add_argument("--cpus", required=True)
+    parser.add_argument("--cmd-a", required=True)
+    parser.add_argument("--cmd-b", required=True)
+    parser.add_argument("--scan-scale-a", required=True)
+    parser.add_argument("--scan-scale-b", required=True)
+    parser.add_argument("--hot-threshold-a", required=True)
+    parser.add_argument("--hot-threshold-b", required=True)
+    parser.add_argument("--capacity-pages", required=True)
+    return parser.parse_args()
+
+
+def read_case_meta(path: pathlib.Path) -> dict[str, str]:
+    meta: dict[str, str] = {}
+    if not path.exists():
+        return meta
+    for raw in path.read_text(encoding="utf-8").splitlines():
+        if "=" not in raw:
+            continue
+        key, value = raw.split("=", 1)
+        meta[key.strip()] = value.strip()
+    return meta
+
+
+def read_summary(path: pathlib.Path) -> list[dict[str, str]]:
+    if not path.exists():
+        return []
+    with path.open("r", encoding="utf-8") as f:
+        return list(csv.DictReader(f))
+
+
+def read_vmstat_diff(path: pathlib.Path) -> list[tuple[str, str]]:
+    rows: list[tuple[str, str]] = []
+    if not path.exists():
+        return rows
+    for raw in path.read_text(encoding="utf-8").splitlines():
+        parts = raw.split(None, 1)
+        if len(parts) == 2:
+            rows.append((parts[0], parts[1]))
+    return rows
+
+
+def read_execution_time(path: pathlib.Path) -> str:
+    if not path.exists():
+        return "NA"
+    pattern = re.compile(r"execution time ([0-9.]+) \(s\)")
+    for raw in reversed(path.read_text(encoding="utf-8").splitlines()):
+        match = pattern.search(raw)
+        if match:
+            return match.group(1)
+    return "NA"
+
+
+def metric_value(rows: list[dict[str, str]], metric: str, side: str) -> int | None:
+    for row in rows:
+        if row.get("Metric") == metric:
+            try:
+                return int(float(row.get(side, "0")))
+            except ValueError:
+                return None
+    return None
+
+
+def case_observation(case_name: str, meta: dict[str, str], rows: list[dict[str, str]]) -> str:
+    hint_a = metric_value(rows, "MEMSTAT.numa_hint_faults", "A")
+    hint_b = metric_value(rows, "MEMSTAT.numa_hint_faults", "B")
+    promo_a = metric_value(rows, "MEMSTAT.pgpromote_success", "A")
+    promo_b = metric_value(rows, "MEMSTAT.pgpromote_success", "B")
+
+    if case_name == "scan-scale":
+        scale_a = meta.get("scan_period_scale_a", "A")
+        scale_b = meta.get("scan_period_scale_b", "B")
+        return (
+            f"`A` used scan scale `{scale_a}` and `B` used `{scale_b}`. "
+            f"Observed hint faults `{hint_a}` vs `{hint_b}` and promotions "
+            f"`{promo_a}` vs `{promo_b}`."
+        )
+
+    if case_name == "hot-threshold":
+        hot_a = meta.get("hot_threshold_ms_a", "A")
+        hot_b = meta.get("hot_threshold_ms_b", "B")
+        return (
+            f"`A` used hot-threshold `{hot_a}` and `B` used `{hot_b}`. "
+            f"Observed hint faults `{hint_a}` vs `{hint_b}` and promotions "
+            f"`{promo_a}` vs `{promo_b}`."
+        )
+
+    return "Case completed and emitted per-cgroup and vmstat summaries."
+
+
+def markdown_table(headers: list[str], rows: list[list[str]]) -> list[str]:
+    if not rows:
+        return []
+    out = [
+        "| " + " | ".join(headers) + " |",
+        "| " + " | ".join(["---"] * len(headers)) + " |",
+    ]
+    for row in rows:
+        out.append("| " + " | ".join(row) + " |")
+    return out
+
+
+def resolve_case_root(artifact_root: pathlib.Path) -> pathlib.Path:
+    nested = artifact_root / "memcg_numa_knob_validation"
+    return nested if nested.is_dir() else artifact_root
+
+
+def main() -> None:
+    args = parse_args()
+    artifact_root = pathlib.Path(args.artifact_root)
+    case_root = resolve_case_root(artifact_root)
+    report_path = pathlib.Path(args.report)
+    report_path.parent.mkdir(parents=True, exist_ok=True)
+
+    lines: list[str] = [
+        "# Memcg NUMA Knob Validation Report",
+        "",
+        f"- Run ID: `{args.run_id}`",
+        f"- Case selection: `{args.case}`",
+        f"- VM: `{args.vm_name}` (`{args.cpus}` vCPU, `{args.memory}` RAM)",
+        f"- Workload A: `{args.cmd_a}`",
+        f"- Workload B: `{args.cmd_b}`",
+        f"- Capacity pages: `{args.capacity_pages}`",
+        f"- Artifact root: `{artifact_root}`",
+        "",
+    ]
+
+    for case_dir in sorted(p for p in case_root.iterdir() if p.is_dir()):
+        meta = read_case_meta(case_dir / "case.meta")
+        summary = read_summary(case_dir / "summary.csv")
+        vmstat = read_vmstat_diff(case_dir / "vmstat.diff")
+        exec_a = read_execution_time(case_dir / "A.runner.txt")
+        exec_b = read_execution_time(case_dir / "B.runner.txt")
+
+        lines.extend(
+            [
+                f"## {case_dir.name}",
+                "",
+                "Configuration:",
+                f"- `A`: cpus `{meta.get('cpuset_a', 'NA')}`, scan scale `{meta.get('scan_period_scale_a', 'NA')}`, hot threshold `{meta.get('hot_threshold_ms_a', 'NA')}` ms",
+                f"- `B`: cpus `{meta.get('cpuset_b', 'NA')}`, scan scale `{meta.get('scan_period_scale_b', 'NA')}`, hot threshold `{meta.get('hot_threshold_ms_b', 'NA')}` ms",
+                f"- Commands: `A={meta.get('cmd_a', args.cmd_a)}`, `B={meta.get('cmd_b', args.cmd_b)}`",
+                "",
+                "Per-cgroup summary:",
+                "",
+            ]
+        )
+
+        summary_rows = [[row["Metric"], row["A"], row["B"]] for row in summary]
+        lines.extend(markdown_table(["Metric", "A", "B"], summary_rows))
+        lines.extend(
+            [
+                "",
+                "Selected global vmstat deltas:",
+                "",
+            ]
+        )
+        vm_rows = [[metric, value] for metric, value in vmstat]
+        lines.extend(markdown_table(["Metric", "Delta"], vm_rows))
+        lines.extend(
+            [
+                "",
+                "Runner timing:",
+                "",
+            ]
+        )
+        lines.extend(markdown_table(["Side", "execution_time_sec"], [["A", exec_a], ["B", exec_b]]))
+        lines.extend(
+            [
+                "",
+                "Observation:",
+                case_observation(case_dir.name, meta, summary),
+                "",
+            ]
+        )
+
+    report_path.write_text("\n".join(lines) + "\n", encoding="utf-8")
+
+
+if __name__ == "__main__":
+    main()
diff --git a/scripts/kernel/run_phase_candidate_microbench_guest.sh b/scripts/kernel/run_phase_candidate_microbench_guest.sh
new file mode 100755
index 000000000..02914d6cb
--- /dev/null
+++ b/scripts/kernel/run_phase_candidate_microbench_guest.sh
@@ -0,0 +1,1722 @@
+#!/usr/bin/env bash
+set -euo pipefail
+
+# Guest-side runner. Run as root inside the QEMU VM.
+# It compares short timeout-bounded mbench candidate patterns under
+# migration-off and migration-on memcg policies, while always collecting
+# cgroup/vmstat before/after counters.
+
+MBENCH="${MBENCH:-/root/mbench}"
+OUTDIR="${OUTDIR:-/tmp/phase_candidate_microbench}"
+RUN_ID="${RUN_ID:-$(date -u +%Y%m%dT%H%M%SZ)}"
+CGROOT="${CGROOT:-/sys/fs/cgroup}"
+CG_PREFIX="${CG_PREFIX:-phasecand}"
+
+LOCAL_NODE="${LOCAL_NODE:-0}"
+REMOTE_NODE="${REMOTE_NODE:-1}"
+CPUSET_CPUS="${CPUSET_CPUS:-0-31}"
+CPUSET_MEMS="${CPUSET_MEMS:-${LOCAL_NODE},${REMOTE_NODE}}"
+CAPACITY_PAGES="${CAPACITY_PAGES:-4194304}" # 16 GiB / 4 KiB
+THREADS="${THREADS:-32}"
+
+ARENA_SIZE="${ARENA_SIZE:-48G}"
+SAMPLE_MS="${SAMPLE_MS:-1000}"
+OPS_PER_PASS="${OPS_PER_PASS:-65536}"
+PAUSE_NS="${PAUSE_NS:-100000}"
+TIMEOUT_SEC="${TIMEOUT_SEC:-720}"
+REPS="${REPS:-1}"
+POLICIES="${POLICIES:-off,on}"
+CANDIDATES="${CANDIDATES:-phase_tail_hotset_sparse24}"
+
+NODE_BALANCING_ON="${NODE_BALANCING_ON:-2}"
+KSWAPD_DEMOTION_ON="${KSWAPD_DEMOTION_ON:-1}"
+OFF_DEMOTION_ON="${OFF_DEMOTION_ON:-0}"
+GLOBAL_NUMA_ON="${GLOBAL_NUMA_ON:-2}"
+NUMA_SCAN_SIZE_MB="${NUMA_SCAN_SIZE_MB:-}"
+SCAN_PERIOD_SCALE="${SCAN_PERIOD_SCALE:-1}"
+HOT_THRESHOLD_MS="${HOT_THRESHOLD_MS:-1}"
+REMOTE_FIRSTTOUCH_SEC="${REMOTE_FIRSTTOUCH_SEC:-8}"
+PHASE_MS="${PHASE_MS:-60000}"
+PHASE_REPEAT="${PHASE_REPEAT:-5}"
+LIVE_SAMPLE_SEC="${LIVE_SAMPLE_SEC:-5}"
+PHASE_CONTROLLER_DELAY_SEC="${PHASE_CONTROLLER_DELAY_SEC:-0}"
+CANDIDATE_PHASE_FIRST_KIND="${CANDIDATE_PHASE_FIRST_KIND:-friendly}"
+MBENCH_FORCE_DURATION_MS="${MBENCH_FORCE_DURATION_MS:-}"
+PREFAULT_PHASE_GATE="${PREFAULT_PHASE_GATE:-0}"
+PREFAULT_READY_TIMEOUT_SEC="${PREFAULT_READY_TIMEOUT_SEC:-240}"
+PREFAULT_SETTLE_RECLAIMD="${PREFAULT_SETTLE_RECLAIMD:-1}"
+PREFAULT_SETTLE_TIMEOUT_SEC="${PREFAULT_SETTLE_TIMEOUT_SEC:-120}"
+PREFAULT_SETTLE_QUIET_SEC="${PREFAULT_SETTLE_QUIET_SEC:-1}"
+
+log() {
+  printf '[phase-candidate-guest] %s\n' "$*"
+}
+
+if [[ "${EUID}" -ne 0 ]]; then
+  echo "run as root" >&2
+  exit 1
+fi
+
+if [[ ! -x "${MBENCH}" ]]; then
+  echo "mbench binary not executable: ${MBENCH}" >&2
+  exit 1
+fi
+
+RUN_ROOT="${OUTDIR}/${RUN_ID}"
+mkdir -p "${RUN_ROOT}"
+
+ORIG_NUMA_BALANCING=""
+ORIG_DEMOTION_ENABLED=""
+ORIG_DEMOTION_TARGET=""
+ORIG_NUMA_SCAN_SIZE_MB=""
+
+read_optional() {
+  local path="$1"
+  if [[ -f "${path}" ]]; then
+    cat "${path}"
+  fi
+}
+
+write_optional() {
+  local path="$1"
+  local value="$2"
+  if [[ -w "${path}" ]]; then
+    echo "${value}" > "${path}" || true
+  fi
+}
+
+save_original_globals() {
+  ORIG_NUMA_BALANCING="$(read_optional /proc/sys/kernel/numa_balancing || true)"
+  ORIG_DEMOTION_ENABLED="$(read_optional /sys/kernel/mm/numa/demotion_enabled || true)"
+  ORIG_DEMOTION_TARGET="$(read_optional /sys/kernel/mm/numa/demotion_target || true)"
+  mountpoint -q /sys/kernel/debug || mount -t debugfs none /sys/kernel/debug 2>/dev/null || true
+  ORIG_NUMA_SCAN_SIZE_MB="$(read_optional /sys/kernel/debug/sched/numa_balancing/scan_size_mb || true)"
+}
+
+restore_globals() {
+  if [[ -n "${ORIG_NUMA_BALANCING}" ]]; then
+    write_optional /proc/sys/kernel/numa_balancing "${ORIG_NUMA_BALANCING}"
+  fi
+  if [[ -n "${ORIG_DEMOTION_ENABLED}" ]]; then
+    write_optional /sys/kernel/mm/numa/demotion_enabled "${ORIG_DEMOTION_ENABLED}"
+  fi
+  if [[ -n "${ORIG_DEMOTION_TARGET}" ]]; then
+    write_optional /sys/kernel/mm/numa/demotion_target "${ORIG_DEMOTION_TARGET%%$'\n'*}"
+  fi
+  if [[ -n "${ORIG_NUMA_SCAN_SIZE_MB}" ]]; then
+    write_optional /sys/kernel/debug/sched/numa_balancing/scan_size_mb "${ORIG_NUMA_SCAN_SIZE_MB}"
+  fi
+}
+
+trap restore_globals EXIT
+save_original_globals
+
+if [[ -n "${NUMA_SCAN_SIZE_MB}" ]]; then
+  mountpoint -q /sys/kernel/debug || mount -t debugfs none /sys/kernel/debug 2>/dev/null || true
+  write_optional /sys/kernel/debug/sched/numa_balancing/scan_size_mb "${NUMA_SCAN_SIZE_MB}"
+fi
