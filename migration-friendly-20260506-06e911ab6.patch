+ROOTFS_FORMAT="qcow2"
+KERNEL_DIR="${REPO_ROOT}"
+KERNEL_IMAGE=""
+ROOT_DEVICE="/dev/vda2"
+DRIVE_IF="virtio"
+LOCAL_DRAM="32G"
+REMOTE_MEM="128G"
+HOST_CPU_NODE="0"
+HOST_FAST_MEM_NODE="0"
+HOST_SLOW_MEM_NODE="2"
+VM_NAME="paper-vm"
+QEMU_BIN="${QEMU_TREE_DEFAULT}/build/qemu-system-x86_64"
+CMDLINE=""
+DAEMONIZE="0"
+DRY_RUN="0"
