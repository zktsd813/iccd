+  run_case "${bench}" "off" "${GLOBAL_NUMA_BALANCING_OFF}" "${NODE_BALANCING_OFF}" "${MODE_2}" "${cmd}"
+  run_case "${bench}" "on" "${GLOBAL_NUMA_BALANCING_ON}" "${NODE_BALANCING_ON}" "${MODE_1}" "${cmd}"
+  run_case "${bench}" "on" "${GLOBAL_NUMA_BALANCING_ON}" "${NODE_BALANCING_ON}" "${MODE_2}" "${cmd}"
+done
