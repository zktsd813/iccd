+int mbench_parse_size_bytes(const char *value, size_t *out_bytes)
+{
+    if (!value || !out_bytes) {
+        return -EINVAL;
+    }
+
+    unsigned long long parsed = 0;
+    int rc = parse_unsigned_suffix(value, &parsed);
+    if (rc != 0) {
+        return rc;
+    }
+    if (parsed > SIZE_MAX) {
+        return -ERANGE;
+    }
+
+    *out_bytes = (size_t)parsed;
+    return 0;
+}
