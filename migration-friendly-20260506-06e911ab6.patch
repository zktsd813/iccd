+#!/usr/bin/env bash
+set -euo pipefail
+
+# Run inside VM as root.
+# Creates two cgroups, enforces node0 capacity=8GiB for each, and runs two tenant commands concurrently.
+# The only intentional difference from run_two_tenant_node_capacity_test.sh is
+# that each tenant gets its own node_balancing mode.
+
+SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
+CGROOT="${CGROOT:-/sys/fs/cgroup}"
+CG_A="${CG_A:-tenantA}"
+CG_B="${CG_B:-tenantB}"
+CAPACITY_PAGES="${CAPACITY_PAGES:-2097152}"  # 8GiB / 4KiB
+CMD_1="${CMD_1:-/root/bc -g 26}"
+CMD_2="${CMD_2:-/root/pr -g 26}"
+NODE_BALANCING_MODE_A="${NODE_BALANCING_MODE_A:-2}"
+NODE_BALANCING_MODE_B="${NODE_BALANCING_MODE_B:-0}"
+KSWAPD_DEMOTION_ENABLED="${KSWAPD_DEMOTION_ENABLED:-1}"
+DEMOTION_SRC_NODE="${DEMOTION_SRC_NODE:-0}"
+DEMOTION_DST_NODE="${DEMOTION_DST_NODE:-1}"
+CPU_NODE="${CPU_NODE:-0}"
+
+if [[ "${EUID}" -ne 0 ]]; then
+  echo "run as root (sudo)" >&2
+  exit 1
+fi
+
+if [[ ! -d "${CGROOT}" ]]; then
+  echo "cgroup root not found: ${CGROOT}" >&2
+  exit 1
+fi
+
+expand_cpulist() {
+  local list="$1"
+  local part start end cpu
+  local -a parts
+
+  IFS=',' read -r -a parts <<< "${list}"
+  for part in "${parts[@]}"; do
+    if [[ "${part}" == *-* ]]; then
+      start="${part%-*}"
+      end="${part#*-}"
+      for ((cpu = start; cpu <= end; cpu++)); do
+        echo "${cpu}"
+      done
+    else
+      echo "${part}"
+    fi
+  done
+}
+
+build_fair_node_cpu_sets() {
+  local node="$1"
+  local cpulist_path="/sys/devices/system/node/node${node}/cpulist"
+  local cpulist
+  local cpu
+  local package
+  local core
+  local key
+  local total
+  local half
+  local dropped_cpu
+  local -a physical_cpus=()
+  local -A seen_cores=()
+  declare -g CPUSET_A CPUSET_B
+
+  if [[ ! -f "${cpulist_path}" ]]; then
+    echo "node${node} cpulist not found: ${cpulist_path}" >&2
+    exit 1
+  fi
+
+  cpulist="$(<"${cpulist_path}")"
+  while IFS= read -r cpu; do
+    [[ -z "${cpu}" ]] && continue
+    package="$(<"/sys/devices/system/cpu/cpu${cpu}/topology/physical_package_id")"
+    core="$(<"/sys/devices/system/cpu/cpu${cpu}/topology/core_id")"
+    key="${package}:${core}"
+    if [[ -n "${seen_cores[$key]:-}" ]]; then
+      continue
+    fi
+    seen_cores["$key"]="${cpu}"
+    physical_cpus+=("${cpu}")
+  done < <(expand_cpulist "${cpulist}")
+
+  total="${#physical_cpus[@]}"
+  if (( total < 2 )); then
+    echo "need at least two physical CPUs on node${node}, found ${total}" >&2
+    exit 1
+  fi
+
+  if (( total % 2 == 1 )); then
+    dropped_cpu="${physical_cpus[$((total - 1))]}"
+    physical_cpus=("${physical_cpus[@]:0:$((total - 1))}")
+    total="${#physical_cpus[@]}"
+    echo "[warn] node${node} has odd physical CPU count; dropping cpu${dropped_cpu} to split evenly"
+  fi
+
+  half=$(( total / 2 ))
+  CPUSET_A="$(IFS=,; echo "${physical_cpus[*]:0:half}")"
+  CPUSET_B="$(IFS=,; echo "${physical_cpus[*]:half:half}")"
+}
+
+if [[ -f /sys/kernel/mm/numa/demotion_enabled ]]; then
+  echo true > /sys/kernel/mm/numa/demotion_enabled
+  echo "[info] numa demotion enabled"
+else
+  echo "[warn] /sys/kernel/mm/numa/demotion_enabled not found; skip demotion enable"
+fi
+
+if [[ -f /sys/kernel/mm/numa/demotion_target ]]; then
+  echo "${DEMOTION_SRC_NODE} ${DEMOTION_DST_NODE}" > /sys/kernel/mm/numa/demotion_target
+  echo "[info] manual demotion target: node${DEMOTION_SRC_NODE} -> node${DEMOTION_DST_NODE}"
+  while IFS= read -r line; do
+    echo "[info] demotion_target ${line}"
+  done < /sys/kernel/mm/numa/demotion_target
+else
+  echo "[warn] /sys/kernel/mm/numa/demotion_target not found; skip manual target setup"
+fi
+
+pick_knob_file() {
+  local cg="$1"
+  local name="$2"
+  local f
+  for f in "${cg}/${name}" "${cg}/memory.${name}"; do
+    if [[ -f "${f}" ]]; then
+      echo "${f}"
+      return 0
+    fi
+  done
+  return 1
+}
+
+write_knob() {
+  local cg="$1"
+  local name="$2"
+  local value="$3"
+  local f
+  f="$(pick_knob_file "${cg}" "${name}")" || return 1
+  echo "${value}" > "${f}"
+}
+
+read_cpuset_value() {
+  local path="$1"
+  if [[ -f "${path}.effective" ]]; then
+    cat "${path}.effective"
+  elif [[ -f "${path}" ]]; then
+    cat "${path}"
+  else
+    return 1
+  fi
+}
+
+snapshot_cgroup_stats() {
+  local cg="$1"
+  local out="$2"
+
+  python3 - "$cg" > "${out}" <<'PY'
+import os
+import sys
+
+cg = sys.argv[1]
+
+def pick(name):
+    for path in (os.path.join(cg, name), os.path.join(cg, f"memory.{name}")):
+        if os.path.isfile(path):
+            return path
+    return None
+
+def parse_numa(path):
+    stats = {}
+    if not path:
+        return stats
+    with open(path, "r", encoding="utf-8") as f:
+        for raw in f:
+            parts = raw.strip().split()
+            if not parts:
+                continue
+            key = parts[0]
+            nodes = {}
+            for tok in parts[1:]:
+                if "=" not in tok or not tok.startswith("N"):
+                    continue
+                n, v = tok.split("=", 1)
+                try:
+                    nodes[int(n[1:])] = int(v)
+                except ValueError:
+                    pass
+            stats[key] = nodes
+    return stats
+
+def parse_kv(path):
+    data = {}
+    if not path:
+        return data
+    with open(path, "r", encoding="utf-8") as f:
+        for raw in f:
+            parts = raw.strip().split(None, 1)
+            if len(parts) == 2:
+                data[parts[0]] = parts[1]
+    return data
+
+def parse_stat(path):
+    data = {}
+    if not path:
+        return data
+    with open(path, "r", encoding="utf-8") as f:
+        for raw in f:
+            parts = raw.strip().split()
+            if len(parts) == 2:
+                try:
+                    data[parts[0]] = int(parts[1])
+                except ValueError:
+                    pass
+    return data
+
+numa_stats = parse_numa(pick("numa_stat"))
+mem_stats = parse_stat(pick("stat"))
+reclaimd = parse_kv(pick("reclaimd_state"))
+migrate = parse_kv(pick("numa_migrate_state"))
+
+numa_bytes_keys = ("anon", "active_anon", "inactive_anon", "unevictable")
+numa_pages_keys = ("pgdemote_kswapd", "pgpromote_success")
+
+for key in numa_bytes_keys:
+    for nid, value in sorted(numa_stats.get(key, {}).items()):
+        print(f"NUMA_BYTES.{key}.N{nid} {value}")
+
+for key in numa_pages_keys:
+    for nid, value in sorted(numa_stats.get(key, {}).items()):
+        print(f"NUMA_PAGES.{key}.N{nid} {value}")
+
+for key in ("numa_hint_faults", "numa_page_migrate", "pgdemote_kswapd", "pgpromote_success"):
+    print(f"MEMSTAT.{key} {mem_stats.get(key, 0)}")
+
+for key in ("wake_count", "run_count"):
+    try:
+        value = int(reclaimd.get(key, "0"))
+    except ValueError:
+        value = 0
+    print(f"RECLAIMD.{key} {value}")
+
+for key in ("numa_migrate_success_total", "numa_migrate_success_promotion", "numa_migrate_success_other"):
+    try:
+        value = int(migrate.get(key, "0"))
+    except ValueError:
+        value = 0
+    print(f"MIGRATE.{key} {value}")
+PY
+}
+
+write_cgroup_stat_diff() {
+  local cg_name="$1"
+  local before="$2"
+  local after="$3"
+  local out="$4"
+
+  python3 - "$cg_name" "$before" "$after" > "${out}" <<'PY'
+import os
+import sys
+
+cg_name, before_path, after_path = sys.argv[1:4]
+PAGE_SIZE = os.sysconf("SC_PAGE_SIZE")
+
+def load(path):
+    data = {}
+    with open(path, "r", encoding="utf-8") as f:
+        for raw in f:
+            parts = raw.strip().split(None, 1)
+            if len(parts) == 2:
+                try:
+                    data[parts[0]] = int(parts[1])
+                except ValueError:
+                    pass
+    return data
+
+before = load(before_path)
+after = load(after_path)
+keys = sorted(set(before) | set(after))
+
+print(f"cgroup={cg_name}")
+for key in keys:
+    b = before.get(key, 0)
+    a = after.get(key, 0)
+    d = a - b
+    if key.startswith("NUMA_BYTES."):
+        print(f"{key}: before={b / (1024*1024):.1f} MiB after={a / (1024*1024):.1f} MiB delta={d / (1024*1024):+.1f} MiB")
+    elif key.startswith("NUMA_PAGES."):
+        print(f"{key}: before={b}p after={a}p delta={d:+}p ({(d * PAGE_SIZE) / (1024*1024):+.1f} MiB)")
+    else:
+        print(f"{key}: before={b} after={a} delta={d:+}")
+PY
+}
+
+if [[ -f "${CGROOT}/cgroup.controllers" ]]; then
+  if grep -qw memory "${CGROOT}/cgroup.controllers"; then
+    grep -qw memory "${CGROOT}/cgroup.subtree_control" || echo +memory > "${CGROOT}/cgroup.subtree_control" || true
+  fi
+  if grep -qw cpuset "${CGROOT}/cgroup.controllers"; then
+    grep -qw cpuset "${CGROOT}/cgroup.subtree_control" || echo +cpuset > "${CGROOT}/cgroup.subtree_control" || true
+  fi
+fi
+
+build_fair_node_cpu_sets "${CPU_NODE}"
+
+mkdir -p "${CGROOT}/${CG_A}" "${CGROOT}/${CG_B}"
+
+CPUSET_MEMS="$(read_cpuset_value "${CGROOT}/cpuset.mems")"
+if [[ -z "${CPUSET_MEMS}" ]]; then
+  echo "failed: unable to resolve root cpuset.mems" >&2
+  exit 1
+fi
+
+echo "${CPUSET_MEMS}" > "${CGROOT}/${CG_A}/cpuset.mems"
+echo "${CPUSET_MEMS}" > "${CGROOT}/${CG_B}/cpuset.mems"
+echo "${CPUSET_A}" > "${CGROOT}/${CG_A}/cpuset.cpus"
+echo "${CPUSET_B}" > "${CGROOT}/${CG_B}/cpuset.cpus"
+
+if ! write_knob "${CGROOT}/${CG_A}" "node_capacity" "0 ${CAPACITY_PAGES}"; then
+  echo "failed: node_capacity knob not found in ${CGROOT}/${CG_A}" >&2
+  exit 1
+fi
+if ! write_knob "${CGROOT}/${CG_B}" "node_capacity" "0 ${CAPACITY_PAGES}"; then
+  echo "failed: node_capacity knob not found in ${CGROOT}/${CG_B}" >&2
+  exit 1
+fi
+
+if ! write_knob "${CGROOT}/${CG_A}" "node_balancing" "${NODE_BALANCING_MODE_A}"; then
+  echo "failed: node_balancing knob not found in ${CGROOT}/${CG_A}" >&2
+  exit 1
+fi
+if ! write_knob "${CGROOT}/${CG_B}" "node_balancing" "${NODE_BALANCING_MODE_B}"; then
+  echo "failed: node_balancing knob not found in ${CGROOT}/${CG_B}" >&2
+  exit 1
+fi
+if ! write_knob "${CGROOT}/${CG_A}" "kswapd_demotion_enabled" "${KSWAPD_DEMOTION_ENABLED}"; then
+  echo "failed: kswapd_demotion_enabled knob not found in ${CGROOT}/${CG_A}" >&2
+  exit 1
+fi
+if ! write_knob "${CGROOT}/${CG_B}" "kswapd_demotion_enabled" "${KSWAPD_DEMOTION_ENABLED}"; then
+  echo "failed: kswapd_demotion_enabled knob not found in ${CGROOT}/${CG_B}" >&2
+  exit 1
+fi
+if ! write_knob "${CGROOT}/${CG_A}" "node_force_lru_evict" "0 1"; then
+  echo "failed: node_force_lru_evict knob not found in ${CGROOT}/${CG_A}" >&2
+  exit 1
+fi
+if ! write_knob "${CGROOT}/${CG_B}" "node_force_lru_evict" "0 1"; then
+  echo "failed: node_force_lru_evict knob not found in ${CGROOT}/${CG_B}" >&2
+  exit 1
+fi
+
+echo "[info] ${CG_A}: node0 capacity=${CAPACITY_PAGES} pages (8GiB), node_balancing=${NODE_BALANCING_MODE_A}, kswapd_demotion_enabled=${KSWAPD_DEMOTION_ENABLED}"
+echo "[info] ${CG_B}: node0 capacity=${CAPACITY_PAGES} pages (8GiB), node_balancing=${NODE_BALANCING_MODE_B}, kswapd_demotion_enabled=${KSWAPD_DEMOTION_ENABLED}"
+echo "[info] cpu placement on node${CPU_NODE}: ${CG_A} cpus=${CPUSET_A}, ${CG_B} cpus=${CPUSET_B}, mems=${CPUSET_MEMS}"
+
+CG_A_PROCS="${CGROOT}/${CG_A}/cgroup.procs"
+CG_B_PROCS="${CGROOT}/${CG_B}/cgroup.procs"
+CG_A_STAT_BEFORE="/tmp/${CG_A}.stats.before"
+CG_A_STAT_AFTER="/tmp/${CG_A}.stats.after"
+CG_A_STAT_DIFF="/tmp/${CG_A}.stats.diff"
+CG_B_STAT_BEFORE="/tmp/${CG_B}.stats.before"
+CG_B_STAT_AFTER="/tmp/${CG_B}.stats.after"
+CG_B_STAT_DIFF="/tmp/${CG_B}.stats.diff"
+
+snapshot_cgroup_stats "${CGROOT}/${CG_A}" "${CG_A_STAT_BEFORE}"
+snapshot_cgroup_stats "${CGROOT}/${CG_B}" "${CG_B_STAT_BEFORE}"
+
+bash -lc "echo \$$ > '${CG_A_PROCS}'; exec ${CMD_1}" > /tmp/${CG_A}.log 2>&1 &
+PID_A=$!
+bash -lc "echo \$$ > '${CG_B_PROCS}'; exec ${CMD_2}" > /tmp/${CG_B}.log 2>&1 &
+PID_B=$!
+
+echo "[run] tenantA pid=${PID_A}, tenantB pid=${PID_B}"
+echo "[log] /tmp/${CG_A}.log /tmp/${CG_B}.log"
+
+wait "${PID_A}"
+wait "${PID_B}"
+
+snapshot_cgroup_stats "${CGROOT}/${CG_A}" "${CG_A_STAT_AFTER}"
+snapshot_cgroup_stats "${CGROOT}/${CG_B}" "${CG_B_STAT_AFTER}"
+write_cgroup_stat_diff "${CG_A}" "${CG_A_STAT_BEFORE}" "${CG_A_STAT_AFTER}" "${CG_A_STAT_DIFF}"
+write_cgroup_stat_diff "${CG_B}" "${CG_B_STAT_BEFORE}" "${CG_B_STAT_AFTER}" "${CG_B_STAT_DIFF}"
+
+echo "[stats] ${CG_A}: ${CG_A_STAT_DIFF}"
+echo "[stats] ${CG_B}: ${CG_B_STAT_DIFF}"
+echo "[done] both tenants completed"
