@@ -0,0 +1,284 @@
+#!/usr/bin/env bash
+set -euo pipefail
+
+# Run inside VM as root.
+# Creates one cgroup, enforces node0 capacity=8GiB, and runs one tenant command.
+
+SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
+CGROOT="${CGROOT:-/sys/fs/cgroup}"
+CG_NAME="${CG_NAME:-tenantA}"
+CAPACITY_PAGES="${CAPACITY_PAGES:-2097152}"  # 8GiB / 4KiB
+CMD="${CMD:-/root/bc -g 27}"
+NODE_BALANCING_MODE="${NODE_BALANCING_MODE:-0}"
+KSWAPD_DEMOTION_ENABLED="${KSWAPD_DEMOTION_ENABLED:-1}"
+GLOBAL_NUMA_BALANCING="${GLOBAL_NUMA_BALANCING:-}"
+DEMOTION_SRC_NODE="${DEMOTION_SRC_NODE:-0}"
+DEMOTION_DST_NODE="${DEMOTION_DST_NODE:-1}"
+OUTDIR="${OUTDIR:-/tmp/${CG_NAME}_stats}"
+
+if [[ "${EUID}" -ne 0 ]]; then
+  echo "run as root (sudo)" >&2
+  exit 1
+fi
+
+if [[ ! -d "${CGROOT}" ]]; then
+  echo "cgroup root not found: ${CGROOT}" >&2
+  exit 1
+fi
+
+if [[ -f /sys/kernel/mm/numa/demotion_enabled ]]; then
+  echo true > /sys/kernel/mm/numa/demotion_enabled
+  echo "[info] numa demotion enabled"
+else
+  echo "[warn] /sys/kernel/mm/numa/demotion_enabled not found; skip demotion enable"
+fi
+
+if [[ -f /sys/kernel/mm/numa/demotion_target ]]; then
+  echo "${DEMOTION_SRC_NODE} ${DEMOTION_DST_NODE}" > /sys/kernel/mm/numa/demotion_target
+  echo "[info] manual demotion target: node${DEMOTION_SRC_NODE} -> node${DEMOTION_DST_NODE}"
+  while IFS= read -r line; do
+    echo "[info] demotion_target ${line}"
+  done < /sys/kernel/mm/numa/demotion_target
+else
+  echo "[warn] /sys/kernel/mm/numa/demotion_target not found; skip manual target setup"
+fi
+
+pick_knob_file() {
+  local cg="$1"
+  local name="$2"
+  local f
+
+  for f in "${cg}/${name}" "${cg}/memory.${name}"; do
+    if [[ -f "${f}" ]]; then
+      echo "${f}"
+      return 0
+    fi
+  done
+
+  return 1
+}
+
+write_knob() {
+  local cg="$1"
+  local name="$2"
+  local value="$3"
+  local f
+
+  f="$(pick_knob_file "${cg}" "${name}")" || return 1
+  echo "${value}" > "${f}"
+}
+
+snapshot_cgroup_stats() {
+  local cg="$1"
+  local out="$2"
+
+  python3 - "$cg" > "${out}" <<'PY'
+import os
+import sys
+
+cg = sys.argv[1]
+
+def pick(name):
+    for path in (os.path.join(cg, name), os.path.join(cg, f"memory.{name}")):
+        if os.path.isfile(path):
+            return path
+    return None
+
+def parse_stat(path):
+    data = {}
+    if not path:
+        return data
+    with open(path, "r", encoding="utf-8") as f:
+        for raw in f:
+            parts = raw.strip().split()
+            if len(parts) != 2:
+                continue
+            key, value = parts
+            try:
+                data[key] = int(value)
+            except ValueError:
+                pass
+    return data
+
+def parse_kv(path):
+    data = {}
+    if not path:
+        return data
+    with open(path, "r", encoding="utf-8") as f:
+        for raw in f:
+            parts = raw.strip().split(None, 1)
+            if len(parts) == 2:
+                data[parts[0]] = parts[1]
+    return data
+
+stat = parse_stat(pick("stat"))
+reclaimd = parse_kv(pick("reclaimd_state"))
+migrate = parse_kv(pick("numa_migrate_state"))
+
+for key in (
+    "numa_hint_faults",
+    "numa_page_migrate",
+    "pgdemote_kswapd",
+    "pgpromote_success",
+):
+    print(f"MEMSTAT.{key} {stat.get(key, 0)}")
+
+for key in ("wake_count", "run_count"):
+    print(f"RECLAIMD.{key} {int(reclaimd.get(key, '0'))}")
+
+for key in (
+    "numa_migrate_success_total",
+    "numa_migrate_success_promotion",
+    "numa_migrate_success_other",
+):
+    print(f"MIGRATE.{key} {int(migrate.get(key, '0'))}")
+PY
+}
+
+snapshot_vmstat() {
+  local out="$1"
+  python3 > "${out}" <<'PY'
+keys = {
+    "numa_miss",
+    "numa_other",
+    "numa_hint_faults",
+    "numa_hint_faults_local",
+    "numa_pages_migrated",
+    "pgdemote_kswapd",
+    "pgscan_direct",
+    "pgscan_kswapd",
+    "pgpromote_candidate",
+    "pgpromote_candidate_nrl",
+    "pgpromote_success",
+    "pgsteal_direct",
+    "pgsteal_kswapd",
+}
+
+with open("/proc/vmstat", "r", encoding="utf-8") as f:
+    for raw in f:
+        parts = raw.split()
+        if len(parts) == 2 and parts[0] in keys:
+            print(f"{parts[0]} {parts[1]}")
+PY
+}
+
+write_diff() {
+  local before="$1"
+  local after="$2"
+  local out="$3"
+
+  python3 - "$before" "$after" > "${out}" <<'PY'
+import sys
+
+def load(path):
+    data = {}
+    with open(path, "r", encoding="utf-8") as f:
+        for raw in f:
+            parts = raw.strip().split(None, 1)
+            if len(parts) != 2:
+                continue
+            try:
+                data[parts[0]] = int(parts[1])
+            except ValueError:
+                pass
+    return data
+
+before = load(sys.argv[1])
+after = load(sys.argv[2])
+for key in sorted(set(before) | set(after)):
+    print(f"{key} {after.get(key, 0) - before.get(key, 0)}")
+PY
+}
+
+reset_cgroup_dir() {
+  local cg="$1"
+  local root_procs="${CGROOT}/cgroup.procs"
+  local cg_procs="${cg}/cgroup.procs"
+  local pid
+
+  if [[ ! -d "${cg}" ]]; then
+    return 0
+  fi
+
+  if [[ -f "${cg_procs}" && -f "${root_procs}" ]]; then
+    while IFS= read -r pid; do
+      [[ -n "${pid}" ]] || continue
+      echo "${pid}" > "${root_procs}" || true
+    done < "${cg_procs}"
+  fi
+
+  rmdir "${cg}" 2>/dev/null || true
+}
+
+if [[ -f "${CGROOT}/cgroup.controllers" ]]; then
+  if grep -qw memory "${CGROOT}/cgroup.controllers"; then
+    grep -qw memory "${CGROOT}/cgroup.subtree_control" || echo +memory > "${CGROOT}/cgroup.subtree_control" || true
+  fi
+fi
+
+ORIG_GLOBAL_NUMA_BALANCING=""
+if [[ -n "${GLOBAL_NUMA_BALANCING}" ]]; then
+  if [[ -w /proc/sys/kernel/numa_balancing ]]; then
+    ORIG_GLOBAL_NUMA_BALANCING="$(< /proc/sys/kernel/numa_balancing)"
+    echo "${GLOBAL_NUMA_BALANCING}" > /proc/sys/kernel/numa_balancing
+    echo "[info] kernel.numa_balancing=${GLOBAL_NUMA_BALANCING}"
+    trap 'if [[ -n "${ORIG_GLOBAL_NUMA_BALANCING}" && -w /proc/sys/kernel/numa_balancing ]]; then echo "${ORIG_GLOBAL_NUMA_BALANCING}" > /proc/sys/kernel/numa_balancing || true; fi' EXIT
+  else
+    echo "[warn] /proc/sys/kernel/numa_balancing not writable; skip global toggle"
+  fi
+fi
+
+reset_cgroup_dir "${CGROOT}/${CG_NAME}"
+mkdir -p "${CGROOT}/${CG_NAME}"
+mkdir -p "${OUTDIR}"
+
+if ! write_knob "${CGROOT}/${CG_NAME}" "node_capacity" "0 ${CAPACITY_PAGES}"; then
+  echo "failed: node_capacity knob not found in ${CGROOT}/${CG_NAME}" >&2
+  exit 1
+fi
+
+if ! write_knob "${CGROOT}/${CG_NAME}" "node_balancing" "${NODE_BALANCING_MODE}"; then
+  echo "failed: node_balancing knob not found in ${CGROOT}/${CG_NAME}" >&2
+  exit 1
+fi
+
+if ! write_knob "${CGROOT}/${CG_NAME}" "kswapd_demotion_enabled" "${KSWAPD_DEMOTION_ENABLED}"; then
+  echo "failed: kswapd_demotion_enabled knob not found in ${CGROOT}/${CG_NAME}" >&2
+  exit 1
+fi
+
+if ! write_knob "${CGROOT}/${CG_NAME}" "node_force_lru_evict" "0 1"; then
+  echo "failed: node_force_lru_evict knob not found in ${CGROOT}/${CG_NAME}" >&2
+  exit 1
+fi
+
+echo "[info] ${CG_NAME}: node0 capacity=${CAPACITY_PAGES} pages (8GiB), node_balancing=${NODE_BALANCING_MODE}, kswapd_demotion_enabled=${KSWAPD_DEMOTION_ENABLED}"
+if [[ -n "${GLOBAL_NUMA_BALANCING}" ]]; then
+  echo "[info] kernel.numa_balancing=${GLOBAL_NUMA_BALANCING}"
+fi
+
+CG_PROCS="${CGROOT}/${CG_NAME}/cgroup.procs"
+LOG_PATH="/tmp/${CG_NAME}.log"
+
+snapshot_cgroup_stats "${CGROOT}/${CG_NAME}" "${OUTDIR}/cgroup.before"
+snapshot_vmstat "${OUTDIR}/vmstat.before"
+
+bash -lc "echo \$$ > '${CG_PROCS}'; exec /usr/bin/time -f 'execution time %e (s)' ${CMD}" > "${LOG_PATH}" 2>&1 &
+PID=$!
+
+echo "[run] ${CG_NAME} pid=${PID}"
+echo "[log] ${LOG_PATH}"
+echo "[stats] ${OUTDIR}"
+
+wait "${PID}"
+
+snapshot_cgroup_stats "${CGROOT}/${CG_NAME}" "${OUTDIR}/cgroup.after"
+snapshot_vmstat "${OUTDIR}/vmstat.after"
+write_diff "${OUTDIR}/cgroup.before" "${OUTDIR}/cgroup.after" "${OUTDIR}/cgroup.diff"
+write_diff "${OUTDIR}/vmstat.before" "${OUTDIR}/vmstat.after" "${OUTDIR}/vmstat.diff"
+
+echo "[done] tenant completed"
+echo "[done] cgroup diff:"
+cat "${OUTDIR}/cgroup.diff"
+echo "[done] vmstat diff:"
+cat "${OUTDIR}/vmstat.diff"
