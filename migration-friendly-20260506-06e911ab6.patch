diff --git a/scripts/kernel/run_single_tenant_node_balancing_toggle_test.sh b/scripts/kernel/run_single_tenant_node_balancing_toggle_test.sh
new file mode 100755
index 000000000..c327bde67
--- /dev/null
+++ b/scripts/kernel/run_single_tenant_node_balancing_toggle_test.sh
@@ -0,0 +1,184 @@
+#!/usr/bin/env bash
+set -euo pipefail
+
+# Run inside VM as root.
+# Creates one cgroup, runs one tenant command, and toggles cgroup
+# memory.node_balancing between two modes while the workload is running.
+
+CGROOT="${CGROOT:-/sys/fs/cgroup}"
+CG_NAME="${CG_NAME:-tenantA}"
+CAPACITY_PAGES="${CAPACITY_PAGES:-2097152}"  # 8GiB / 4KiB
+CMD="${CMD:-/root/bc -g 27}"
+NODE_BALANCING_MODE="${NODE_BALANCING_MODE:-2}"
+ALT_NODE_BALANCING_MODE="${ALT_NODE_BALANCING_MODE:-0}"
+TOGGLE_INTERVAL_SECS="${TOGGLE_INTERVAL_SECS:-15}"
+KSWAPD_DEMOTION_ENABLED="${KSWAPD_DEMOTION_ENABLED:-1}"
+DEMOTION_SRC_NODE="${DEMOTION_SRC_NODE:-0}"
+DEMOTION_DST_NODE="${DEMOTION_DST_NODE:-1}"
+
+if [[ "${EUID}" -ne 0 ]]; then
+  echo "run as root (sudo)" >&2
+  exit 1
+fi
+
+if [[ ! -d "${CGROOT}" ]]; then
+  echo "cgroup root not found: ${CGROOT}" >&2
+  exit 1
+fi
+
+if ! [[ "${CAPACITY_PAGES}" =~ ^[0-9]+$ ]] || \
+   ! [[ "${NODE_BALANCING_MODE}" =~ ^[0-9]+$ ]] || \
+   ! [[ "${ALT_NODE_BALANCING_MODE}" =~ ^[0-9]+$ ]] || \
+   ! [[ "${TOGGLE_INTERVAL_SECS}" =~ ^[0-9]+$ ]]; then
+  echo "CAPACITY_PAGES, NODE_BALANCING_MODE, ALT_NODE_BALANCING_MODE, and TOGGLE_INTERVAL_SECS must be non-negative integers" >&2
+  exit 1
+fi
+
+if (( CAPACITY_PAGES == 0 )); then
+  echo "CAPACITY_PAGES must be greater than 0" >&2
+  exit 1
+fi
+
+if [[ -f /sys/kernel/mm/numa/demotion_enabled ]]; then
+  echo true > /sys/kernel/mm/numa/demotion_enabled
+  echo "[info] numa demotion enabled"
+else
+  echo "[warn] /sys/kernel/mm/numa/demotion_enabled not found; skip demotion enable"
+fi
+
+if [[ -f /sys/kernel/mm/numa/demotion_target ]]; then
+  echo "${DEMOTION_SRC_NODE} ${DEMOTION_DST_NODE}" > /sys/kernel/mm/numa/demotion_target
+  echo "[info] manual demotion target: node${DEMOTION_SRC_NODE} -> node${DEMOTION_DST_NODE}"
+  while IFS= read -r line; do
+    echo "[info] demotion_target ${line}"
+  done < /sys/kernel/mm/numa/demotion_target
+else
+  echo "[warn] /sys/kernel/mm/numa/demotion_target not found; skip manual target setup"
+fi
+
+pick_knob_file() {
+  local cg="$1"
+  local name="$2"
+  local f
+
+  for f in "${cg}/${name}" "${cg}/memory.${name}"; do
+    if [[ -f "${f}" ]]; then
+      echo "${f}"
+      return 0
+    fi
+  done
+
+  return 1
+}
+
+write_knob() {
+  local cg="$1"
+  local name="$2"
+  local value="$3"
+  local f
+
+  f="$(pick_knob_file "${cg}" "${name}")" || return 1
+  echo "${value}" > "${f}"
+}
+
+read_knob() {
+  local cg="$1"
+  local name="$2"
+  local f
+
+  f="$(pick_knob_file "${cg}" "${name}")" || return 1
+  cat "${f}"
+}
+
+reset_cgroup_dir() {
+  local cg="$1"
+  local root_procs="${CGROOT}/cgroup.procs"
+  local cg_procs="${cg}/cgroup.procs"
+  local pid
+
+  if [[ ! -d "${cg}" ]]; then
+    return 0
+  fi
+
+  if [[ -f "${cg_procs}" && -f "${root_procs}" ]]; then
+    while IFS= read -r pid; do
+      [[ -n "${pid}" ]] || continue
+      echo "${pid}" > "${root_procs}" || true
+    done < "${cg_procs}"
+  fi
+
+  rmdir "${cg}" 2>/dev/null || true
+}
+
+if [[ -f "${CGROOT}/cgroup.controllers" ]]; then
+  if grep -qw memory "${CGROOT}/cgroup.controllers"; then
+    grep -qw memory "${CGROOT}/cgroup.subtree_control" || echo +memory > "${CGROOT}/cgroup.subtree_control" || true
+  fi
+fi
+
+reset_cgroup_dir "${CGROOT}/${CG_NAME}"
+mkdir -p "${CGROOT}/${CG_NAME}"
+
+if ! write_knob "${CGROOT}/${CG_NAME}" "node_capacity" "0 ${CAPACITY_PAGES}"; then
+  echo "failed: node_capacity knob not found in ${CGROOT}/${CG_NAME}" >&2
+  exit 1
+fi
+
+if ! write_knob "${CGROOT}/${CG_NAME}" "node_balancing" "${NODE_BALANCING_MODE}"; then
+  echo "failed: node_balancing knob not found in ${CGROOT}/${CG_NAME}" >&2
+  exit 1
+fi
+
+if ! write_knob "${CGROOT}/${CG_NAME}" "kswapd_demotion_enabled" "${KSWAPD_DEMOTION_ENABLED}"; then
+  echo "failed: kswapd_demotion_enabled knob not found in ${CGROOT}/${CG_NAME}" >&2
+  exit 1
+fi
+
+if ! write_knob "${CGROOT}/${CG_NAME}" "node_force_lru_evict" "0 1"; then
+  echo "failed: node_force_lru_evict knob not found in ${CGROOT}/${CG_NAME}" >&2
+  exit 1
+fi
+
+echo "[info] ${CG_NAME}: node0 capacity=${CAPACITY_PAGES} pages, node_balancing=${NODE_BALANCING_MODE}, kswapd_demotion_enabled=${KSWAPD_DEMOTION_ENABLED}"
+echo "[info] will alternate node_balancing between ${NODE_BALANCING_MODE} and ${ALT_NODE_BALANCING_MODE} every ${TOGGLE_INTERVAL_SECS}s"
+
+CG_PROCS="${CGROOT}/${CG_NAME}/cgroup.procs"
+LOG_PATH="/tmp/${CG_NAME}.log"
+
+bash -lc "echo \$$ > '${CG_PROCS}'; exec ${CMD}" > "${LOG_PATH}" 2>&1 &
+PID=$!
+
+(
+  next_mode="${ALT_NODE_BALANCING_MODE}"
+  while true; do
+    sleep "${TOGGLE_INTERVAL_SECS}"
+
+    if ! kill -0 "${PID}" 2>/dev/null; then
+      echo "[info] workload exited before next node_balancing toggle"
+      exit 0
+    fi
+
+    if write_knob "${CGROOT}/${CG_NAME}" "node_balancing" "${next_mode}"; then
+      current_mode="$(read_knob "${CGROOT}/${CG_NAME}" "node_balancing" | tr -d '\n')"
+      echo "[info] updated ${CG_NAME} node_balancing to ${current_mode}"
+    else
+      echo "[warn] failed to update node_balancing to ${next_mode} for ${CG_NAME}" >&2
+      exit 0
+    fi
+
+    if (( next_mode == ALT_NODE_BALANCING_MODE )); then
+      next_mode="${NODE_BALANCING_MODE}"
+    else
+      next_mode="${ALT_NODE_BALANCING_MODE}"
+    fi
+  done
+) &
+TOGGLE_PID=$!
+
+echo "[run] ${CG_NAME} pid=${PID}"
+echo "[log] ${LOG_PATH}"
+
+wait "${PID}"
+wait "${TOGGLE_PID}" || true
+
+echo "[done] tenant completed"
