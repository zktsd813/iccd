+      "$@"
+    ;;
+  mbench-lu)
+    shift
+    exec "${ROOT_MB}/mbench" --mode bw --threads "${THREADS:-4}" \
+      --bw-kernel triad --bw-stride 2 --bw-block 512K \
+      --arena-size "${ARENA:-16G}" --window-size "${WINDOW:-16G}" \
+      --move-policy fixed \
+      --ops-per-pass 524288 --pause-ns 100000 --duration "${DURATION:-10}" --sample-ms "${SAMPLE_MS:-1000}" \
+      "$@"
+    ;;
+  mbench-sp)
+    shift
+    exec "${ROOT_MB}/mbench" --mode bw --threads "${THREADS:-4}" \
+      --bw-kernel triad --bw-stride 1 --bw-block 1M \
+      --arena-size "${ARENA:-16G}" --window-size "${WINDOW:-16G}" \
+      --move-policy fixed \
+      --ops-per-pass 524288 --pause-ns 100000 --duration "${DURATION:-10}" --sample-ms "${SAMPLE_MS:-1000}" \
+      "$@"
+    ;;
+  mbench-paper-micro)
+    shift
+    "${ROOT_MB}/mbench" --mode irregular-index --threads "${THREADS:-4}" \
+      --index-kernel rmw --index-distribution uniform \
+      --arena-size "${ARENA:-80G}" --window-size 30G \
+      --move-policy fixed \
+      --ops-per-pass 65536 --pause-ns 100000 --duration "${PHASE_SEC:-300}" --sample-ms "${SAMPLE_MS:-1000}" "$@"
+    "${ROOT_MB}/mbench" --mode irregular-index --threads "${THREADS:-4}" \
+      --index-kernel gather --index-distribution segmented \
+      --index-segments 16 --index-segment-span-ops 8192 \
+      --arena-size "${ARENA:-80G}" --window-size 60G \
+      --move-policy sweep --move-step 512M --move-interval-ms 1000 \
+      --ops-per-pass 65536 --pause-ns 100000 --duration "${PHASE_SEC:-300}" --sample-ms "${SAMPLE_MS:-1000}" "$@"
+    exec "${ROOT_MB}/mbench" --mode irregular-index --threads "${THREADS:-4}" \
+      --index-kernel rmw --index-distribution uniform \
+      --arena-size "${ARENA:-80G}" --window-size 30G \
+      --move-policy fixed \
+      --ops-per-pass 65536 --pause-ns 100000 --duration "${PHASE_SEC:-300}" --sample-ms "${SAMPLE_MS:-1000}" "$@"
+    ;;
+  *)
+    echo "unknown workload: $1" >&2
+    usage >&2
+    exit 1
+    ;;
+esac
+EOF
+  sudo_run chmod 0755 "${MOUNT_DIR}/Serverless/benchmark/paper-workloads/bin/paper-workload"
+
+  sudo_run tee "${MOUNT_DIR}/Serverless/benchmark/paper-workloads/README.md" >/dev/null <<'EOF'
+# Paper Workloads
+
+This guest image mirrors the workload families used in the CXL migration paper.
+
+Available real workloads:
+
+- `paper-workload pr`
+- `paper-workload gups-st`
+- `paper-workload gups-mt`
+- `paper-workload silo`
+- `paper-workload liblinear-heart-scale`
+- `paper-workload liblinear-kdd12`
+- `paper-workload ft`
+- `paper-workload lu`
+- `paper-workload sp`
+
+Available surrogate microbenchmarks:
+
+- `paper-workload mbench-pr`
+- `paper-workload mbench-bc`
+- `paper-workload mbench-gups`
+- `paper-workload mbench-silo`
+- `paper-workload mbench-liblinear`
+- `paper-workload mbench-ft`
+- `paper-workload mbench-lu`
+- `paper-workload mbench-sp`
+- `paper-workload mbench-paper-micro`
+
+Paper-style multi-tenant helpers:
+
+- `paper-workload pair liblinear-ft 30`
+- `paper-workload pair liblinear-sp 30`
+- `paper-workload pair silo-ft 30`
+- `paper-workload pair gups-sp 30`
+- `paper-workload pair silo-gups 30`
+- `paper-workload pair pr-gups 30`
+
+Copied benchmark paths:
+
+- `/Serverless/benchmark/gapbs`
+- `/Serverless/benchmark/vmitosis-workloads/bin`
+- `/Serverless/benchmark/silo/out-perf.masstree`
+- `/Serverless/benchmark/liblinear-multicore-2.47`
+- `/Serverless/benchmark/NPB3.4.3/NPB3.4-OMP/bin`
+- `/Serverless/Migration-friendly/Microbenchmark`
+
+Supporting references:
+
+- `/Serverless/benchmark/paper-workloads/5.Evaluation.tex`
+- `/Serverless/benchmark/paper-workloads/table.tex`
+- `/Serverless/Migration-friendly/Microbenchmark/docs/workload-presets.md`
+EOF
+
+  sudo_run tee "${MOUNT_DIR}/etc/profile.d/paper-workloads-path.sh" >/dev/null <<'EOF'
+export PATH="/Serverless/benchmark/paper-workloads/bin:${PATH}"
