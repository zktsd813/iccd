@@ -0,0 +1,390 @@
+#!/usr/bin/env python3
+import argparse
+import os
+import sys
+import time
+from datetime import datetime
+
+PAGE_COUNT_KEYS = {
+    "workingset_refault_anon",
+    "workingset_refault_file",
+    "workingset_activate_anon",
+    "workingset_activate_file",
+    "workingset_restore_anon",
+    "workingset_restore_file",
+    "workingset_nodereclaim",
+    "pgdemote_kswapd",
+    "pgdemote_direct",
+    "pgdemote_khugepaged",
+    "pgdemote_proactive",
+    "pgpromote_success",
+}
+
+HIDDEN_NUMA_STAT_KEYS = {
+    "file",
+    "file_dirty",
+    "file_mapped",
+    "file_thp",
+    "file_writeback",
+    "inactive_file",
+    "active_file",
+    "kernel_stack",
+    "hugetlb",
+    "slab_reclaimable",
+    "slab_unreclaimable",
+    "pagetables",
+    "sec_pagetables",
+    "shmem",
+    "shmem_thp",
+    "workingset_refault_anon",
+    "workingset_refault_file",
+    "workingset_activate_anon",
+    "workingset_activate_file",
+    "workingset_restore_anon",
+    "workingset_restore_file",
+    "workingset_nodereclaim",
+}
+
+
+def pick_cgroup_file(cgdir: str, name: str) -> str:
+    candidates = [
+        os.path.join(cgdir, name),
+        os.path.join(cgdir, f"memory.{name}"),
+    ]
+    for path in candidates:
+        if os.path.isfile(path):
+            return path
+    raise FileNotFoundError(f"missing cgroup file for {name} under {cgdir}")
+
+
+def parse_numa_stat(path: str) -> dict[str, dict[int, int]]:
+    stats: dict[str, dict[int, int]] = {}
+    with open(path, "r", encoding="utf-8") as f:
+        for raw in f:
+            line = raw.strip()
+            if not line:
+                continue
+            parts = line.split()
+            key = parts[0]
+            nodes: dict[int, int] = {}
+            for tok in parts[1:]:
+                if "=" not in tok or not tok.startswith("N"):
+                    continue
+                node_name, value = tok.split("=", 1)
+                try:
+                    nid = int(node_name[1:])
+                    nodes[nid] = int(value)
+                except ValueError:
+                    continue
+            stats[key] = nodes
+    return stats
+
+
+def parse_vmstat(path: str, keys: list[str]) -> dict[str, int]:
+    wanted = set(keys)
+    values = {key: 0 for key in keys}
+    with open(path, "r", encoding="utf-8") as f:
+        for raw in f:
+            parts = raw.split()
+            if len(parts) != 2 or parts[0] not in wanted:
+                continue
+            values[parts[0]] = int(parts[1])
+    return values
+
+
+def parse_capacity_pages(cgdir: str) -> dict[int, int]:
+    try:
+        path = pick_cgroup_file(cgdir, "node_capacity")
+    except FileNotFoundError:
+        return {}
+
+    capacities: dict[int, int] = {}
+    with open(path, "r", encoding="utf-8") as f:
+        for raw in f:
+            parts = raw.split()
+            if len(parts) != 2:
+                continue
+            try:
+                nid = int(parts[0])
+                pages = int(parts[1])
+            except ValueError:
+                continue
+            capacities[nid] = pages
+    return capacities
+
+
+def parse_key_value_file(path: str) -> dict[str, str]:
+    data: dict[str, str] = {}
+    with open(path, "r", encoding="utf-8") as f:
+        for raw in f:
+            line = raw.strip()
+            if not line:
+                continue
+            parts = line.split(None, 1)
+            if len(parts) == 1:
+                data[parts[0]] = ""
+            else:
+                data[parts[0]] = parts[1]
+    return data
+
+
+def parse_stat_file(path: str, keys: list[str]) -> dict[str, int]:
+    wanted = set(keys)
+    values = {key: 0 for key in keys}
+    with open(path, "r", encoding="utf-8") as f:
+        for raw in f:
+            parts = raw.split()
+            if len(parts) != 2 or parts[0] not in wanted:
+                continue
+            values[parts[0]] = int(parts[1])
+    return values
+
+
+def read_page_size() -> int:
+    return os.sysconf("SC_PAGE_SIZE")
+
+
+def pages_to_mib(pages: int, page_size: int) -> float:
+    return (pages * page_size) / (1024.0 * 1024.0)
+
+
+def bytes_to_mib(nbytes: int) -> float:
+    return nbytes / (1024.0 * 1024.0)
+
+
+def format_nodes(nodes: dict[int, int], key: str, page_size: int) -> str:
+    if not nodes:
+        return "-"
+    parts = []
+    for nid in sorted(nodes):
+        value = nodes[nid]
+        if key in PAGE_COUNT_KEYS:
+            parts.append(f"N{nid}={value}p ({pages_to_mib(value, page_size):8.1f} MiB)")
+            continue
+        pages = value // page_size
+        parts.append(f"N{nid}={bytes_to_mib(value):8.1f} MiB ({pages}p/{value}B)")
+    return "  ".join(parts)
+
+
+def sum_by_node(stats: dict[str, dict[int, int]], keys: list[str]) -> dict[int, int]:
+    summed: dict[int, int] = {}
+    for key in keys:
+        for nid, value in stats.get(key, {}).items():
+            summed[nid] = summed.get(nid, 0) + value
+    return summed
+
+
+def render(
+    cg_name: str,
+    cgdir: str,
+    numa_stats: dict[str, dict[int, int]],
+    memstat_now: dict[str, int] | None,
+    memstat_base: dict[str, int],
+    reclaimd_state: dict[str, str] | None,
+    reclaimd_base: dict[str, int],
+    numa_migrate_state: dict[str, str] | None,
+    numa_migrate_base: dict[str, int],
+    vmstat_now: dict[str, int],
+    vmstat_base: dict[str, int],
+    page_size: int,
+) -> str:
+    reclaim_basis_bytes = sum_by_node(
+        numa_stats,
+        ["inactive_anon", "active_anon", "inactive_file", "active_file", "unevictable"],
+    )
+    header = [
+        f"time={datetime.now().strftime('%F %T')}",
+        f"cgroup={cg_name}",
+        f"path={cgdir}",
+    ]
+    lines = [" | ".join(header)]
+
+    lines.append("memory.numa_stat:")
+    for key in sorted(numa_stats):
+        if key in HIDDEN_NUMA_STAT_KEYS:
+            continue
+        lines.append(f"  {key:24s} {format_nodes(numa_stats[key], key, page_size)}")
+
+    lines.append("derived_reclaim_basis:")
+    lines.append(
+        f"  {'reclaim_basis':24s} {format_nodes(reclaim_basis_bytes, 'reclaim_basis', page_size)}"
+    )
+
+    if memstat_now is not None:
+        lines.append("memory.stat numa counters:")
+        for key in ("numa_hint_faults", "numa_page_migrate", "pgdemote_kswapd", "pgpromote_success"):
+            now = memstat_now.get(key, 0)
+            base = memstat_base.get(key, 0)
+            lines.append(f"  {key}={now} (delta={now - base})")
+
+    if reclaimd_state is not None:
+        wake_now = int(reclaimd_state.get("wake_count", "0"))
+        run_now = int(reclaimd_state.get("run_count", "0"))
+        running = reclaimd_state.get("running", "0")
+        pending = reclaimd_state.get("pending_nodes", "")
+        inflight = reclaimd_state.get("inflight_nodes", "")
+        lines.append("memory.reclaimd_state:")
+        lines.append(
+            "  "
+            f"running={running}  "
+            f"wake_count={wake_now} (delta={wake_now - reclaimd_base.get('wake_count', 0)})  "
+            f"run_count={run_now} (delta={run_now - reclaimd_base.get('run_count', 0)})"
+        )
+        lines.append(f"  pending_nodes={pending or '-'}  inflight_nodes={inflight or '-'}")
+
+    if numa_migrate_state is not None:
+        total_now = int(numa_migrate_state.get("numa_migrate_success_total", "0"))
+        promotion_now = int(numa_migrate_state.get("numa_migrate_success_promotion", "0"))
+        other_now = int(numa_migrate_state.get("numa_migrate_success_other", "0"))
+        lines.append("memory.numa_migrate_state:")
+        lines.append(
+            "  "
+            f"total={total_now} (delta={total_now - numa_migrate_base.get('numa_migrate_success_total', 0)})  "
+            f"promotion={promotion_now} (delta={promotion_now - numa_migrate_base.get('numa_migrate_success_promotion', 0)})  "
+            f"other={other_now} (delta={other_now - numa_migrate_base.get('numa_migrate_success_other', 0)})"
+        )
+
+    demote_now = vmstat_now.get("pgdemote_kswapd", 0)
+    promote_now = vmstat_now.get("pgpromote_success", 0)
+    promote_candidate = vmstat_now.get("pgpromote_candidate", 0)
+    promote_candidate_nrl = vmstat_now.get("pgpromote_candidate_nrl", 0)
+    hint_faults = vmstat_now.get("numa_hint_faults", 0)
+    hint_faults_local = vmstat_now.get("numa_hint_faults_local", 0)
+    numa_pages_migrated = vmstat_now.get("numa_pages_migrated", 0)
+    demote_delta = demote_now - vmstat_base.get("pgdemote_kswapd", 0)
+    promote_delta = promote_now - vmstat_base.get("pgpromote_success", 0)
+    promote_candidate_delta = promote_candidate - vmstat_base.get("pgpromote_candidate", 0)
+    promote_candidate_nrl_delta = promote_candidate_nrl - vmstat_base.get("pgpromote_candidate_nrl", 0)
+    hint_faults_delta = hint_faults - vmstat_base.get("numa_hint_faults", 0)
+    hint_faults_local_delta = hint_faults_local - vmstat_base.get("numa_hint_faults_local", 0)
+    numa_pages_migrated_delta = numa_pages_migrated - vmstat_base.get("numa_pages_migrated", 0)
+    lines.append("global /proc/vmstat counters (pages):")
+    lines.append(f"  numa_hint_faults={hint_faults} (delta={hint_faults_delta})")
+    lines.append(f"  numa_hint_faults_local={hint_faults_local} (delta={hint_faults_local_delta})")
+    lines.append(f"  numa_pages_migrated={numa_pages_migrated} (delta={numa_pages_migrated_delta})")
+    lines.append(
+        f"  pgdemote_kswapd={demote_now} (delta={demote_delta}, "
+        f"{pages_to_mib(demote_now, page_size):.1f} MiB, "
+        f"{pages_to_mib(demote_delta, page_size):.1f} MiB delta)"
+    )
+    lines.append(
+        f"  pgpromote_candidate={promote_candidate} (delta={promote_candidate_delta}, "
+        f"{pages_to_mib(promote_candidate, page_size):.1f} MiB, "
+        f"{pages_to_mib(promote_candidate_delta, page_size):.1f} MiB delta)"
+    )
+    lines.append(
+        f"  pgpromote_candidate_nrl={promote_candidate_nrl} (delta={promote_candidate_nrl_delta}, "
+        f"{pages_to_mib(promote_candidate_nrl, page_size):.1f} MiB, "
+        f"{pages_to_mib(promote_candidate_nrl_delta, page_size):.1f} MiB delta)"
+    )
+    lines.append(
+        f"  pgpromote_success={promote_now} (delta={promote_delta}, "
+        f"{pages_to_mib(promote_now, page_size):.1f} MiB, "
+        f"{pages_to_mib(promote_delta, page_size):.1f} MiB delta)"
+    )
+    lines.append(
+        "  note: pgdemote_kswapd/pgpromote_* are global VM counters, not per-cgroup counters."
+    )
+    return "\n".join(lines)
+
+
+def main() -> int:
+    parser = argparse.ArgumentParser(
+        description="Continuously print cgroup memory.numa_stat and related VM demotion/promotion counters."
+    )
+    parser.add_argument("--cgroot", default=os.environ.get("CGROOT", "/sys/fs/cgroup"))
+    parser.add_argument("--cgroup", default=os.environ.get("CG_NAME", "tenantA"))
+    parser.add_argument("--interval", type=float, default=float(os.environ.get("INTERVAL", "1.0")))
+    parser.add_argument("--once", action="store_true")
+    args = parser.parse_args()
+
+    cgdir = os.path.join(args.cgroot, args.cgroup)
+    if not os.path.isdir(cgdir):
+        print(f"cgroup directory not found: {cgdir}", file=sys.stderr)
+        return 1
+
+    try:
+        numa_path = pick_cgroup_file(cgdir, "numa_stat")
+    except FileNotFoundError as e:
+        print(str(e), file=sys.stderr)
+        return 1
+    try:
+        reclaimd_path = pick_cgroup_file(cgdir, "reclaimd_state")
+    except FileNotFoundError:
+        reclaimd_path = None
+    try:
+        numa_migrate_path = pick_cgroup_file(cgdir, "numa_migrate_state")
+    except FileNotFoundError:
+        numa_migrate_path = None
+    try:
+        memstat_path = pick_cgroup_file(cgdir, "stat")
+    except FileNotFoundError:
+        memstat_path = None
+
+    page_size = read_page_size()
+    vm_keys = [
+        "numa_hint_faults",
+        "numa_hint_faults_local",
+        "numa_pages_migrated",
+        "pgdemote_kswapd",
+        "pgpromote_candidate",
+        "pgpromote_candidate_nrl",
+        "pgpromote_success",
+    ]
+    vmstat_base = parse_vmstat("/proc/vmstat", vm_keys)
+    memstat_keys = ["numa_hint_faults", "numa_page_migrate", "pgdemote_kswapd", "pgpromote_success"]
+    memstat_base = {key: 0 for key in memstat_keys}
+    if memstat_path is not None:
+        memstat_base = parse_stat_file(memstat_path, memstat_keys)
+    reclaimd_base = {"wake_count": 0, "run_count": 0}
+    if reclaimd_path is not None:
+        reclaimd_base_raw = parse_key_value_file(reclaimd_path)
+        reclaimd_base["wake_count"] = int(reclaimd_base_raw.get("wake_count", "0"))
+        reclaimd_base["run_count"] = int(reclaimd_base_raw.get("run_count", "0"))
+    numa_migrate_base = {
+        "numa_migrate_success_total": 0,
+        "numa_migrate_success_promotion": 0,
+        "numa_migrate_success_other": 0,
+    }
+    if numa_migrate_path is not None:
+        numa_migrate_base_raw = parse_key_value_file(numa_migrate_path)
+        for key in numa_migrate_base:
+            numa_migrate_base[key] = int(numa_migrate_base_raw.get(key, "0"))
+
+    while True:
+        try:
+            numa_stats = parse_numa_stat(numa_path)
+            capacities = parse_capacity_pages(cgdir)
+            vmstat_now = parse_vmstat("/proc/vmstat", vm_keys)
+            memstat_now = parse_stat_file(memstat_path, memstat_keys) if memstat_path else None
+            reclaimd_state = parse_key_value_file(reclaimd_path) if reclaimd_path else None
+            numa_migrate_state = parse_key_value_file(numa_migrate_path) if numa_migrate_path else None
+        except FileNotFoundError as e:
+            print(str(e), file=sys.stderr)
+            return 1
+
+        print(
+            render(
+                args.cgroup,
+                cgdir,
+                numa_stats,
+                memstat_now,
+                memstat_base,
+                reclaimd_state,
+                reclaimd_base,
+                numa_migrate_state,
+                numa_migrate_base,
+                vmstat_now,
+                vmstat_base,
+                page_size,
+            )
+        )
+        sys.stdout.flush()
+        if args.once:
+            return 0
+        time.sleep(args.interval)
+        print()
+
+
+if __name__ == "__main__":
+    raise SystemExit(main())
