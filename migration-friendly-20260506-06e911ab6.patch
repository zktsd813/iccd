@@ -0,0 +1,31 @@
+#!/usr/bin/env bash
+set -euo pipefail
+
+# Usage: tenant_b_cmd.sh [MiB] [seconds]
+MIB="${1:-6144}"
+SECONDS_HOLD="${2:-120}"
+
+exec python3 - "$MIB" "$SECONDS_HOLD" <<'PY'
+import sys
+import time
+
+mib = int(sys.argv[1])
+hold = int(sys.argv[2])
+size = mib * 1024 * 1024
+
+buf = bytearray(size)
+step = 4096
+for i in range(0, size, step):
+    buf[i] = ((i // step) * 3) & 0xFF
+
+deadline = time.time() + hold
+while time.time() < deadline:
+    s = 0
+    for i in range(0, size, step * 16):
+        s += buf[i]
+    if s == -1:
+        print("unreachable")
+    time.sleep(0.5)
+
+print(f"[tenant-b] allocated={mib}MiB hold={hold}s done", flush=True)
+PY
