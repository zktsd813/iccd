+#!/usr/bin/env bash
+set -euo pipefail
+
+SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
+REPO_ROOT="$(cd "${SCRIPT_DIR}/../.." && pwd)"
+QEMU_TREE="${QEMU_TREE:-/Serverless/Migration-friendly/qemu}"
+LAUNCHER="${LAUNCHER:-${SCRIPT_DIR}/launch_kernel_qemu.sh}"
+QEMU_BIN="${QEMU_BIN:-${QEMU_TREE}/build/qemu-system-x86_64}"
+QEMU_IMG="${QEMU_IMG:-qemu-img}"
+ROOTFS_BASE="${ROOTFS_BASE:-${SCRIPT_DIR}/vm-images/adaptive-migration-base.qcow2}"
+OVERLAY_DIR="${OVERLAY_DIR:-${SCRIPT_DIR}/vm-images}"
+RESULTS_DIR="${RESULTS_DIR:-${SCRIPT_DIR}/qemu-results/gapbs-autorun}"
+KERNEL_DIR="${KERNEL_DIR:-${REPO_ROOT}}"
+KERNEL_IMAGE="${KERNEL_IMAGE:-${KERNEL_DIR}/arch/x86/boot/bzImage}"
+KERNEL_LABEL="${KERNEL_LABEL:-$(basename "${KERNEL_DIR}")}"
+NBD_DEVICE="${NBD_DEVICE:-/dev/nbd0}"
+MOUNT_DIR="${MOUNT_DIR:-/tmp/gapbs-autorun-root}"
+GRAPH_SCALE="${GRAPH_SCALE:-20}"
+BC_TRIALS="${BC_TRIALS:-1}"
+PR_TRIALS="${PR_TRIALS:-1}"
+PR_ITERS="${PR_ITERS:-2}"
+PR_TOLERANCE="${PR_TOLERANCE:-1e-4}"
+USE_NUMACTL="${USE_NUMACTL:-1}"
+SSH_FORWARD_PORT="${SSH_FORWARD_PORT:-10062}"
+MEMORY="${MEMORY:-8G}"
+CPUS="${CPUS:-2}"
+NUMA_NODE0_CPUS="${NUMA_NODE0_CPUS:-0-1}"
+NUMA_NODE0_MEM="${NUMA_NODE0_MEM:-4G}"
+NUMA_NODE1_MEM="${NUMA_NODE1_MEM:-4G}"
+VM_NAME="${VM_NAME:-}"
+TIMEOUT_SEC="${TIMEOUT_SEC:-900}"
+RUN_ID="${RUN_ID:-$(date -u +%Y%m%dT%H%M%SZ)}"
+RUN_DIR="${RESULTS_DIR}/${RUN_ID}-${KERNEL_LABEL}"
+HOST_LOG="${RUN_DIR}/host-launch.log"
+GUEST_LOG_COPY="${RUN_DIR}/guest-gapbs-autotest.log"
+SUMMARY_TXT="${RUN_DIR}/summary.txt"
+OVERLAY_IMAGE="${OVERLAY_DIR}/gapbs-autorun-${KERNEL_LABEL}-${RUN_ID}.qcow2"
+
+if [[ -z "${VM_NAME}" ]]; then
+  VM_NAME="gapbs-${KERNEL_LABEL}"
+fi
+ROOT_MAPPER=""
+MOUNT_ACTIVE=0
+NBD_ACTIVE=0
+
+usage() {
+  cat <<'EOF'
+Usage:
+  run_qemu_gapbs_autorun.sh [options]
+
+Options:
+  --kernel-dir <path>      Kernel source/build directory
+  --kernel-image <path>    bzImage path
+  --kernel-label <name>    Label used for output paths
+  --rootfs-base <path>     Base qcow2 image
+  --graph-scale <n>        GAPBS graph scale for bc/pr (default: 20)
+  --timeout-sec <n>        QEMU runtime timeout in seconds (default: 900)
+  --run-id <id>            Output run identifier
+  --ssh-forward-port <p>   Host forwarded port (default: 10062)
+  --memory <size>          Guest memory (default: 8G)
+  --cpus <n>               Guest CPU count (default: 2)
+  --numa-node0-cpus <r>    NUMA node0 CPU range (default: 0-1)
+  --numa-node0-mem <size>  NUMA node0 memory (default: 4G)
+  --numa-node1-mem <size>  NUMA node1 memory (default: 4G)
+  -h, --help               Show this help
+EOF
+}
+
+while [[ $# -gt 0 ]]; do
+  case "$1" in
+    --kernel-dir)
+      KERNEL_DIR="${2:-}"; shift 2 ;;
+    --kernel-image)
+      KERNEL_IMAGE="${2:-}"; shift 2 ;;
+    --kernel-label)
+      KERNEL_LABEL="${2:-}"; shift 2 ;;
+    --rootfs-base)
+      ROOTFS_BASE="${2:-}"; shift 2 ;;
+    --graph-scale)
+      GRAPH_SCALE="${2:-}"; shift 2 ;;
+    --timeout-sec)
+      TIMEOUT_SEC="${2:-}"; shift 2 ;;
+    --run-id)
+      RUN_ID="${2:-}"; shift 2 ;;
+    --ssh-forward-port)
+      SSH_FORWARD_PORT="${2:-}"; shift 2 ;;
+    --memory)
+      MEMORY="${2:-}"; shift 2 ;;
+    --cpus)
+      CPUS="${2:-}"; shift 2 ;;
+    --numa-node0-cpus)
+      NUMA_NODE0_CPUS="${2:-}"; shift 2 ;;
+    --numa-node0-mem)
+      NUMA_NODE0_MEM="${2:-}"; shift 2 ;;
+    --numa-node1-mem)
+      NUMA_NODE1_MEM="${2:-}"; shift 2 ;;
+    -h|--help)
+      usage
+      exit 0
+      ;;
+    *)
+      echo "Unknown option: $1" >&2
+      usage >&2
+      exit 1
+      ;;
+  esac
+done
+
+RUN_DIR="${RESULTS_DIR}/${RUN_ID}-${KERNEL_LABEL}"
+HOST_LOG="${RUN_DIR}/host-launch.log"
+GUEST_LOG_COPY="${RUN_DIR}/guest-gapbs-autotest.log"
+SUMMARY_TXT="${RUN_DIR}/summary.txt"
+OVERLAY_IMAGE="${OVERLAY_DIR}/gapbs-autorun-${KERNEL_LABEL}-${RUN_ID}.qcow2"
+
+mkdir -p "${RUN_DIR}" "${OVERLAY_DIR}"
+
+if [[ ! -f "${ROOTFS_BASE}" ]]; then
+  echo "base rootfs image not found: ${ROOTFS_BASE}" >&2
+  exit 1
+fi
+
+if [[ ! -f "${KERNEL_IMAGE}" ]]; then
+  echo "kernel image not found: ${KERNEL_IMAGE}" >&2
+  exit 1
+fi
+
+if [[ ! -x /Serverless/benchmark/gapbs/bc || ! -x /Serverless/benchmark/gapbs/pr ]]; then
+  echo "host gapbs binaries missing under /Serverless/benchmark/gapbs" >&2
+  exit 1
+fi
+
+sudo_run() {
+  sudo -n "$@"
+}
+
+cleanup() {
+  local rc=$?
+  if [[ "${MOUNT_ACTIVE}" == "1" ]]; then
+    sudo_run umount "${MOUNT_DIR}" || true
+  fi
+  if [[ -n "${ROOT_MAPPER}" ]]; then
+    sudo_run kpartx -d "${NBD_DEVICE}" || true
+  fi
+  if [[ "${NBD_ACTIVE}" == "1" ]]; then
+    sudo_run qemu-nbd --disconnect "${NBD_DEVICE}" || true
+  fi
+  return "${rc}"
+}
+trap cleanup EXIT
+
+prepare_overlay() {
+  rm -f "${OVERLAY_IMAGE}"
+  "${QEMU_IMG}" create -f qcow2 -F qcow2 -b "${ROOTFS_BASE}" "${OVERLAY_IMAGE}" >/dev/null
+}
+
+mount_overlay() {
+  sudo_run qemu-nbd --disconnect "${NBD_DEVICE}" >/dev/null 2>&1 || true
+  sudo_run qemu-nbd --connect="${NBD_DEVICE}" "${OVERLAY_IMAGE}"
+  NBD_ACTIVE=1
+  sleep 1
+  sudo_run kpartx -av "${NBD_DEVICE}" >/dev/null
+  ROOT_MAPPER="/dev/mapper/$(basename "${NBD_DEVICE}")p2"
+  sudo_run mkdir -p "${MOUNT_DIR}"
+  sudo_run mount "${ROOT_MAPPER}" "${MOUNT_DIR}"
+  MOUNT_ACTIVE=1
+}
+
+unmount_overlay() {
+  if [[ "${MOUNT_ACTIVE}" == "1" ]]; then
+    sudo_run umount "${MOUNT_DIR}"
+    MOUNT_ACTIVE=0
+  fi
+  if [[ -n "${ROOT_MAPPER}" ]]; then
+    sudo_run kpartx -d "${NBD_DEVICE}" >/dev/null || true
+    ROOT_MAPPER=""
+  fi
+  if [[ "${NBD_ACTIVE}" == "1" ]]; then
+    sudo_run qemu-nbd --disconnect "${NBD_DEVICE}" >/dev/null || true
+    NBD_ACTIVE=0
+  fi
+}
+
+inject_guest_payload() {
+  sudo_run install -m 0755 /Serverless/benchmark/gapbs/bc "${MOUNT_DIR}/root/bc"
+  sudo_run install -m 0755 /Serverless/benchmark/gapbs/pr "${MOUNT_DIR}/root/pr"
+  sudo_run install -d -m 0755 "${MOUNT_DIR}/usr/local/sbin"
+  sudo_run tee "${MOUNT_DIR}/usr/local/sbin/gapbs-autotest.sh" >/dev/null <<EOF
+#!/usr/bin/env bash
+set -euo pipefail
+
+LOG=/var/log/gapbs-autotest.log
+mkdir -p /var/log
+exec >>"\${LOG}" 2>&1
+
+echo "[gapbs-autotest] start \$(date -u +%Y-%m-%dT%H:%M:%SZ)"
+echo "[gapbs-autotest] uname \$(uname -r)"
+ls -l /root/bc /root/pr || true
+
+run_case() {
+  local name="\$1"
+  shift
+  local rc=0
+  echo "[gapbs-autotest] running \${name}: \$*"
+  if [[ "${USE_NUMACTL}" == "1" ]] && command -v numactl >/dev/null 2>&1; then
+    set +e
+    numactl --cpunodebind=0 --membind=1 "\$@"
+    rc=\$?
+    set -e
+  else
+    set +e
+    "\$@"
+    rc=\$?
+    set -e
+  fi
+  echo "[gapbs-autotest] rc \${name} \${rc}"
+  return 0
+}
+
+run_case bc /root/bc -g ${GRAPH_SCALE} -n ${BC_TRIALS}
+run_case pr /root/pr -g ${GRAPH_SCALE} -i ${PR_ITERS} -n ${PR_TRIALS} -t${PR_TOLERANCE}
+
+BC_RC=\$(awk '/\\[gapbs-autotest\\] rc bc /{print \$4}' "\${LOG}" | tail -n1)
+PR_RC=\$(awk '/\\[gapbs-autotest\\] rc pr /{print \$4}' "\${LOG}" | tail -n1)
+echo "[gapbs-autotest] summary bc=\${BC_RC:-unknown} pr=\${PR_RC:-unknown}"
+sync
+sleep 1
+systemctl --no-block poweroff || poweroff -f || true
+EOF
+  sudo_run chmod 0755 "${MOUNT_DIR}/usr/local/sbin/gapbs-autotest.sh"
+
+  sudo_run tee "${MOUNT_DIR}/etc/systemd/system/gapbs-autotest.service" >/dev/null <<'EOF'
+[Unit]
+Description=GAPBS Auto Test
+After=multi-user.target
+Wants=multi-user.target
+
+[Service]
+Type=oneshot
+ExecStart=/usr/local/sbin/gapbs-autotest.sh
+TimeoutStartSec=infinity
+
+[Install]
+WantedBy=multi-user.target
+EOF
+  sudo_run ln -sfn ../gapbs-autotest.service "${MOUNT_DIR}/etc/systemd/system/multi-user.target.wants/gapbs-autotest.service"
+  sudo_run ln -sfn /dev/null "${MOUNT_DIR}/etc/systemd/system/systemd-networkd-wait-online.service"
+}
+
+run_vm() {
+  local launch_rc=0
+  set +e
+  timeout --signal=INT "${TIMEOUT_SEC}" \
+    "${LAUNCHER}" \
+      --rootfs "${OVERLAY_IMAGE}" \
+      --rootfs-format qcow2 \
+      --drive-if virtio \
+      --root-device /dev/vda2 \
+      --kernel-dir "${KERNEL_DIR}" \
+      --kernel-image "${KERNEL_IMAGE}" \
+      --qemu-bin "${QEMU_BIN}" \
+      --machine q35 \
+      --net-device e1000 \
+      --ssh-forward-port "${SSH_FORWARD_PORT}" \
+      --memory "${MEMORY}" \
+      --cpus "${CPUS}" \
+      --numa-node0-cpus "${NUMA_NODE0_CPUS}" \
+      --numa-node0-mem "${NUMA_NODE0_MEM}" \
+      --numa-node1-mem "${NUMA_NODE1_MEM}" \
+      --name "${VM_NAME}" \
+      --cmdline "console=ttyS0 root=/dev/vda2 rw loglevel=7 nokaslr" \
+      > "${HOST_LOG}" 2>&1
+  launch_rc=$?
+  set -e
+  if [[ "${launch_rc}" -ne 0 ]]; then
+    echo "qemu exited with rc=${launch_rc}" >> "${SUMMARY_TXT}"
+  fi
+}
+
+collect_results() {
+  if [[ -f "${MOUNT_DIR}/var/log/gapbs-autotest.log" ]]; then
+    sudo_run cp "${MOUNT_DIR}/var/log/gapbs-autotest.log" "${GUEST_LOG_COPY}"
+    sudo_run chown "$(id -u):$(id -g)" "${GUEST_LOG_COPY}"
+  fi
+
+  python3 - "${GUEST_LOG_COPY}" "${SUMMARY_TXT}" <<'PY'
+import pathlib
+import re
+import sys
+
+log_path = pathlib.Path(sys.argv[1])
+summary_path = pathlib.Path(sys.argv[2])
+
+uname = "missing"
+bc = "missing"
+pr = "missing"
+
+if log_path.exists():
+    data = log_path.read_text(encoding="utf-8", errors="replace").splitlines()
+    for line in data:
+        if "[gapbs-autotest] uname " in line:
+            uname = line.rsplit(" ", 1)[-1]
+    for line in data:
+        m = re.search(r"\[gapbs-autotest\] summary bc=([^ ]+) pr=([^ ]+)", line)
+        if m:
+            bc, pr = m.group(1), m.group(2)
+
+summary_path.write_text(
+    f"uname={uname}\n"
+    f"bc_rc={bc}\n"
+    f"pr_rc={pr}\n",
+    encoding="utf-8",
+)
+print(summary_path.read_text(encoding="utf-8"), end="")
+PY
+}
+
+prepare_overlay
+mount_overlay
+inject_guest_payload
+unmount_overlay
+run_vm
+mount_overlay
+collect_results
+unmount_overlay
diff --git a/scripts/kernel/run_qemu_gapbs_sanity.sh b/scripts/kernel/run_qemu_gapbs_sanity.sh
new file mode 100755
index 000000000..49e12d230
--- /dev/null
+++ b/scripts/kernel/run_qemu_gapbs_sanity.sh
@@ -0,0 +1,299 @@
+#!/usr/bin/env bash
+set -euo pipefail
+
+SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
+REPO_ROOT="$(cd "${SCRIPT_DIR}/../.." && pwd)"
+QEMU_TREE="${QEMU_TREE:-/Serverless/Migration-friendly/qemu}"
+LAUNCHER="${LAUNCHER:-${SCRIPT_DIR}/launch_kernel_qemu.sh}"
+GUEST_SCRIPT="${GUEST_SCRIPT:-${SCRIPT_DIR}/validate_gapbs_sanity.sh}"
+OUTDIR="${OUTDIR:-${SCRIPT_DIR}/qemu-logs/gapbs_sanity}"
+RUN_ID="${RUN_ID:-$(date -u +%Y%m%dT%H%M%SZ)}"
+SSH_PORT="${SSH_PORT:-10022}"
+SSH_KEY="${SSH_KEY:-${QEMU_TREE}/tests/keys/id_rsa}"
+SSH_USERS="${SSH_USERS:-root ubuntu}"
+SSH_PASSWORD="${SSH_PASSWORD:-}"
+SSH_EXPECT_TIMEOUT="${SSH_EXPECT_TIMEOUT:-600}"
+SSH_CONNECT_TIMEOUT="${SSH_CONNECT_TIMEOUT:-10}"
+SSH_SERVER_ALIVE_INTERVAL="${SSH_SERVER_ALIVE_INTERVAL:-30}"
+SSH_SERVER_ALIVE_COUNT_MAX="${SSH_SERVER_ALIVE_COUNT_MAX:-10}"
+SSH_KEY_RUNTIME="${SSH_KEY_RUNTIME:-${OUTDIR}/id_rsa}"
+SSH_OPTS_COMMON=(
+  -o BatchMode=yes
+  -o StrictHostKeyChecking=no
+  -o UserKnownHostsFile=/dev/null
+  -o ConnectTimeout="${SSH_CONNECT_TIMEOUT}"
+  -o ServerAliveInterval="${SSH_SERVER_ALIVE_INTERVAL}"
+  -o ServerAliveCountMax="${SSH_SERVER_ALIVE_COUNT_MAX}"
+)
+
+ROOTFS="${ROOTFS:-${SCRIPT_DIR}/vm-images/adaptive-migration-base.qcow2}"
+ROOTFS_FORMAT="${ROOTFS_FORMAT:-qcow2}"
+if [[ ! -f "${ROOTFS}" ]]; then
+  ROOTFS="${QEMU_TREE}/build/ubuntu.img"
+  ROOTFS_FORMAT="raw"
+fi
+DRIVE_IF="${DRIVE_IF:-virtio}"
+ROOT_DEVICE="${ROOT_DEVICE:-/dev/vda2}"
+KERNEL_DIR="${KERNEL_DIR:-${REPO_ROOT}}"
+KERNEL_IMAGE="${KERNEL_IMAGE:-${KERNEL_DIR}/arch/x86/boot/bzImage}"
+QEMU_BIN="${QEMU_BIN:-${QEMU_TREE}/build/qemu-system-x86_64}"
+MACHINE_TYPE="${MACHINE_TYPE:-q35}"
+NET_DEVICE="${NET_DEVICE:-virtio-net-pci}"
+MEMORY="${MEMORY:-16G}"
+CPUS="${CPUS:-4}"
+NUMA_NODE0_CPUS="${NUMA_NODE0_CPUS:-0-1}"
+NUMA_NODE0_MEM="${NUMA_NODE0_MEM:-8G}"
+NUMA_NODE1_MEM="${NUMA_NODE1_MEM:-8G}"
+VM_NAME="${VM_NAME:-gapbs-sanity}"
+CMDLINE="${CMDLINE:-console=ttyS0 root=${ROOT_DEVICE} rw loglevel=7 nokaslr}"
+HOST_LOG="${HOST_LOG:-${OUTDIR}/launch.log}"
+REMOTE_VALIDATION="/root/validate_gapbs_sanity.sh"
+REMOTE_OUTDIR="${REMOTE_OUTDIR:-/tmp/gapbs_sanity}"
+HOST_GAPBS_DIR="${HOST_GAPBS_DIR:-/Serverless/benchmark/gapbs}"
+HOST_BC="${HOST_BC:-${HOST_GAPBS_DIR}/bc}"
+HOST_PR="${HOST_PR:-${HOST_GAPBS_DIR}/pr}"
+UPLOAD_HOST_BINARIES="${UPLOAD_HOST_BINARIES:-auto}"
+REMOTE_BC="${REMOTE_BC:-/root/bc}"
+REMOTE_PR="${REMOTE_PR:-/root/pr}"
+VERIFY_PATHS="${VERIFY_PATHS:-${REMOTE_BC} ${REMOTE_PR}}"
+BC_CMD="${BC_CMD:-${REMOTE_BC} -g 20 -n 1}"
+PR_CMD="${PR_CMD:-${REMOTE_PR} -g 20 -i 2 -n 1 -t1e-4}"
+CPU_NODE="${CPU_NODE:-0}"
+MEM_NODE="${MEM_NODE:-1}"
+SAMPLE_SEC="${SAMPLE_SEC:-1}"
+BUILD_INITRD="${BUILD_INITRD:-auto}"
+KERNEL_LABEL="${KERNEL_LABEL:-$(basename "${KERNEL_DIR}")}"
+INITRD_IMAGE="${INITRD_IMAGE:-${SCRIPT_DIR}/kernel-artifacts/initramfs-${KERNEL_LABEL}.img}"
+BUILD_JOBS="${BUILD_JOBS:-1}"
+QEMU_EXTRA_ARGS="${QEMU_EXTRA_ARGS:-}"
+
+mkdir -p "${OUTDIR}"
+
+SSH_KEY_IS_TEMP=0
+if [[ "${SSH_KEY_RUNTIME}" != "${SSH_KEY}" ]]; then
+  install -m 600 "${SSH_KEY}" "${SSH_KEY_RUNTIME}"
+  SSH_KEY_IS_TEMP=1
+fi
+
+if [[ "${SSH_KEY_IS_TEMP}" == "1" ]]; then
+  SSH_KEY="${SSH_KEY_RUNTIME}"
+fi
+SSH_OPTS=("${SSH_OPTS_COMMON[@]}" -i "${SSH_KEY}")
+
+run_pexpect_cmd() {
+  python3 - "$SSH_PASSWORD" "$SSH_EXPECT_TIMEOUT" "$@" <<'PY'
+import sys
+import pexpect
+
+password = sys.argv[1]
+timeout = int(sys.argv[2])
+cmd = sys.argv[3:]
+child = pexpect.spawn(cmd[0], cmd[1:], encoding="utf-8", timeout=timeout)
+child.logfile = sys.stdout
+
+while True:
+    idx = child.expect([
+        r"Are you sure you want to continue connecting \(yes/no(/\[fingerprint\])?\)\?",
+        r"[Pp]assword:",
+        pexpect.EOF,
+        pexpect.TIMEOUT,
+    ])
+    if idx == 0:
+        child.sendline("yes")
+    elif idx == 1:
+        child.sendline(password)
+    elif idx == 2:
+        break
+    else:
+        raise SystemExit(124)
+
+child.close()
+raise SystemExit(child.exitstatus or 0)
+PY
+}
+
+ssh_run() {
+  if [[ -n "${SSH_PASSWORD}" ]]; then
+    run_pexpect_cmd ssh \
+      -o StrictHostKeyChecking=no \
+      -o UserKnownHostsFile=/dev/null \
+      -o ConnectTimeout="${SSH_CONNECT_TIMEOUT}" \
+      -o ServerAliveInterval="${SSH_SERVER_ALIVE_INTERVAL}" \
+      -o ServerAliveCountMax="${SSH_SERVER_ALIVE_COUNT_MAX}" \
+      -p "${SSH_PORT}" \
+      "$@"
+  else
+    ssh "${SSH_OPTS[@]}" -p "${SSH_PORT}" "$@"
+  fi
+}
+
+scp_run() {
+  if [[ -n "${SSH_PASSWORD}" ]]; then
+    run_pexpect_cmd scp \
+      -o StrictHostKeyChecking=no \
+      -o UserKnownHostsFile=/dev/null \
+      -o ConnectTimeout="${SSH_CONNECT_TIMEOUT}" \
+      -P "${SSH_PORT}" \
+      "$@"
+  else
+    scp "${SSH_OPTS[@]}" -P "${SSH_PORT}" "$@"
+  fi
+}
+
+cleanup() {
+  local rc=$?
+  if [[ "${SSH_KEY_IS_TEMP}" == "1" ]]; then
+    rm -f "${SSH_KEY_RUNTIME}" 2>/dev/null || true
+  fi
+  if [[ -n "${QEMU_PID:-}" ]] && kill -0 "${QEMU_PID}" 2>/dev/null; then
+    kill -INT "${QEMU_PID}" 2>/dev/null || true
+    wait "${QEMU_PID}" 2>/dev/null || true
+  fi
+  return "${rc}"
+}
+trap cleanup EXIT
+
+ensure_initrd() {
+  local build_flag=0
+  if [[ "${BUILD_INITRD}" == "1" ]]; then
+    build_flag=1
+  elif [[ "${BUILD_INITRD}" == "auto" && ! -f "${INITRD_IMAGE}" ]]; then
+    build_flag=1
+  fi
+
+  if [[ "${build_flag}" == "1" ]]; then
+    make -s -C "${KERNEL_DIR}" kernelrelease >/dev/null
+  fi
+
+  LAUNCH_ARGS=(
+    --rootfs "${ROOTFS}"
+    --rootfs-format "${ROOTFS_FORMAT}"
+    --drive-if "${DRIVE_IF}"
+    --root-device "${ROOT_DEVICE}"
+    --kernel-dir "${KERNEL_DIR}"
+    --kernel-image "${KERNEL_IMAGE}"
+    --qemu-bin "${QEMU_BIN}"
+    --machine "${MACHINE_TYPE}"
+    --net-device "${NET_DEVICE}"
+    --ssh-forward-port "${SSH_PORT}"
+    --memory "${MEMORY}"
+    --cpus "${CPUS}"
+    --numa-node0-cpus "${NUMA_NODE0_CPUS}"
+    --numa-node0-mem "${NUMA_NODE0_MEM}"
+    --numa-node1-mem "${NUMA_NODE1_MEM}"
+    --name "${VM_NAME}"
+    --cmdline "${CMDLINE}"
+  )
+
+  if [[ "${build_flag}" == "1" ]]; then
+    LAUNCH_ARGS+=( --build-initrd --initrd-name "$(basename "${INITRD_IMAGE}")" --build-jobs "${BUILD_JOBS}" )
+  elif [[ -f "${INITRD_IMAGE}" ]]; then
+    LAUNCH_ARGS+=( --initrd "${INITRD_IMAGE}" )
+  fi
+
+  if [[ -n "${QEMU_EXTRA_ARGS}" ]]; then
+    # shellcheck disable=SC2206
+    LAUNCH_ARGS+=( ${QEMU_EXTRA_ARGS} )
+  fi
+}
+
+launch_guest() {
+  ensure_initrd
+  echo "[host] launching QEMU"
+  echo "[host] log: ${HOST_LOG}"
+  "${LAUNCHER}" "${LAUNCH_ARGS[@]}" > "${HOST_LOG}" 2>&1 &
+  QEMU_PID=$!
+}
+
+wait_for_ssh() {
+  local deadline=$((SECONDS + 300))
+  local user
+
+  while (( SECONDS < deadline )); do
+    for user in ${SSH_USERS}; do
+      if ssh_run "${user}@127.0.0.1" "true" >/dev/null 2>&1; then
+        QEMU_SSH_USER="${user}"
+        return 0
+      fi
+    done
+    sleep 2
+  done
+
+  echo "timed out waiting for guest SSH on port ${SSH_PORT}" >&2
+  return 1
+}
+
+maybe_upload_binaries() {
+  local need_upload=0
+
+  if ssh_run "${QEMU_SSH_USER}@127.0.0.1" "test -x ${REMOTE_BC} && test -x ${REMOTE_PR}" >/dev/null 2>&1; then
+    return 0
+  fi
+
+  case "${UPLOAD_HOST_BINARIES}" in
+    1|true|yes|auto)
+      need_upload=1
+      ;;
+    *)
+      need_upload=0
+      ;;
+  esac
+
+  if [[ "${need_upload}" != "1" ]]; then
+    echo "guest benchmark binaries missing and uploads disabled" >&2
+    return 1
+  fi
+
+  if [[ ! -x "${HOST_BC}" || ! -x "${HOST_PR}" ]]; then
+    echo "host gapbs binaries not found: ${HOST_BC} ${HOST_PR}" >&2
+    return 1
+  fi
+
+  echo "[host] uploading gapbs binaries"
+  scp_run "${HOST_BC}" "${QEMU_SSH_USER}@127.0.0.1:${REMOTE_BC}"
+  scp_run "${HOST_PR}" "${QEMU_SSH_USER}@127.0.0.1:${REMOTE_PR}"
+  ssh_run "${QEMU_SSH_USER}@127.0.0.1" "chmod +x ${REMOTE_BC} ${REMOTE_PR}"
+}
+
+run_guest_validation() {
+  local remote_cmd
+  local kv
+
+  scp_run "${GUEST_SCRIPT}" "${QEMU_SSH_USER}@127.0.0.1:${REMOTE_VALIDATION}"
+  ssh_run "${QEMU_SSH_USER}@127.0.0.1" "chmod +x ${REMOTE_VALIDATION}"
+
+  remote_cmd="env"
+  for kv in \
+    "OUTDIR=${REMOTE_OUTDIR}" \
+    "BC_CMD=${BC_CMD}" \
+    "PR_CMD=${PR_CMD}" \
+    "CPU_NODE=${CPU_NODE}" \
+    "MEM_NODE=${MEM_NODE}" \
+    "SAMPLE_SEC=${SAMPLE_SEC}" \
+    "VERIFY_PATHS=${VERIFY_PATHS}"
+  do
+    remote_cmd+=" $(printf '%q' "${kv}")"
+  done
+  remote_cmd+=" bash $(printf '%q' "${REMOTE_VALIDATION}")"
+
+  echo "[host] running gapbs sanity in guest"
+  ssh_run "${QEMU_SSH_USER}@127.0.0.1" "${remote_cmd}"
+}
+
+collect_artifacts() {
+  local target="${OUTDIR}/guest-artifacts/${RUN_ID}-${VM_NAME}"
+  mkdir -p "${OUTDIR}/guest-artifacts"
+  rm -rf "${target}"
+  mkdir -p "${target}"
+  scp_run -r "${QEMU_SSH_USER}@127.0.0.1:${REMOTE_OUTDIR}" "${target}/" >/dev/null
+  echo "[host] collected artifacts at ${target}"
+}
+
+launch_guest
+wait_for_ssh
+echo "[host] guest SSH ready as ${QEMU_SSH_USER}"
+maybe_upload_binaries
+run_guest_validation
+collect_artifacts
+ssh_run "${QEMU_SSH_USER}@127.0.0.1" "sudo -n poweroff" >/dev/null 2>&1 || \
+  ssh_run "${QEMU_SSH_USER}@127.0.0.1" "poweroff" >/dev/null 2>&1 || true
diff --git a/scripts/kernel/run_qemu_memcg_mode_compare_validation.sh b/scripts/kernel/run_qemu_memcg_mode_compare_validation.sh
new file mode 100755
index 000000000..a80dc2d16
--- /dev/null
+++ b/scripts/kernel/run_qemu_memcg_mode_compare_validation.sh
@@ -0,0 +1,305 @@
+#!/usr/bin/env bash
+set -euo pipefail
+
+# Host-side QEMU launcher for the memcg mode=1 vs mode=2 validation wave.
+# Boots the guest, waits for SSH, uploads the existing single-tenant runner,
+# and executes a serial matrix across bc/pr and NUMA balancing off/on.
+
+SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
+REPO_ROOT="$(cd "${SCRIPT_DIR}/../.." && pwd)"
+QEMU_TREE="${QEMU_TREE:-/Serverless/Migration-friendly/qemu}"
+LAUNCHER="${LAUNCHER:-${SCRIPT_DIR}/launch_kernel_qemu.sh}"
