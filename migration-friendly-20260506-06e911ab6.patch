+#!/usr/bin/env bash
+set -euo pipefail
+
+usage() {
+  cat <<'EOF'
+Usage:
+  launch_kernel_qemu.sh [options]
+
+Default rootfs:
+  If --rootfs is omitted, use scripts/kernel/vm-images/adaptive-migration-base.qcow2
+  when present, otherwise fall back to /Serverless/Migration-friendly/qemu/build/ubuntu.img.
+
+Optional:
+  --drive-if <type>        Disk interface: virtio|ide|scsi (default: virtio)
+  --root-device <path>     Root device passed to kernel (default: /dev/vda2)
+  --kernel-dir <path>      Kernel source/build directory (default: this repo root)
+  --kernel-image <path>    Kernel image path (default: <kernel-dir>/arch/x86/boot/bzImage)
+  --rootfs-format <fmt>    Rootfs format: qcow2|raw (default: raw)
+  --initrd <path>          Initramfs path (auto: scripts/kernel/kernel-artifacts/initramfs-<krel>.img if exists)
+  --build-initrd           Build kernel/modules and generate initramfs via dracut
+  --artifact-dir <path>    Build artifacts directory (default: scripts/kernel/kernel-artifacts)
+  --build-jobs <n>         Parallel build jobs for kernel build (default: nproc)
+  --strip-modules          Use INSTALL_MOD_STRIP=1 for modules_install (default)
+  --no-strip-modules       Disable module stripping
+  --dracut-bin <path>      dracut binary (default: dracut)
+  --hostonly               Build host-only initramfs (default: disabled)
+  --initrd-name <name>     Output initrd filename when --build-initrd is used
+  --qemu-bin <path>        QEMU binary (default: /Serverless/Migration-friendly/qemu/build/qemu-system-x86_64)
+  --machine <type>         QEMU machine type (default: q35)
+  --net-device <name>      NIC model: virtio-net-pci|e1000|rtl8139 (default: virtio-net-pci)
+  --ssh-forward-port <p>   Host TCP port forwarded to guest 22 (default: 10022)
+  --memory <size>          Guest memory (default: 128G)
+  --cpus <count>           vCPU count (default: 16)
+  --host-cpus <list>       Pin the QEMU process to host CPU list via taskset
+
+  --numa-node0-cpus <r>    vCPU range for guest NUMA node0 (default: 0-15)
+  --numa-node0-mem <size>  Guest NUMA node0 memory (default: 64G)
+  --numa-node1-mem <size>  Guest NUMA node1 memory (default: 64G)
+  --numa-node0-host-nodes <list>
+                            Bind guest node0 memory backend to host NUMA node list
+  --numa-node1-host-nodes <list>
+                            Bind guest node1 memory backend to host NUMA node list
+  --numa-mem-policy <p>    Host NUMA policy for bound memory backends (default: bind)
+  --numa-prealloc          Preallocate NUMA memory backends at launch
+  --no-numa-layout         Disable default NUMA layout injection
+  --cmdline <string>       Extra/override kernel cmdline
+  --name <string>          VM name prefix (default: linux-test)
+  --no-kvm                 Disable KVM even if available
+  --gdb                    Start paused and open gdbstub at tcp::1234
+  --daemonize              Run QEMU detached in the background
+  --dry-run                Print command only, do not execute
+  -h, --help               Show this help
+
+Examples:
+  ./scripts/kernel/launch_kernel_qemu.sh --rootfs /vm/ubuntu.qcow2
+  ./scripts/kernel/launch_kernel_qemu.sh --rootfs /vm/ubuntu.qcow2 --gdb --cpus 16 --memory 64G
+EOF
+}
+
+SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
+REPO_ROOT="$(cd "${SCRIPT_DIR}/../.." && pwd)"
+QEMU_TREE_DEFAULT="${QEMU_TREE_DEFAULT:-/Serverless/Migration-friendly/qemu}"
+SHARED_ROOTFS_DEFAULT="${SHARED_ROOTFS_DEFAULT:-${QEMU_TREE_DEFAULT}/build/ubuntu.img}"
+LOCAL_OVERLAY_ROOTFS_DEFAULT="${LOCAL_OVERLAY_ROOTFS_DEFAULT:-${SCRIPT_DIR}/vm-images/adaptive-migration-base.qcow2}"
+
+KERNEL_DIR="${REPO_ROOT}"
+KERNEL_IMAGE=""
+ROOTFS_IMAGE="${LOCAL_OVERLAY_ROOTFS_DEFAULT}"
+ROOTFS_FORMAT="qcow2"
+DRIVE_IF="virtio"
+ROOT_DEVICE="/dev/vda2"
+INITRD_IMAGE=""
+BUILD_INITRD="0"
+ARTIFACT_DIR="${SCRIPT_DIR}/kernel-artifacts"
+BUILD_JOBS="$(nproc)"
+STRIP_MODULES="1"
+DRACUT_BIN="dracut"
+HOSTONLY="0"
+INITRD_NAME=""
+QEMU_BIN="${QEMU_TREE_DEFAULT}/build/qemu-system-x86_64"
+MACHINE_TYPE="q35"
+NET_DEVICE="virtio-net-pci"
+SSH_FORWARD_PORT="10022"
+MEMORY="128G"
+CPUS="16"
+HOST_CPUS=""
+NUMA_NODE0_CPUS="0-15"
+NUMA_NODE0_MEM="64G"
+NUMA_NODE1_MEM="64G"
+NUMA_NODE0_HOST_NODES=""
+NUMA_NODE1_HOST_NODES=""
+NUMA_MEM_POLICY="bind"
+NUMA_PREALLOC="0"
+ENABLE_NUMA_LAYOUT="1"
+VM_NAME="linux-test"
+USE_KVM="auto"
+ENABLE_GDB="0"
+DAEMONIZE="0"
+DRY_RUN="0"
+
+DEFAULT_CMDLINE='console=ttyS0 root=/dev/vda2 rw loglevel=7 nokaslr'
+CMDLINE=""
+
+while [[ $# -gt 0 ]]; do
+  case "$1" in
+    --rootfs)
+      ROOTFS_IMAGE="${2:-}"; shift 2 ;;
+    --kernel-dir)
+      KERNEL_DIR="${2:-}"; shift 2 ;;
+    --kernel-image)
+      KERNEL_IMAGE="${2:-}"; shift 2 ;;
+    --rootfs-format)
+      ROOTFS_FORMAT="${2:-}"; shift 2 ;;
+    --drive-if)
+      DRIVE_IF="${2:-}"; shift 2 ;;
+    --root-device)
+      ROOT_DEVICE="${2:-}"; shift 2 ;;
+    --initrd)
+      INITRD_IMAGE="${2:-}"; shift 2 ;;
+    --build-initrd)
+      BUILD_INITRD="1"; shift ;;
+    --artifact-dir)
+      ARTIFACT_DIR="${2:-}"; shift 2 ;;
+    --build-jobs)
+      BUILD_JOBS="${2:-}"; shift 2 ;;
+    --strip-modules)
+      STRIP_MODULES="1"; shift ;;
+    --no-strip-modules)
+      STRIP_MODULES="0"; shift ;;
+    --dracut-bin)
+      DRACUT_BIN="${2:-}"; shift 2 ;;
+    --hostonly)
+      HOSTONLY="1"; shift ;;
+    --initrd-name)
+      INITRD_NAME="${2:-}"; shift 2 ;;
+    --qemu-bin)
+      QEMU_BIN="${2:-}"; shift 2 ;;
+    --machine)
+      MACHINE_TYPE="${2:-}"; shift 2 ;;
+    --net-device)
+      NET_DEVICE="${2:-}"; shift 2 ;;
+    --ssh-forward-port)
+      SSH_FORWARD_PORT="${2:-}"; shift 2 ;;
+    --memory)
+      MEMORY="${2:-}"; shift 2 ;;
+    --cpus)
+      CPUS="${2:-}"; shift 2 ;;
+    --host-cpus)
+      HOST_CPUS="${2:-}"; shift 2 ;;
+    --numa-node0-cpus)
+      NUMA_NODE0_CPUS="${2:-}"; shift 2 ;;
+    --numa-node0-mem)
+      NUMA_NODE0_MEM="${2:-}"; shift 2 ;;
+    --numa-node1-mem)
+      NUMA_NODE1_MEM="${2:-}"; shift 2 ;;
+    --numa-node0-host-nodes)
+      NUMA_NODE0_HOST_NODES="${2:-}"; shift 2 ;;
+    --numa-node1-host-nodes)
+      NUMA_NODE1_HOST_NODES="${2:-}"; shift 2 ;;
+    --numa-mem-policy)
+      NUMA_MEM_POLICY="${2:-}"; shift 2 ;;
+    --numa-prealloc)
+      NUMA_PREALLOC="1"; shift ;;
+    --no-numa-layout)
+      ENABLE_NUMA_LAYOUT="0"; shift ;;
+    --cmdline)
+      CMDLINE="${2:-}"; shift 2 ;;
+    --name)
+      VM_NAME="${2:-}"; shift 2 ;;
+    --no-kvm)
+      USE_KVM="0"; shift ;;
+    --gdb)
+      ENABLE_GDB="1"; shift ;;
+    --daemonize)
+      DAEMONIZE="1"; shift ;;
+    --dry-run)
+      DRY_RUN="1"; shift ;;
+    -h|--help)
+      usage; exit 0 ;;
+    *)
+      echo "Unknown option: $1" >&2
+      usage
+      exit 1 ;;
+  esac
+done
+
+run_cmd() {
+  printf '+ '
+  printf '%q ' "$@"
+  printf '\n'
+  if [[ "${DRY_RUN}" == "0" ]]; then
+    "$@"
+  fi
+}
+
+if [[ -z "${KERNEL_IMAGE}" ]]; then
+  KERNEL_IMAGE="${KERNEL_DIR}/arch/x86/boot/bzImage"
+fi
+
+if [[ "${ROOTFS_IMAGE}" == "${LOCAL_OVERLAY_ROOTFS_DEFAULT}" && ! -f "${ROOTFS_IMAGE}" ]]; then
+  ROOTFS_IMAGE="${SHARED_ROOTFS_DEFAULT}"
+  ROOTFS_FORMAT="raw"
+fi
+
+if [[ -z "${INITRD_IMAGE}" ]]; then
+  KREL_DETECT="$(make -s -C "${KERNEL_DIR}" kernelrelease 2>/dev/null || true)"
+  if [[ -n "${KREL_DETECT}" ]]; then
+    AUTO_INITRD="${SCRIPT_DIR}/kernel-artifacts/initramfs-${KREL_DETECT}.img"
+    if [[ -f "${AUTO_INITRD}" ]]; then
+      INITRD_IMAGE="${AUTO_INITRD}"
+    fi
+  fi
+fi
+
+if [[ ! -f "${ROOTFS_IMAGE}" ]]; then
+  echo "Error: rootfs image not found: ${ROOTFS_IMAGE}" >&2
+  exit 1
+fi
+
+if [[ "${ROOTFS_FORMAT}" != "qcow2" && "${ROOTFS_FORMAT}" != "raw" ]]; then
+  echo "Error: --rootfs-format must be one of: qcow2, raw" >&2
+  exit 1
+fi
+
+if [[ "${DRIVE_IF}" != "virtio" && "${DRIVE_IF}" != "ide" && "${DRIVE_IF}" != "scsi" ]]; then
+  echo "Error: --drive-if must be one of: virtio, ide, scsi" >&2
+  exit 1
+fi
+
+if ! [[ "${SSH_FORWARD_PORT}" =~ ^[0-9]+$ ]] || (( SSH_FORWARD_PORT < 1 || SSH_FORWARD_PORT > 65535 )); then
+  echo "Error: --ssh-forward-port must be an integer in range 1..65535" >&2
+  exit 1
+fi
+
+if ! command -v "${QEMU_BIN}" >/dev/null 2>&1; then
+  echo "Error: qemu binary not found in PATH: ${QEMU_BIN}" >&2
+  echo "Hint: pass --qemu-bin /path/to/qemu-system-x86_64" >&2
+  exit 1
+fi
+
+if [[ "${NET_DEVICE}" != "virtio-net-pci" && "${NET_DEVICE}" != "e1000" && "${NET_DEVICE}" != "rtl8139" ]]; then
+  echo "Error: --net-device must be one of: virtio-net-pci, e1000, rtl8139" >&2
+  exit 1
+fi
+
+if [[ -n "${HOST_CPUS}" ]] && ! command -v taskset >/dev/null 2>&1; then
+  echo "Error: --host-cpus requires taskset" >&2
+  exit 1
+fi
+
+if [[ "${NUMA_MEM_POLICY}" != "bind" &&
+      "${NUMA_MEM_POLICY}" != "preferred" &&
+      "${NUMA_MEM_POLICY}" != "interleave" &&
+      "${NUMA_MEM_POLICY}" != "default" ]]; then
+  echo "Error: --numa-mem-policy must be one of: bind, preferred, interleave, default" >&2
+  exit 1
+fi
+
+if [[ -z "${CMDLINE}" ]]; then
+  CMDLINE="console=ttyS0 root=${ROOT_DEVICE} rw loglevel=7 nokaslr"
+fi
+
+if ! [[ "${CPUS}" =~ ^[0-9]+$ ]] || (( CPUS < 1 )); then
+  echo "Error: --cpus must be a positive integer" >&2
+  exit 1
+fi
+
+if [[ "${ENABLE_NUMA_LAYOUT}" == "1" ]]; then
+  if [[ "${NUMA_NODE0_CPUS}" =~ ^([0-9]+)-([0-9]+)$ ]]; then
+    NUMA_NODE0_CPU_END="${BASH_REMATCH[2]}"
+    if (( NUMA_NODE0_CPU_END >= CPUS )); then
