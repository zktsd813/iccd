+#!/usr/bin/env bash
+set -euo pipefail
+
+# Usage: tenant_a_cmd.sh [MiB] [seconds]
+MIB="${1:-6144}"
+SECONDS_HOLD="${2:-120}"
+
+exec python3 - "$MIB" "$SECONDS_HOLD" <<'PY'
+import sys
+import time
+
+mib = int(sys.argv[1])
+hold = int(sys.argv[2])
+size = mib * 1024 * 1024
+
+buf = bytearray(size)
+step = 4096
+for i in range(0, size, step):
+    buf[i] = (i // step) & 0xFF
+
