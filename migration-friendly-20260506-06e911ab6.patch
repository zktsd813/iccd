+    const size_t vec_end = elements & ~((size_t)3);
+
+    for (; i < vec_end; i += 4) {
+        __m256d v = _mm256_loadu_pd(src + i);
+        sumv = _mm256_add_pd(sumv, v);
+    }
+
+    double checksum = mbench_reduce_avx2(sumv);
+    for (; i < elements; ++i) {
+        checksum += src[i];
+    }
+
