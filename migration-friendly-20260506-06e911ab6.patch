@@ -0,0 +1,538 @@
+#!/usr/bin/env bash
+set -euo pipefail
+
+SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
+LOCAL_BASE_ROOTFS="${SCRIPT_DIR}/vm-images/adaptive-migration-base.qcow2"
+SHARED_BASE_ROOTFS="/Serverless/Migration-friendly/qemu/build/ubuntu.img"
+
+BASE_ROOTFS="${BASE_ROOTFS:-${LOCAL_BASE_ROOTFS}}"
+BASE_ROOTFS_FORMAT="${BASE_ROOTFS_FORMAT:-qcow2}"
+OVERLAY_IMAGE="${OVERLAY_IMAGE:-${SCRIPT_DIR}/vm-images/adaptive-migration-paper-workloads.qcow2}"
+QEMU_IMG_BIN="${QEMU_IMG_BIN:-qemu-img}"
+NBD_DEVICE="${NBD_DEVICE:-/dev/nbd0}"
+MOUNT_DIR="${MOUNT_DIR:-/tmp/adaptive-migration-paper-workloads-root}"
+FORCE="${FORCE:-0}"
+INCLUDE_LIBLINEAR_KDD12="${INCLUDE_LIBLINEAR_KDD12:-1}"
+
+NBD_ACTIVE=0
+MOUNT_ACTIVE=0
+ROOT_MAPPER=""
+
+usage() {
+  cat <<'EOF'
+Usage:
+  prepare_paper_workloads_overlay.sh [--force]
+
+Creates or refreshes a qcow2 overlay with the paper workloads copied into the
+guest filesystem.
+
+Defaults:
+  base rootfs  : scripts/kernel/vm-images/adaptive-migration-base.qcow2
+  output image : scripts/kernel/vm-images/adaptive-migration-paper-workloads.qcow2
+
+Environment:
+  BASE_ROOTFS                Override the base rootfs path
+  BASE_ROOTFS_FORMAT         raw|qcow2 (auto-falls back to raw for *.img)
+  OVERLAY_IMAGE              Output qcow2 path
+  NBD_DEVICE                 NBD device used for mounting (default: /dev/nbd0)
+  INCLUDE_LIBLINEAR_KDD12    1 to copy the 21G kdd12 dataset, 0 to skip
+EOF
+}
+
+if [[ "${1:-}" == "--force" ]]; then
+  FORCE=1
+elif [[ "${1:-}" == "-h" || "${1:-}" == "--help" ]]; then
+  usage
+  exit 0
+elif [[ $# -gt 0 ]]; then
+  echo "unknown argument: $1" >&2
+  usage >&2
+  exit 1
+fi
+
+if [[ "${BASE_ROOTFS}" == *.img ]]; then
+  BASE_ROOTFS_FORMAT="raw"
+fi
+
+sudo_run() {
+  sudo -n "$@"
+}
+
+cleanup() {
+  local rc=$?
+  if [[ "${MOUNT_ACTIVE}" == "1" ]]; then
+    sudo_run umount "${MOUNT_DIR}" || true
+  fi
+  if [[ -n "${ROOT_MAPPER}" ]]; then
+    sudo_run kpartx -d "${NBD_DEVICE}" >/dev/null || true
+  fi
+  if [[ "${NBD_ACTIVE}" == "1" ]]; then
+    sudo_run qemu-nbd --disconnect "${NBD_DEVICE}" >/dev/null || true
+  fi
+  return "${rc}"
+}
+trap cleanup EXIT
+
+ensure_base_rootfs() {
+  if [[ -f "${BASE_ROOTFS}" ]]; then
+    return 0
+  fi
+
+  if [[ "${BASE_ROOTFS}" == "${LOCAL_BASE_ROOTFS}" ]]; then
+    "${SCRIPT_DIR}/prepare_rootfs_overlay.sh"
+  fi
+
+  if [[ ! -f "${BASE_ROOTFS}" ]]; then
+    if [[ -f "${SHARED_BASE_ROOTFS}" ]]; then
+      BASE_ROOTFS="${SHARED_BASE_ROOTFS}"
+      BASE_ROOTFS_FORMAT="raw"
+    else
+      echo "base rootfs not found: ${BASE_ROOTFS}" >&2
+      exit 1
+    fi
+  fi
+}
+
+prepare_overlay() {
+  mkdir -p "$(dirname "${OVERLAY_IMAGE}")"
+
+  if [[ ! -f "${OVERLAY_IMAGE}" || "${FORCE}" == "1" ]]; then
+    rm -f "${OVERLAY_IMAGE}"
+    "${QEMU_IMG_BIN}" create -f qcow2 -F "${BASE_ROOTFS_FORMAT}" -b "${BASE_ROOTFS}" "${OVERLAY_IMAGE}" >/dev/null
+  fi
+}
+
+mount_overlay() {
+  sudo_run qemu-nbd --disconnect "${NBD_DEVICE}" >/dev/null 2>&1 || true
+  sudo_run qemu-nbd --connect="${NBD_DEVICE}" "${OVERLAY_IMAGE}"
+  NBD_ACTIVE=1
+  sleep 1
+  sudo_run kpartx -av "${NBD_DEVICE}" >/dev/null
+  ROOT_MAPPER="/dev/mapper/$(basename "${NBD_DEVICE}")p2"
+  sudo_run mkdir -p "${MOUNT_DIR}"
+  sudo_run mount "${ROOT_MAPPER}" "${MOUNT_DIR}"
+  MOUNT_ACTIVE=1
+}
+
+copy_dir() {
+  local src="$1"
+  local dst_rel="$2"
+  local dst="${MOUNT_DIR}/${dst_rel}"
+
+  sudo_run mkdir -p "$(dirname "${dst}")"
+  sudo_run rsync -a --delete "${src%/}/" "${dst}/"
+}
+
+copy_file() {
+  local src="$1"
+  local dst_rel="$2"
+  local dst="${MOUNT_DIR}/${dst_rel}"
+
+  sudo_run install -D -m 0644 "${src}" "${dst}"
+}
+
+copy_exec() {
+  local src="$1"
+  local dst_rel="$2"
+  local dst="${MOUNT_DIR}/${dst_rel}"
+
+  sudo_run install -D -m 0755 "${src}" "${dst}"
+}
+
+install_shared_libs() {
+  local libdir="${MOUNT_DIR}/Serverless/benchmark/paper-workloads/lib"
+
+  sudo_run install -d -m 0755 "${libdir}"
+  sudo_run install -m 0644 /Serverless/benchmark/silo/third-party/lz4/liblz4.so "${libdir}/liblz4.so"
+  sudo_run install -m 0644 /lib/x86_64-linux-gnu/libdb_cxx-5.3.so "${libdir}/libdb_cxx-5.3.so"
+  sudo_run install -m 0644 /lib/x86_64-linux-gnu/libjemalloc.so.2 "${libdir}/libjemalloc.so.2"
+  sudo_run install -m 0644 /lib/x86_64-linux-gnu/libnuma.so.1.0.0 "${libdir}/libnuma.so.1.0.0"
+  sudo_run install -m 0644 /lib/x86_64-linux-gnu/libgomp.so.1.0.0 "${libdir}/libgomp.so.1.0.0"
+  sudo_run ln -sfn libjemalloc.so.2 "${libdir}/libjemalloc.so"
+  sudo_run ln -sfn libnuma.so.1.0.0 "${libdir}/libnuma.so.1"
+  sudo_run ln -sfn libnuma.so.1.0.0 "${libdir}/libnuma.so"
+  sudo_run ln -sfn libgomp.so.1.0.0 "${libdir}/libgomp.so.1"
+}
+
+install_benchmark_tree() {
+  sudo_run install -d -m 0755 \
+    "${MOUNT_DIR}/Serverless/benchmark" \
+    "${MOUNT_DIR}/Serverless/Migration-friendly/Microbenchmark/docs" \
+    "${MOUNT_DIR}/Serverless/benchmark/paper-workloads/bin"
+
+  copy_dir /Serverless/benchmark/gapbs Serverless/benchmark/gapbs
+  copy_dir /Serverless/benchmark/vmitosis-workloads/bin Serverless/benchmark/vmitosis-workloads/bin
+  copy_dir /Serverless/benchmark/NPB3.4.3/NPB3.4-OMP/bin Serverless/benchmark/NPB3.4.3/NPB3.4-OMP/bin
+  copy_dir /Serverless/benchmark/silo/out-perf.masstree Serverless/benchmark/silo/out-perf.masstree
+  copy_dir /Serverless/benchmark/silo/third-party/lz4 Serverless/benchmark/silo/third-party/lz4
+
+  copy_exec /Serverless/benchmark/liblinear-multicore-2.47/train Serverless/benchmark/liblinear-multicore-2.47/train
+  copy_exec /Serverless/benchmark/liblinear-multicore-2.47/predict Serverless/benchmark/liblinear-multicore-2.47/predict
+  copy_file /Serverless/benchmark/liblinear-multicore-2.47/README Serverless/benchmark/liblinear-multicore-2.47/README
+  copy_file /Serverless/benchmark/liblinear-multicore-2.47/heart_scale Serverless/benchmark/liblinear-multicore-2.47/heart_scale
+  copy_file /Serverless/benchmark/liblinear-multicore-2.47/test_script.sh Serverless/benchmark/liblinear-multicore-2.47/test_script.sh
+
+  if [[ "${INCLUDE_LIBLINEAR_KDD12}" == "1" ]]; then
+    copy_file /Serverless/benchmark/liblinear-multicore-2.47/datasets/kdd12 \
+      Serverless/benchmark/liblinear-multicore-2.47/datasets/kdd12
+  fi
+
+  copy_exec /Serverless/Migration-friendly/Microbenchmark/mbench \
+    Serverless/Migration-friendly/Microbenchmark/mbench
+  copy_file /Serverless/Migration-friendly/Microbenchmark/README.md \
+    Serverless/Migration-friendly/Microbenchmark/README.md
+  copy_file /Serverless/Migration-friendly/Microbenchmark/docs/workload-presets.md \
+    Serverless/Migration-friendly/Microbenchmark/docs/workload-presets.md
+
+  copy_file /Serverless/iccd/CXL-migration.paper/5.Evaluation.tex \
+    Serverless/benchmark/paper-workloads/5.Evaluation.tex
+  copy_file /Serverless/iccd/CXL-migration.paper/table/table.tex \
+    Serverless/benchmark/paper-workloads/table.tex
+
+  install_shared_libs
+}
+
+install_guest_helpers() {
+  sudo_run tee "${MOUNT_DIR}/Serverless/benchmark/paper-workloads/bin/paper-workload" >/dev/null <<'EOF'
+#!/usr/bin/env bash
+set -euo pipefail
+
+ROOT_BENCH=/Serverless/benchmark
+ROOT_MB=/Serverless/Migration-friendly/Microbenchmark
+LIBDIR=/Serverless/benchmark/paper-workloads/lib
+SELF=/Serverless/benchmark/paper-workloads/bin/paper-workload
+export LD_LIBRARY_PATH="${LIBDIR}${LD_LIBRARY_PATH:+:${LD_LIBRARY_PATH}}"
+
+usage() {
+  cat <<'USAGE'
+Usage:
+  paper-workload --list
+  paper-workload <name> [extra args...]
+  paper-workload pair <pair-name> [start-offset-sec]
+
+Single-tenant workload names:
+  pr
+  bc
+  gups-st
+  gups-mt
+  silo
+  liblinear-heart-scale
+  liblinear-kdd12
+  ft
+  lu
+  sp
+
+Surrogate microbenchmark names:
+  mbench-pr
+  mbench-bc
+  mbench-gups
+  mbench-silo
+  mbench-liblinear
+  mbench-ft
+  mbench-lu
+  mbench-sp
+  mbench-paper-micro
+
+Pair names:
+  liblinear-ft
+  liblinear-sp
+  silo-ft
+  gups-sp
+  silo-gups
+  pr-gups
+USAGE
+}
+
+run_pair() {
+  local pair="$1"
+  local offset="${2:-30}"
+  local cmd_a=""
+  local cmd_b=""
+
+  case "${pair}" in
+    liblinear-ft)
+      cmd_a="${SELF} liblinear-kdd12"
+      cmd_b="${SELF} ft"
+      ;;
+    liblinear-sp)
+      cmd_a="${SELF} liblinear-kdd12"
+      cmd_b="OMP_NUM_THREADS=9 ${SELF} sp"
+      ;;
+    silo-ft)
+      cmd_a="${SELF} silo"
+      cmd_b="${SELF} ft"
+      ;;
+    gups-sp)
+      cmd_a="${SELF} gups-mt"
+      cmd_b="OMP_NUM_THREADS=12 ${SELF} sp"
+      ;;
+    silo-gups)
+      cmd_a="${SELF} silo"
+      cmd_b="${SELF} gups-mt"
+      ;;
+    pr-gups)
+      cmd_a="OMP_NUM_THREADS=12 ${SELF} pr"
+      cmd_b="${SELF} gups-mt"
+      ;;
+    *)
+      echo "unknown pair: ${pair}" >&2
+      usage >&2
+      return 1
+      ;;
+  esac
+
+  bash -lc "${cmd_a}" &
+  local pid_a=$!
+  sleep "${offset}"
+  bash -lc "${cmd_b}"
+  wait "${pid_a}"
+}
+
+if [[ $# -eq 0 ]]; then
+  usage >&2
+  exit 1
+fi
+
+case "$1" in
+  --list|-l|-h|--help)
+    usage
+    exit 0
+    ;;
+  pair)
+    shift
+    run_pair "${1:-}" "${2:-30}"
+    exit 0
+    ;;
+  pr)
+    shift
+    exec env OMP_NUM_THREADS="${OMP_NUM_THREADS:-12}" \
+      "${ROOT_BENCH}/gapbs/pr" -g "${GRAPH_SCALE:-20}" -i "${PR_ITERS:-2}" -n "${TRIALS:-1}" -t "${PR_TOL:-1e-4}" "$@"
+    ;;
+  bc)
+    shift
+    exec env OMP_NUM_THREADS="${OMP_NUM_THREADS:-12}" \
+      "${ROOT_BENCH}/gapbs/bc" -g "${GRAPH_SCALE:-20}" -n "${TRIALS:-1}" "$@"
+    ;;
+  gups-st)
+    shift
+    exec "${ROOT_BENCH}/vmitosis-workloads/bin/bench_gups_st" -m "${MEM_GB:-64}" "$@"
+    ;;
+  gups-mt)
+    shift
+    exec "${ROOT_BENCH}/vmitosis-workloads/bin/bench_gups_mt" -m "${MEM_GB:-64}" "$@"
+    ;;
+  silo)
+    shift
+    exec env LD_LIBRARY_PATH="${LIBDIR}${LD_LIBRARY_PATH:+:${LD_LIBRARY_PATH}}" \
+      "${ROOT_BENCH}/silo/out-perf.masstree/benchmarks/dbtest" \
+      --verbose \
+      --bench tpcc \
+      --num-threads "${SILO_THREADS:-1}" \
+      --scale-factor "${SILO_SCALE_FACTOR:-64}" \
+      --runtime "${SILO_RUNTIME:-30}" \
+      --numa-memory "${SILO_NUMA_MEMORY:-64G}" \
+      "$@"
+    ;;
+  liblinear-heart-scale)
+    shift
+    cd "${ROOT_BENCH}/liblinear-multicore-2.47"
+    exec ./train -s "${LIBLINEAR_SOLVER:-6}" -m "${LIBLINEAR_THREADS:-16}" heart_scale "$@"
+    ;;
+  liblinear-kdd12)
+    shift
+    cd "${ROOT_BENCH}/liblinear-multicore-2.47"
+    exec ./train -s "${LIBLINEAR_SOLVER:-6}" -m "${LIBLINEAR_THREADS:-16}" datasets/kdd12 "$@"
+    ;;
+  ft)
+    shift
+    exec env OMP_NUM_THREADS="${OMP_NUM_THREADS:-24}" \
+      "${ROOT_BENCH}/NPB3.4.3/NPB3.4-OMP/bin/ft.H.x" "$@"
+    ;;
+  lu)
+    shift
+    exec env OMP_NUM_THREADS="${OMP_NUM_THREADS:-24}" \
+      "${ROOT_BENCH}/NPB3.4.3/NPB3.4-OMP/bin/lu.H.x" "$@"
+    ;;
+  sp)
+    shift
+    exec env OMP_NUM_THREADS="${OMP_NUM_THREADS:-24}" \
+      "${ROOT_BENCH}/NPB3.4.3/NPB3.4-OMP/bin/sp.H.x" "$@"
+    ;;
+  mbench-pr)
+    shift
+    exec "${ROOT_MB}/mbench" --mode irregular-index --threads "${THREADS:-4}" \
+      --index-kernel gather --index-distribution segmented \
+      --index-segments 16 --index-segment-span-ops 8192 \
+      --arena-size "${ARENA:-16G}" --window-size "${WINDOW:-8G}" \
+      --move-policy sweep --move-step 512M --move-interval-ms 1000 \
+      --ops-per-pass 65536 --pause-ns 100000 --duration "${DURATION:-10}" --sample-ms "${SAMPLE_MS:-1000}" \
+      "$@"
+    ;;
+  mbench-bc)
+    shift
+    exec "${ROOT_MB}/mbench" --mode irregular-index --threads "${THREADS:-4}" \
+      --index-kernel gather --index-distribution clustered \
+      --index-cluster-size 8M --index-cluster-span-ops 4096 \
+      --arena-size "${ARENA:-16G}" --window-size "${WINDOW:-8G}" \
+      --move-policy sweep --move-step 512M --move-interval-ms 1000 \
+      --ops-per-pass 65536 --pause-ns 100000 --duration "${DURATION:-10}" --sample-ms "${SAMPLE_MS:-1000}" \
+      "$@"
+    ;;
+  mbench-gups)
+    shift
+    exec "${ROOT_MB}/mbench" --mode irregular-index --threads "${THREADS:-4}" \
+      --index-kernel rmw --index-distribution uniform \
+      --arena-size "${ARENA:-64G}" --window-size "${WINDOW:-32G}" \
+      --move-policy random --move-step 512M --move-interval-ms 1000 \
+      --ops-per-pass 65536 --pause-ns 0 --duration "${DURATION:-10}" --sample-ms "${SAMPLE_MS:-1000}" \
+      "$@"
+    ;;
+  mbench-silo)
+    shift
+    exec "${ROOT_MB}/mbench" --mode skewed-hotset --threads "${THREADS:-4}" \
+      --hotset-pages 65536 --hot-prob-pct 95 \
+      --hotset-read-pct 100 --hotset-write-pct 0 --hotset-rmw-pct 0 \
+      --arena-size "${ARENA:-16G}" --window-size "${WINDOW:-4G}" \
+      --move-policy random --move-step 64M --move-interval-ms 1000 \
+      --ops-per-pass 65536 --pause-ns 100000 --duration "${DURATION:-10}" --sample-ms "${SAMPLE_MS:-1000}" \
+      "$@"
+    ;;
+  mbench-liblinear)
+    shift
+    exec "${ROOT_MB}/mbench" --mode irregular-index --threads "${THREADS:-4}" \
+      --index-kernel rmw --index-distribution zipf --index-zipf-alpha 1.1 \
+      --arena-size "${ARENA:-16G}" --window-size "${WINDOW:-8G}" \
+      --move-policy fixed \
+      --ops-per-pass 65536 --pause-ns 100000 --duration "${DURATION:-10}" --sample-ms "${SAMPLE_MS:-1000}" \
+      "$@"
+    ;;
