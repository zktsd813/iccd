new file mode 100755
index 000000000..b63663bac
--- /dev/null
+++ b/scripts/kernel/validate_adaptive_migration_smoke.sh
@@ -0,0 +1,181 @@
+#!/usr/bin/env bash
+set -euo pipefail
+
+if [[ "${EUID}" -ne 0 ]]; then
+  exec sudo -n \
+    --preserve-env=OUTDIR,WORKLOAD_CMD,GLOBAL_NUMA_BALANCING,DEMOTION_SRC_NODE,DEMOTION_DST_NODE,CPU_NODE,MEM_NODE,SAMPLE_SEC \
+    -- "$0" "$@"
+fi
+
+OUTDIR="${OUTDIR:-/tmp/adaptive_migration_smoke}"
+WORKLOAD_CMD="${WORKLOAD_CMD:-/root/adaptive_workload.sh 4096 90}"
+GLOBAL_NUMA_BALANCING="${GLOBAL_NUMA_BALANCING:-2}"
+DEMOTION_SRC_NODE="${DEMOTION_SRC_NODE:-0}"
+DEMOTION_DST_NODE="${DEMOTION_DST_NODE:-1}"
+CPU_NODE="${CPU_NODE:-0}"
+MEM_NODE="${MEM_NODE:-1}"
+SAMPLE_SEC="${SAMPLE_SEC:-5}"
+
+mkdir -p "${OUTDIR}"
+
+snapshot_vmstat() {
+  local out="$1"
+  python3 > "${out}" <<'PY'
+keys = {
+    "numa_miss",
+    "numa_other",
+    "numa_hint_faults",
+    "numa_hint_faults_local",
+    "numa_pages_migrated",
+    "pgdemote_kswapd",
+    "pgdemote_direct",
+    "pgdemote_promoted",
+    "pgdemote_promoted_referenced",
+    "pgpromote_candidate",
+    "pgpromote_candidate_nrl",
+    "pgpromote_success",
+}
+
+with open("/proc/vmstat", "r", encoding="utf-8") as f:
+    for raw in f:
+        parts = raw.split()
+        if len(parts) == 2 and parts[0] in keys:
+            print(f"{parts[0]} {parts[1]}")
+PY
+}
+
+write_diff() {
+  local before="$1"
+  local after="$2"
+  local out="$3"
+
+  python3 - "$before" "$after" > "${out}" <<'PY'
+import sys
+
+def load(path):
+    data = {}
+    with open(path, "r", encoding="utf-8") as f:
+        for raw in f:
+            parts = raw.strip().split(None, 1)
+            if len(parts) != 2:
+                continue
+            try:
+                data[parts[0]] = int(parts[1])
+            except ValueError:
+                pass
+    return data
+
+before = load(sys.argv[1])
+after = load(sys.argv[2])
+for key in sorted(set(before) | set(after)):
+    print(f"{key} {after.get(key, 0) - before.get(key, 0)}")
+PY
+}
+
+write_summary() {
+  local diff="$1"
+  local exit_code="$2"
+  local out="$3"
+
+  python3 - "$diff" "$exit_code" > "${out}" <<'PY'
+import json
+import sys
+
+data = {}
+with open(sys.argv[1], "r", encoding="utf-8") as f:
+    for raw in f:
+        parts = raw.strip().split()
+        if len(parts) != 2:
+            continue
+        try:
+            data[parts[0]] = int(parts[1])
+        except ValueError:
+            pass
+
+summary = {
+    "workload_exit_code": int(sys.argv[2]),
+    "vmstat_diff": data,
+}
+json.dump(summary, sys.stdout, indent=2, sort_keys=True)
+sys.stdout.write("\n")
+PY
+}
+
+ORIG_GLOBAL_NUMA_BALANCING=""
+if [[ -w /proc/sys/kernel/numa_balancing ]]; then
+  ORIG_GLOBAL_NUMA_BALANCING="$(< /proc/sys/kernel/numa_balancing)"
+  if ! echo "${GLOBAL_NUMA_BALANCING}" > /proc/sys/kernel/numa_balancing 2>/dev/null; then
+    echo 1 > /proc/sys/kernel/numa_balancing
+  fi
+fi
+trap 'if [[ -n "${ORIG_GLOBAL_NUMA_BALANCING}" && -w /proc/sys/kernel/numa_balancing ]]; then echo "${ORIG_GLOBAL_NUMA_BALANCING}" > /proc/sys/kernel/numa_balancing || true; fi' EXIT
+
+if [[ -f /sys/kernel/mm/numa/demotion_enabled ]]; then
+  echo true > /sys/kernel/mm/numa/demotion_enabled
+fi
+if [[ -f /sys/kernel/mm/numa/demotion_target ]]; then
+  echo "${DEMOTION_SRC_NODE} ${DEMOTION_DST_NODE}" > /sys/kernel/mm/numa/demotion_target
+fi
+
+{
+  echo "uname_r $(uname -r)"
+  if [[ -r /proc/sys/kernel/numa_balancing ]]; then
+    echo "kernel.numa_balancing $(< /proc/sys/kernel/numa_balancing)"
+  fi
+  if [[ -r /sys/kernel/mm/numa/demotion_enabled ]]; then
+    echo "demotion_enabled $(< /sys/kernel/mm/numa/demotion_enabled)"
+  fi
+  if [[ -r /sys/kernel/mm/numa/demotion_target ]]; then
+    tr '\n' ';' < /sys/kernel/mm/numa/demotion_target | sed 's/^/demotion_target /'
+    echo
+  fi
+  echo "cpu_node ${CPU_NODE}"
+  echo "mem_node ${MEM_NODE}"
+  echo "sample_sec ${SAMPLE_SEC}"
+  echo "workload_cmd ${WORKLOAD_CMD}"
+} > "${OUTDIR}/meta.txt"
+
+if ! command -v numactl >/dev/null 2>&1; then
+  echo "numactl not found in guest" >&2
+  exit 1
+fi
+
+snapshot_vmstat "${OUTDIR}/vmstat.before"
+printf 'timestamp,key,value\n' > "${OUTDIR}/samples.csv"
+
+numactl --cpunodebind="${CPU_NODE}" --membind="${MEM_NODE}" \
+  bash -lc "${WORKLOAD_CMD}" > "${OUTDIR}/workload.log" 2>&1 &
+WORKLOAD_PID=$!
+
+while kill -0 "${WORKLOAD_PID}" 2>/dev/null; do
+  TS="$(date -u +%Y-%m-%dT%H:%M:%SZ)"
+  while read -r key value; do
+    [[ -n "${key:-}" && -n "${value:-}" ]] || continue
+    printf '%s,%s,%s\n' "${TS}" "${key}" "${value}" >> "${OUTDIR}/samples.csv"
+  done < <(python3 <<'PY'
+keys = {
+    "numa_hint_faults",
+    "numa_pages_migrated",
+    "pgdemote_promoted",
+    "pgdemote_promoted_referenced",
+    "pgpromote_success",
+}
+with open("/proc/vmstat", "r", encoding="utf-8") as f:
+    for raw in f:
+        parts = raw.split()
+        if len(parts) == 2 and parts[0] in keys:
+            print(parts[0], parts[1])
+PY
+)
+  sleep "${SAMPLE_SEC}"
+done
+
+set +e
+wait "${WORKLOAD_PID}"
+WORKLOAD_RC=$?
+set -e
+
+echo "${WORKLOAD_RC}" > "${OUTDIR}/exit_code"
+snapshot_vmstat "${OUTDIR}/vmstat.after"
+write_diff "${OUTDIR}/vmstat.before" "${OUTDIR}/vmstat.after" "${OUTDIR}/vmstat.diff"
+write_summary "${OUTDIR}/vmstat.diff" "${WORKLOAD_RC}" "${OUTDIR}/summary.local.json"
diff --git a/scripts/kernel/validate_dynamic_off_semantics_guest.sh b/scripts/kernel/validate_dynamic_off_semantics_guest.sh
new file mode 100644
index 000000000..0cab05a30
--- /dev/null
+++ b/scripts/kernel/validate_dynamic_off_semantics_guest.sh
@@ -0,0 +1,405 @@
+#!/usr/bin/env bash
+set -euo pipefail
+
+MBENCH="${MBENCH:-/root/mbench}"
+OUTDIR="${OUTDIR:-/tmp/dynamic_off_semantics}"
+RUN_ID="${RUN_ID:-$(date -u +%Y%m%dT%H%M%SZ)}"
+CGROOT="${CGROOT:-/sys/fs/cgroup}"
+
+LOCAL_NODE="${LOCAL_NODE:-0}"
+REMOTE_NODE="${REMOTE_NODE:-1}"
+CPUSET_CPUS="${CPUSET_CPUS:-0-15}"
+CPUSET_MEMS="${CPUSET_MEMS:-${LOCAL_NODE},${REMOTE_NODE}}"
+CAPACITY_PAGES="${CAPACITY_PAGES:-2097152}"
+THREADS="${THREADS:-16}"
+SAMPLE_MS="${SAMPLE_MS:-1000}"
+OPS_PER_PASS="${OPS_PER_PASS:-65536}"
+PAUSE_NS="${PAUSE_NS:-100000}"
+SCAN_PERIOD_SCALE="${SCAN_PERIOD_SCALE:-1}"
+HOT_THRESHOLD_MS="${HOT_THRESHOLD_MS:-1}"
+REMOTE_FIRSTTOUCH_SEC="${REMOTE_FIRSTTOUCH_SEC:-8}"
+
+MIGRATION_ARENA="${MIGRATION_ARENA:-12G}"
+MIGRATION_WINDOW="${MIGRATION_WINDOW:-8G}"
+MIGRATION_TIMEOUT_SEC="${MIGRATION_TIMEOUT_SEC:-${TIMEOUT_SEC:-180}}"
+MIGRATION_WAIT_SEC="${MIGRATION_WAIT_SEC:-120}"
+MIGRATION_POST_SEC="${MIGRATION_POST_SEC:-20}"
+
+DEMOTION_ARENA="${DEMOTION_ARENA:-12G}"
+DEMOTION_WINDOW="${DEMOTION_WINDOW:-12G}"
+DEMOTION_TIMEOUT_SEC="${DEMOTION_TIMEOUT_SEC:-${TIMEOUT_SEC:-180}}"
+DEMOTION_WAIT_SEC="${DEMOTION_WAIT_SEC:-120}"
+DEMOTION_POST_SEC="${DEMOTION_POST_SEC:-20}"
+
+RUN_ROOT="${OUTDIR}/${RUN_ID}"
+mkdir -p "${RUN_ROOT}"
+exec > >(tee -a "${RUN_ROOT}/guest.log") 2>&1
+
+log() {
+	printf '[dynamic-off] %s\n' "$*"
+}
+
+pick_knob_file() {
+	local cg="$1" name="$2" candidate
+
+	for candidate in "${cg}/${name}" "${cg}/memory.${name}"; do
+		if [[ -f "${candidate}" ]]; then
+			echo "${candidate}"
+			return 0
+		fi
+	done
+	return 1
+}
+
+write_knob() {
+	local cg="$1" name="$2" value="$3" knob
+
+	knob="$(pick_knob_file "${cg}" "${name}")"
+	echo "${value}" > "${knob}"
+}
+
+write_optional() {
+	local path="$1" value="$2"
+
+	if [[ -w "${path}" ]]; then
+		echo "${value}" > "${path}" || true
+	fi
+}
+
+set_global_numa() {
+	local value="$1"
+
+	if [[ ! -w /proc/sys/kernel/numa_balancing ]]; then
+		return 0
+	fi
+	if ! echo "${value}" > /proc/sys/kernel/numa_balancing 2>/dev/null; then
+		if [[ "${value}" != "0" ]]; then
+			echo 1 > /proc/sys/kernel/numa_balancing 2>/dev/null || true
+		fi
+	fi
+}
+
+enable_controllers() {
+	local ctrl
+
+	if [[ ! -f "${CGROOT}/cgroup.controllers" ]]; then
+		return 0
+	fi
+
+	for ctrl in cpuset memory; do
+		if grep -qw "${ctrl}" "${CGROOT}/cgroup.controllers" &&
+		   ! grep -qw "${ctrl}" "${CGROOT}/cgroup.subtree_control"; then
+			echo "+${ctrl}" > "${CGROOT}/cgroup.subtree_control" || true
+		fi
+	done
+}
+
+reset_cgroup_dir() {
+	local cg="$1" pid
+
+	if [[ ! -d "${cg}" ]]; then
+		return 0
+	fi
+	if [[ -f "${cg}/cgroup.procs" && -f "${CGROOT}/cgroup.procs" ]]; then
+		while IFS= read -r pid; do
+			[[ -n "${pid}" ]] || continue
+			echo "${pid}" > "${CGROOT}/cgroup.procs" 2>/dev/null || true
+		done < "${cg}/cgroup.procs"
+	fi
+	rmdir "${cg}" 2>/dev/null || true
+}
+
+setup_cgroup() {
+	local cg="$1" capacity_pages="$2" balancing="$3" demotion="$4"
+
+	reset_cgroup_dir "${cg}"
+	mkdir -p "${cg}"
+	if [[ -f "${cg}/cpuset.mems" ]]; then
+		echo "${CPUSET_MEMS}" > "${cg}/cpuset.mems"
+	fi
+	if [[ -f "${cg}/cpuset.cpus" ]]; then
+		echo "${CPUSET_CPUS}" > "${cg}/cpuset.cpus"
+	fi
+
+	write_knob "${cg}" "node_capacity" "${LOCAL_NODE} ${capacity_pages}"
+	write_knob "${cg}" "node_balancing" "${balancing}"
+	write_knob "${cg}" "kswapd_demotion_enabled" "${demotion}"
+	write_knob "${cg}" "numa_balancing_scan_period_scale" "${SCAN_PERIOD_SCALE}"
+	write_knob "${cg}" "numa_balancing_hot_threshold_ms" "${HOT_THRESHOLD_MS}"
+	write_knob "${cg}" "node_force_lru_evict" "${LOCAL_NODE} 1"
+}
+
+read_memstat() {
+	local cg="$1" key="$2" stat
+
+	stat="$(pick_knob_file "${cg}" "stat")"
+	awk -v key="${key}" '$1 == key { print $2; found = 1 } END { if (!found) print 0 }' "${stat}"
+}
+
+read_flat_key() {
+	local cg="$1" name="$2" key="$3" file
+
+	if ! file="$(pick_knob_file "${cg}" "${name}" 2>/dev/null)"; then
+		echo 0
+		return 0
+	fi
+	awk -v key="${key}" '$1 == key { print $2; found = 1 } END { if (!found) print 0 }' "${file}"
+}
+
+read_vmstat() {
+	local key="$1"
+
+	awk -v key="${key}" '$1 == key { print $2; found = 1 } END { if (!found) print 0 }' /proc/vmstat
+}
+
+snapshot() {
+	local cg="$1" out="$2"
+
+	{
+		printf 'time_epoch %s\n' "$(date +%s)"
+		printf 'node_balancing %s\n' "$(cat "$(pick_knob_file "${cg}" "node_balancing")")"
+		printf 'kswapd_demotion_enabled %s\n' "$(cat "$(pick_knob_file "${cg}" "kswapd_demotion_enabled")")"
+		printf 'MEMSTAT.numa_hint_faults %s\n' "$(read_memstat "${cg}" "numa_hint_faults")"
+		printf 'MEMSTAT.numa_page_migrate %s\n' "$(read_memstat "${cg}" "numa_page_migrate")"
+		printf 'MEMSTAT.pgpromote_success %s\n' "$(read_memstat "${cg}" "pgpromote_success")"
+		printf 'MEMSTAT.pgdemote_kswapd %s\n' "$(read_memstat "${cg}" "pgdemote_kswapd")"
+		printf 'MIGRATE.total %s\n' "$(read_flat_key "${cg}" "numa_migrate_state" "numa_migrate_success_total")"
+		printf 'MIGRATE.promotion %s\n' "$(read_flat_key "${cg}" "numa_migrate_state" "numa_migrate_success_promotion")"
+		printf 'VM.numa_pages_migrated %s\n' "$(read_vmstat "numa_pages_migrated")"
+		printf 'VM.pgpromote_success %s\n' "$(read_vmstat "pgpromote_success")"
+		printf 'VM.pgdemote_kswapd %s\n' "$(read_vmstat "pgdemote_kswapd")"
+	} > "${out}"
+}
+
+value_from_snapshot() {
+	local file="$1" key="$2"
+
+	awk -v key="${key}" '$1 == key { print $2; found = 1 } END { if (!found) print 0 }' "${file}"
+}
+
+run_mbench_in_cgroup() {
+	local cg="$1" timeout_sec="$2" arena="$3" window="$4" placement="$5" out="$6"
+
+	bash -lc "echo \$$ > '${cg}/cgroup.procs'; exec timeout --signal=TERM '${timeout_sec}' '${MBENCH}' --csv --quiet --sample-ms '${SAMPLE_MS}' --ops-per-pass '${OPS_PER_PASS}' --pause-ns '${PAUSE_NS}' --arena-size '${arena}' --mode bw --bw-kernel read --window-size '${window}' --move-policy fixed --placement '${placement}' --threads '${THREADS}'" \
+		> "${out}" 2>&1 &
+	echo $!
+}
+
+run_alloc_sleep_in_cgroup() {
+	local cg="$1" timeout_sec="$2" arena="$3" script="$4" out="$5"
+
+	bash -lc "echo \$$ > '${cg}/cgroup.procs'; exec timeout --signal=TERM '${timeout_sec}' python3 '${script}' '${arena}'" \
+		> "${out}" 2>&1 &
+	echo $!
+}
+
+restore_cpuset_mems_after_firsttouch() {
+	local cg="$1" firsttouch_mems="$2"
+
+	if [[ ! -f "${cg}/cpuset.mems" ]]; then
+		echo ""
+		return 0
+	fi
+
+	echo "${firsttouch_mems}" > "${cg}/cpuset.mems"
+	(
+		sleep "${REMOTE_FIRSTTOUCH_SEC}"
+		echo "${CPUSET_MEMS}" > "${cg}/cpuset.mems" 2>/dev/null || true
+	) >/dev/null 2>&1 &
+	echo $!
+}
+
+wait_for_counter_gt() {
+	local cg="$1" key="$2" initial="$3" limit_sec="$4" i value
+
+	for ((i = 0; i < limit_sec; i++)); do
+		value="$(read_memstat "${cg}" "${key}")"
+		if (( value > initial )); then
+			echo "${value}"
+			return 0
+		fi
+		sleep 1
+	done
+	echo "$(read_memstat "${cg}" "${key}")"
+	return 1
+}
+
+sample_after_off() {
+	local cg="$1" out="$2" seconds="$3" i
+
+	echo "sample,node_balancing,kswapd_demotion_enabled,cg_hint,cg_migrate,cg_promote,cg_demote,migrate_total,migrate_promotion,vm_migrated,vm_promote,vm_demote" > "${out}"
+	for ((i = 0; i <= seconds; i++)); do
+		printf '%s,%s,%s,%s,%s,%s,%s,%s,%s,%s,%s,%s\n' \
+			"${i}" \
+			"$(cat "$(pick_knob_file "${cg}" "node_balancing")")" \
+			"$(cat "$(pick_knob_file "${cg}" "kswapd_demotion_enabled")")" \
+			"$(read_memstat "${cg}" "numa_hint_faults")" \
+			"$(read_memstat "${cg}" "numa_page_migrate")" \
+			"$(read_memstat "${cg}" "pgpromote_success")" \
+			"$(read_memstat "${cg}" "pgdemote_kswapd")" \
+			"$(read_flat_key "${cg}" "numa_migrate_state" "numa_migrate_success_total")" \
+			"$(read_flat_key "${cg}" "numa_migrate_state" "numa_migrate_success_promotion")" \
+			"$(read_vmstat "numa_pages_migrated")" \
+			"$(read_vmstat "pgpromote_success")" \
+			"$(read_vmstat "pgdemote_kswapd")"
+		sleep 1
+	done >> "${out}"
+}
+
+delta_report() {
+	local label="$1" before="$2" after="$3" out="$4"
+	local key b a
+
+	{
+		printf 'label %s\n' "${label}"
+		for key in MEMSTAT.numa_hint_faults MEMSTAT.numa_page_migrate \
+			   MEMSTAT.pgpromote_success MEMSTAT.pgdemote_kswapd \
+			   MIGRATE.total MIGRATE.promotion VM.numa_pages_migrated \
+			   VM.pgpromote_success VM.pgdemote_kswapd; do
+			b="$(value_from_snapshot "${before}" "${key}")"
+			a="$(value_from_snapshot "${after}" "${key}")"
+			printf '%s %s\n' "${key}" "$((a - b))"
+		done
+	} > "${out}"
+}
+
+run_migration_off_test() {
+	local case_dir="${RUN_ROOT}/migration_off"
+	local cg="${CGROOT}/dynoff_migration"
+	local helper_pid pid initial_promote initial_migrate after_grace final_delta
+	local before_total pre_total
+
+	mkdir -p "${case_dir}"
+	log "migration-off: global=2 cgroup starts at 2, then cgroup node_balancing=0"
+	set_global_numa 2
+	write_optional /sys/kernel/mm/numa/demotion_enabled 1
+	write_optional /sys/kernel/mm/numa/demotion_target "${LOCAL_NODE} ${REMOTE_NODE}"
+	setup_cgroup "${cg}" "${CAPACITY_PAGES}" 2 0
+
+	snapshot "${cg}" "${case_dir}/before"
+	helper_pid="$(restore_cpuset_mems_after_firsttouch "${cg}" "${REMOTE_NODE}")"
+	pid="$(run_mbench_in_cgroup "${cg}" "${MIGRATION_TIMEOUT_SEC}" "${MIGRATION_ARENA}" "${MIGRATION_WINDOW}" "none" "${case_dir}/mbench.log")"
+	initial_promote="$(read_memstat "${cg}" "pgpromote_success")"
+	initial_migrate="$(read_flat_key "${cg}" "numa_migrate_state" "numa_migrate_success_total")"
+	wait_for_counter_gt "${cg}" "pgpromote_success" "${initial_promote}" "${MIGRATION_WAIT_SEC}" > "${case_dir}/promotion_seen" || true
+	snapshot "${cg}" "${case_dir}/pre_off"
+	write_knob "${cg}" "node_balancing" 0
+	log "migration-off: wrote node_balancing=0"
+	sample_after_off "${cg}" "${case_dir}/post_off.csv" "${MIGRATION_POST_SEC}"
+	snapshot "${cg}" "${case_dir}/post_off"
+	kill "${pid}" 2>/dev/null || true
+	wait "${pid}" 2>/dev/null || true
+	if [[ -n "${helper_pid}" ]]; then
+		wait "${helper_pid}" 2>/dev/null || true
+	fi
+
+	delta_report "migration_before_off" "${case_dir}/before" "${case_dir}/pre_off" "${case_dir}/before_off.delta"
+	delta_report "migration_after_off" "${case_dir}/pre_off" "${case_dir}/post_off" "${case_dir}/after_off.delta"
+	after_grace="$(awk -F, 'NR == 3 { print $8 }' "${case_dir}/post_off.csv")"
+	final_delta="$(read_flat_key "${cg}" "numa_migrate_state" "numa_migrate_success_total")"
+	final_delta=$((final_delta - after_grace))
+	before_total="$(value_from_snapshot "${case_dir}/before" "MIGRATE.total")"
+	pre_total="$(value_from_snapshot "${case_dir}/pre_off" "MIGRATE.total")"
+	if (( pre_total <= before_total )); then
+		echo "FAIL migration_off no_migration_observed_before_off before=${before_total} pre_off=${pre_total}" > "${case_dir}/result.txt"
+	elif (( final_delta == 0 )); then
+		echo "PASS migration_off stale_fault_migration_delta_after_grace=${final_delta}" > "${case_dir}/result.txt"
+	else
+		echo "FAIL migration_off stale_fault_migration_delta_after_grace=${final_delta}" > "${case_dir}/result.txt"
+	fi
+	cat "${case_dir}/result.txt"
+	reset_cgroup_dir "${cg}"
+}
+
+run_kswapd_off_test() {
+	local case_dir="${RUN_ROOT}/kswapd_off"
+	local cg="${CGROOT}/dynoff_kswapd"
+	local allocator="${case_dir}/alloc_sleep.py"
+	local helper_pid pid initial_demote after_grace final_demote delta
+	local before_demote pre_demote
+
+	mkdir -p "${case_dir}"
+	cat > "${allocator}" <<'PY'
+import mmap
+import sys
+import time
+
+def parse_size(raw):
+    raw = raw.strip().upper()
+    mult = 1
+    if raw.endswith("G"):
+        mult = 1024 ** 3
+        raw = raw[:-1]
+    elif raw.endswith("M"):
+        mult = 1024 ** 2
+        raw = raw[:-1]
+    elif raw.endswith("K"):
+        mult = 1024
+        raw = raw[:-1]
+    return int(float(raw) * mult)
+
+size = parse_size(sys.argv[1])
+mapping = mmap.mmap(-1, size)
+for offset in range(0, size, 4096):
+    mapping[offset:offset + 1] = b"x"
+print(f"touched {size} bytes", flush=True)
+while True:
+    time.sleep(1)
+PY
+	log "kswapd-off: demotion starts at 1, then kswapd_demotion_enabled=0"
+	set_global_numa 0
+	write_optional /sys/kernel/mm/numa/demotion_enabled 1
+	write_optional /sys/kernel/mm/numa/demotion_target "${LOCAL_NODE} ${REMOTE_NODE}"
+	setup_cgroup "${cg}" "${CAPACITY_PAGES}" 0 1
+
+	snapshot "${cg}" "${case_dir}/before"
+	helper_pid="$(restore_cpuset_mems_after_firsttouch "${cg}" "${LOCAL_NODE}")"
+	pid="$(run_alloc_sleep_in_cgroup "${cg}" "${DEMOTION_TIMEOUT_SEC}" "${DEMOTION_ARENA}" "${allocator}" "${case_dir}/allocator.log")"
+	initial_demote="$(read_memstat "${cg}" "pgdemote_kswapd")"
+	wait_for_counter_gt "${cg}" "pgdemote_kswapd" "${initial_demote}" "${DEMOTION_WAIT_SEC}" > "${case_dir}/demotion_seen" || true
+	snapshot "${cg}" "${case_dir}/pre_off"
+	write_knob "${cg}" "kswapd_demotion_enabled" 0
+	log "kswapd-off: wrote kswapd_demotion_enabled=0"
+	sample_after_off "${cg}" "${case_dir}/post_off.csv" "${DEMOTION_POST_SEC}"
+	snapshot "${cg}" "${case_dir}/post_off"
+	kill "${pid}" 2>/dev/null || true
+	wait "${pid}" 2>/dev/null || true
+	if [[ -n "${helper_pid}" ]]; then
+		wait "${helper_pid}" 2>/dev/null || true
+	fi
+
+	delta_report "kswapd_before_off" "${case_dir}/before" "${case_dir}/pre_off" "${case_dir}/before_off.delta"
+	delta_report "kswapd_after_off" "${case_dir}/pre_off" "${case_dir}/post_off" "${case_dir}/after_off.delta"
+	after_grace="$(awk -F, 'NR == 3 { print $7 }' "${case_dir}/post_off.csv")"
+	final_demote="$(read_memstat "${cg}" "pgdemote_kswapd")"
+	delta=$((final_demote - after_grace))
+	before_demote="$(value_from_snapshot "${case_dir}/before" "MEMSTAT.pgdemote_kswapd")"
+	pre_demote="$(value_from_snapshot "${case_dir}/pre_off" "MEMSTAT.pgdemote_kswapd")"
+	if (( pre_demote <= before_demote )); then
+		echo "FAIL kswapd_off no_demotion_observed_before_off before=${before_demote} pre_off=${pre_demote}" > "${case_dir}/result.txt"
+	elif (( delta == 0 )); then
+		echo "PASS kswapd_off demotion_delta_after_grace=${delta}" > "${case_dir}/result.txt"
+	else
+		echo "FAIL kswapd_off demotion_delta_after_grace=${delta}" > "${case_dir}/result.txt"
+	fi
+	cat "${case_dir}/result.txt"
+	reset_cgroup_dir "${cg}"
+}
+
+main() {
+	if [[ "${EUID}" -ne 0 ]]; then
+		echo "run as root" >&2
+		exit 1
+	fi
+	if [[ ! -x "${MBENCH}" ]]; then
+		echo "mbench binary not executable: ${MBENCH}" >&2
+		exit 1
+	fi
+
+	enable_controllers
+	run_migration_off_test
+	run_kswapd_off_test
+	log "artifacts: ${RUN_ROOT}"
+}
+
+main "$@"
diff --git a/scripts/kernel/validate_gapbs_sanity.sh b/scripts/kernel/validate_gapbs_sanity.sh
new file mode 100755
index 000000000..54902fe60
--- /dev/null
+++ b/scripts/kernel/validate_gapbs_sanity.sh
@@ -0,0 +1,171 @@
+#!/usr/bin/env bash
+set -euo pipefail
+
+if [[ "${EUID}" -ne 0 ]]; then
+  exec sudo -n \
+    --preserve-env=OUTDIR,BC_CMD,PR_CMD,CPU_NODE,MEM_NODE,SAMPLE_SEC,VERIFY_PATHS \
+    -- "$0" "$@"
+fi
+
+OUTDIR="${OUTDIR:-/tmp/gapbs_sanity}"
+BC_CMD="${BC_CMD:-/root/bc -g 20 -n 1}"
+PR_CMD="${PR_CMD:-/root/pr -g 20 -i 2 -n 1 -t1e-4}"
+CPU_NODE="${CPU_NODE:-0}"
+MEM_NODE="${MEM_NODE:-1}"
+SAMPLE_SEC="${SAMPLE_SEC:-1}"
+VERIFY_PATHS="${VERIFY_PATHS:-/root/bc /root/pr}"
+
+mkdir -p "${OUTDIR}"
+
+snapshot_vmstat() {
+  local out="$1"
+  python3 > "${out}" <<'PY'
+keys = {
+    "numa_miss",
+    "numa_other",
+    "numa_hint_faults",
+    "numa_hint_faults_local",
+    "numa_pages_migrated",
+    "pgdemote_kswapd",
+    "pgdemote_direct",
+    "pgdemote_promoted",
+    "pgdemote_promoted_referenced",
+    "pgpromote_candidate",
+    "pgpromote_candidate_nrl",
+    "pgpromote_success",
+}
+
+with open("/proc/vmstat", "r", encoding="utf-8") as f:
+    for raw in f:
+        parts = raw.split()
+        if len(parts) == 2 and parts[0] in keys:
+            print(f"{parts[0]} {parts[1]}")
+PY
+}
+
+write_diff() {
+  local before="$1"
+  local after="$2"
+  local out="$3"
+
+  python3 - "$before" "$after" > "${out}" <<'PY'
+import sys
+
+def load(path):
+    data = {}
+    with open(path, "r", encoding="utf-8") as f:
+        for raw in f:
+            parts = raw.strip().split(None, 1)
+            if len(parts) != 2:
+                continue
+            try:
+                data[parts[0]] = int(parts[1])
+            except ValueError:
+                pass
+    return data
+
+before = load(sys.argv[1])
+after = load(sys.argv[2])
+for key in sorted(set(before) | set(after)):
+    print(f"{key} {after.get(key, 0) - before.get(key, 0)}")
+PY
+}
+
+write_summary() {
+  local name="$1"
+  local cmd="$2"
+  local exit_code="$3"
+  local duration_sec="$4"
+  local diff="$5"
+  local out="$6"
+
+  python3 - "$name" "$cmd" "$exit_code" "$duration_sec" "$diff" > "${out}" <<'PY'
+import json
+import sys
+
+name = sys.argv[1]
+cmd = sys.argv[2]
+exit_code = int(sys.argv[3])
+duration_sec = float(sys.argv[4])
+diff_path = sys.argv[5]
+
+vmstat = {}
+with open(diff_path, "r", encoding="utf-8") as f:
+    for raw in f:
+        parts = raw.strip().split()
+        if len(parts) != 2:
+            continue
+        try:
+            vmstat[parts[0]] = int(parts[1])
+        except ValueError:
+            pass
+
+summary = {
+    "benchmark": name,
+    "cmd": cmd,
+    "duration_sec": duration_sec,
+    "exit_code": exit_code,
+    "vmstat_diff": vmstat,
+}
+json.dump(summary, sys.stdout, indent=2, sort_keys=True)
+sys.stdout.write("\n")
+PY
+}
+
+run_one() {
+  local name="$1"
+  local cmd="$2"
+  local case_dir="${OUTDIR}/${name}"
+  local start end duration rc
+
+  mkdir -p "${case_dir}"
+  snapshot_vmstat "${case_dir}/vmstat.before"
+
+  start="$(date +%s.%N)"
+  if command -v numactl >/dev/null 2>&1; then
+    set +e
+    numactl --cpunodebind="${CPU_NODE}" --membind="${MEM_NODE}" \
+      bash -lc "${cmd}" > "${case_dir}/run.log" 2>&1
+    rc=$?
+    set -e
+  else
+    set +e
+    bash -lc "${cmd}" > "${case_dir}/run.log" 2>&1
+    rc=$?
+    set -e
+  fi
+  end="$(date +%s.%N)"
+
+  echo "${rc}" > "${case_dir}/exit_code"
+  snapshot_vmstat "${case_dir}/vmstat.after"
+  write_diff "${case_dir}/vmstat.before" "${case_dir}/vmstat.after" "${case_dir}/vmstat.diff"
+  duration="$(python3 - "$start" "$end" <<'PY'
+import sys
+print(f"{float(sys.argv[2]) - float(sys.argv[1]):.6f}")
+PY
+)"
+  write_summary "${name}" "${cmd}" "${rc}" "${duration}" "${case_dir}/vmstat.diff" "${case_dir}/summary.json"
+
+  if [[ "${rc}" -ne 0 ]]; then
+    return "${rc}"
+  fi
+}
+
+{
+  echo "uname_r $(uname -r)"
+  echo "cpu_node ${CPU_NODE}"
+  echo "mem_node ${MEM_NODE}"
+  echo "sample_sec ${SAMPLE_SEC}"
+  echo "bc_cmd ${BC_CMD}"
+  echo "pr_cmd ${PR_CMD}"
+  for path in ${VERIFY_PATHS}; do
+    if [[ -e "${path}" ]]; then
+      ls -l "${path}"
+    else
+      echo "missing ${path}"
+    fi
+  done
+} > "${OUTDIR}/meta.txt"
+
+run_one bc "${BC_CMD}"
+run_one pr "${PR_CMD}"
diff --git a/scripts/kernel/validate_memcg_numa_knobs.sh b/scripts/kernel/validate_memcg_numa_knobs.sh
new file mode 100755
index 000000000..47b17d48a
--- /dev/null
+++ b/scripts/kernel/validate_memcg_numa_knobs.sh
@@ -0,0 +1,524 @@
+#!/usr/bin/env bash
+set -euo pipefail
+
+# Guest-side validation for memcg NUMA knobs.
+# Run as root, or as a user with passwordless sudo.
+
+if [[ "${EUID}" -ne 0 ]]; then
+  exec sudo -n \
+    --preserve-env=CASE,CGROOT,OUTDIR,CG_A,CG_B,CAPACITY_PAGES,CMD_A,CMD_B,\
+NODE_BALANCING_MODE_A,NODE_BALANCING_MODE_B,KSWAPD_DEMOTION_ENABLED,\
+DEMOTION_SRC_NODE,DEMOTION_DST_NODE,CPU_NODE,SCAN_PERIOD_SCALE_A,\
+SCAN_PERIOD_SCALE_B,HOT_THRESHOLD_MS_A,HOT_THRESHOLD_MS_B \
+    -- "$0" "$@"
+fi
+
+CGROOT="${CGROOT:-/sys/fs/cgroup}"
+OUTDIR="${OUTDIR:-/tmp/memcg_numa_knob_validation}"
+CASE="${CASE:-all}"
+CG_A="${CG_A:-numa_knob_A}"
+CG_B="${CG_B:-numa_knob_B}"
+CAPACITY_PAGES="${CAPACITY_PAGES:-2097152}"  # 8GiB / 4KiB
+CMD_A="${CMD_A:-/root/bc -g 26}"
+CMD_B="${CMD_B:-/root/pr -g 26}"
+NODE_BALANCING_MODE_A="${NODE_BALANCING_MODE_A:-2}"
+NODE_BALANCING_MODE_B="${NODE_BALANCING_MODE_B:-2}"
+KSWAPD_DEMOTION_ENABLED="${KSWAPD_DEMOTION_ENABLED:-1}"
+DEMOTION_SRC_NODE="${DEMOTION_SRC_NODE:-0}"
+DEMOTION_DST_NODE="${DEMOTION_DST_NODE:-1}"
+CPU_NODE="${CPU_NODE:-0}"
+SCAN_PERIOD_SCALE_A="${SCAN_PERIOD_SCALE_A:-100}"
+SCAN_PERIOD_SCALE_B="${SCAN_PERIOD_SCALE_B:-200}"
+HOT_THRESHOLD_MS_A="${HOT_THRESHOLD_MS_A:-0}"
+HOT_THRESHOLD_MS_B="${HOT_THRESHOLD_MS_B:-250}"
+
+mkdir -p "${OUTDIR}"
+
+expand_cpulist() {
+  local list="$1"
+  local part start end cpu
+  local -a parts
+
+  IFS=',' read -r -a parts <<< "${list}"
+  for part in "${parts[@]}"; do
+    if [[ "${part}" == *-* ]]; then
+      start="${part%-*}"
+      end="${part#*-}"
+      for ((cpu = start; cpu <= end; cpu++)); do
+        echo "${cpu}"
+      done
+    else
+      echo "${part}"
+    fi
+  done
+}
+
+build_split_cpu_sets() {
+  local node="$1"
+  local cpulist_path="/sys/devices/system/node/node${node}/cpulist"
+  local cpulist cpu package core key total half
+  local -a physical_cpus=()
+  local -A seen_cores=()
+  declare -g CPUSET_A CPUSET_B
+
+  cpulist="$(<"${cpulist_path}")"
+  while IFS= read -r cpu; do
+    [[ -z "${cpu}" ]] && continue
+    package="$(<"/sys/devices/system/cpu/cpu${cpu}/topology/physical_package_id")"
+    core="$(<"/sys/devices/system/cpu/cpu${cpu}/topology/core_id")"
+    key="${package}:${core}"
+    if [[ -n "${seen_cores[$key]:-}" ]]; then
+      continue
+    fi
+    seen_cores["$key"]="${cpu}"
+    physical_cpus+=("${cpu}")
+  done < <(expand_cpulist "${cpulist}")
+
+  total="${#physical_cpus[@]}"
+  if (( total < 2 )); then
+    echo "need at least two physical CPUs on node${node}" >&2
+    exit 1
+  fi
+
+  if (( total % 2 == 1 )); then
+    physical_cpus=("${physical_cpus[@]:0:$((total - 1))}")
+    total="${#physical_cpus[@]}"
+  fi
+
+  half=$(( total / 2 ))
+  CPUSET_A="$(IFS=,; echo "${physical_cpus[*]:0:half}")"
+  CPUSET_B="$(IFS=,; echo "${physical_cpus[*]:half:half}")"
+}
+
+pick_knob_file() {
+  local cg="$1"
+  local name="$2"
+  local f
+
+  for f in "${cg}/${name}" "${cg}/memory.${name}"; do
+    if [[ -f "${f}" ]]; then
+      echo "${f}"
+      return 0
+    fi
+  done
+
+  return 1
+}
+
+write_knob() {
+  local cg="$1"
+  local name="$2"
+  local value="$3"
+  local f
+
+  f="$(pick_knob_file "${cg}" "${name}")" || return 1
+  echo "${value}" > "${f}"
+}
+
+read_cpuset_value() {
+  local path="$1"
+  if [[ -f "${path}.effective" ]]; then
+    cat "${path}.effective"
+  elif [[ -f "${path}" ]]; then
+    cat "${path}"
+  else
+    return 1
+  fi
+}
+
+parse_stat_file() {
+  local path="$1"
+  python3 - "$path" <<'PY'
+import sys
+
+path = sys.argv[1]
+data = {}
+with open(path, "r", encoding="utf-8") as f:
+    for raw in f:
+        parts = raw.strip().split()
+        if len(parts) != 2:
+            continue
+        try:
+            data[parts[0]] = int(parts[1])
+        except ValueError:
+            continue
+for key in sorted(data):
+    print(f"{key} {data[key]}")
+PY
+}
+
+snapshot_cgroup_stats() {
+  local cg="$1"
+  local out="$2"
+
+  python3 - "$cg" > "${out}" <<'PY'
+import os
+import sys
+
+cg = sys.argv[1]
+
+def pick(name):
+    for path in (os.path.join(cg, name), os.path.join(cg, f"memory.{name}")):
+        if os.path.isfile(path):
+            return path
+    return None
+
+def parse_stat(path):
+    data = {}
+    if not path:
+        return data
+    with open(path, "r", encoding="utf-8") as f:
+        for raw in f:
+            parts = raw.strip().split()
+            if len(parts) != 2:
+                continue
+            try:
+                data[parts[0]] = int(parts[1])
+            except ValueError:
+                continue
+    return data
+
+def parse_kv(path):
+    data = {}
+    if not path:
+        return data
+    with open(path, "r", encoding="utf-8") as f:
+        for raw in f:
+            parts = raw.strip().split(None, 1)
+            if len(parts) == 2:
+                data[parts[0]] = parts[1]
+    return data
+
+stat = parse_stat(pick("stat"))
+reclaimd = parse_kv(pick("reclaimd_state"))
+migrate = parse_kv(pick("numa_migrate_state"))
+
+for key in (
+    "numa_hint_faults",
+    "numa_page_migrate",
+    "pgdemote_kswapd",
+    "pgpromote_success",
+):
+    print(f"MEMSTAT.{key} {stat.get(key, 0)}")
+
+for key in ("wake_count", "run_count"):
+    print(f"RECLAIMD.{key} {int(reclaimd.get(key, '0'))}")
+
+for key in (
+    "numa_migrate_success_total",
+    "numa_migrate_success_promotion",
+    "numa_migrate_success_other",
+):
+    print(f"MIGRATE.{key} {int(migrate.get(key, '0'))}")
+PY
+}
+
+snapshot_vmstat() {
+  local out="$1"
+  python3 > "${out}" <<'PY'
+keys = {
+    "numa_hint_faults",
+    "numa_hint_faults_local",
+    "numa_pages_migrated",
+    "pgdemote_kswapd",
+    "pgpromote_candidate",
+    "pgpromote_candidate_nrl",
+    "pgpromote_success",
+}
+
+with open("/proc/vmstat", "r", encoding="utf-8") as f:
+    for raw in f:
+        parts = raw.split()
+        if len(parts) == 2 and parts[0] in keys:
+            print(f"{parts[0]} {parts[1]}")
+PY
+}
+
+write_diff() {
+  local before="$1"
+  local after="$2"
+  local out="$3"
+
+  python3 - "$before" "$after" > "${out}" <<'PY'
+import sys
+
+def load(path):
+    data = {}
+    with open(path, "r", encoding="utf-8") as f:
+        for raw in f:
+            parts = raw.strip().split(None, 1)
+            if len(parts) != 2:
+                continue
+            try:
+                data[parts[0]] = int(parts[1])
+            except ValueError:
+                data[parts[0]] = parts[1]
+    return data
+
+before = load(sys.argv[1])
+after = load(sys.argv[2])
+for key in sorted(set(before) | set(after)):
+    print(f"{key} {after.get(key, 0) - before.get(key, 0)}")
+PY
+}
+
+summary_report() {
+  local diff_a="$1"
+  local diff_b="$2"
+  local runner_a="$3"
+  local runner_b="$4"
+  local out="$5"
+
+  python3 - "$diff_a" "$diff_b" "$runner_a" "$runner_b" > "${out}" <<'PY'
+import sys
+import re
+
+def load(path):
+    data = {}
+    with open(path, "r", encoding="utf-8") as f:
+        for raw in f:
+            parts = raw.strip().split(None, 1)
+            if len(parts) != 2:
+                continue
+            try:
+                data[parts[0]] = int(parts[1])
+            except ValueError:
+                pass
+    return data
+
+def runtime_seconds(path):
+    with open(path, "r", encoding="utf-8") as f:
+        for raw in reversed(f.readlines()):
+            match = re.search(r"execution time ([0-9.]+) \(s\)", raw)
+            if match:
+                return match.group(1)
+    return "NA"
+
+a = load(sys.argv[1])
+b = load(sys.argv[2])
+runtime_a = runtime_seconds(sys.argv[3])
+runtime_b = runtime_seconds(sys.argv[4])
+
+keys = [
+    "MEMSTAT.numa_hint_faults",
+    "MEMSTAT.numa_page_migrate",
+    "MEMSTAT.pgpromote_success",
+    "RECLAIMD.wake_count",
+    "RECLAIMD.run_count",
+    "MIGRATE.numa_migrate_success_total",
+    "MIGRATE.numa_migrate_success_promotion",
+]
+
+print("Metric,A,B")
+for key in keys:
+    print(f"{key},{a.get(key, 0)},{b.get(key, 0)}")
+print(f"RUNNER.execution_time_sec,{runtime_a},{runtime_b}")
+PY
+}
+
+write_case_metadata() {
+  local case_dir="$1"
+  local case_name="$2"
+  local cg_a="$3"
+  local cg_b="$4"
+  local scale_a="$5"
+  local scale_b="$6"
+  local hot_a="$7"
+  local hot_b="$8"
+
+  cat > "${case_dir}/case.meta" <<EOF
+case_name=${case_name}
+cg_a=${cg_a}
+cg_b=${cg_b}
+cpuset_a=${CPUSET_A}
+cpuset_b=${CPUSET_B}
+node_balancing_mode_a=${NODE_BALANCING_MODE_A}
+node_balancing_mode_b=${NODE_BALANCING_MODE_B}
+scan_period_scale_a=${scale_a}
+scan_period_scale_b=${scale_b}
+hot_threshold_ms_a=${hot_a}
+hot_threshold_ms_b=${hot_b}
+capacity_pages=${CAPACITY_PAGES}
+cpu_node=${CPU_NODE}
+demotion_src_node=${DEMOTION_SRC_NODE}
+demotion_dst_node=${DEMOTION_DST_NODE}
+cmd_a=${CMD_A}
+cmd_b=${CMD_B}
+EOF
+}
+
+enable_controllers() {
+  if [[ -f "${CGROOT}/cgroup.controllers" ]]; then
+    if grep -qw memory "${CGROOT}/cgroup.controllers"; then
+      grep -qw memory "${CGROOT}/cgroup.subtree_control" || echo +memory > "${CGROOT}/cgroup.subtree_control" || true
+    fi
+    if grep -qw cpuset "${CGROOT}/cgroup.controllers"; then
+      grep -qw cpuset "${CGROOT}/cgroup.subtree_control" || echo +cpuset > "${CGROOT}/cgroup.subtree_control" || true
+    fi
+  fi
+}
+
+reset_cgroup_dir() {
+  local cg="$1"
+  local root_procs="${CGROOT}/cgroup.procs"
+  local cg_procs="${cg}/cgroup.procs"
+  local pid
+
+  if [[ ! -d "${cg}" ]]; then
+    return 0
+  fi
+
+  if [[ -f "${cg_procs}" && -f "${root_procs}" ]]; then
+    while IFS= read -r pid; do
+      [[ -n "${pid}" ]] || continue
+      echo "${pid}" > "${root_procs}" || true
+    done < "${cg_procs}"
+  fi
+
+  rmdir "${cg}" 2>/dev/null || true
+}
+
+setup_cgroup() {
+  local cg="$1"
+  local cpus="$2"
+  local mode="$3"
+  local mems="$4"
+  local scale="$5"
+  local hot_th="$6"
+
+  reset_cgroup_dir "${cg}"
+  mkdir -p "${cg}"
+  echo "${mems}" > "${cg}/cpuset.mems"
+  echo "${cpus}" > "${cg}/cpuset.cpus"
+  if ! write_knob "${cg}" node_capacity "0 ${CAPACITY_PAGES}"; then
+    echo "missing node_capacity knob under ${cg}" >&2
+    exit 1
+  fi
+  if ! write_knob "${cg}" node_balancing "${mode}"; then
+    echo "missing node_balancing knob under ${cg}" >&2
+    exit 1
+  fi
+  if ! write_knob "${cg}" kswapd_demotion_enabled "${KSWAPD_DEMOTION_ENABLED}"; then
+    echo "missing kswapd_demotion_enabled knob under ${cg}" >&2
+    exit 1
+  fi
+  if ! write_knob "${cg}" node_force_lru_evict "0 1"; then
+    echo "missing node_force_lru_evict knob under ${cg}" >&2
+    exit 1
+  fi
+  if ! write_knob "${cg}" numa_balancing_scan_period_scale "${scale}"; then
+    echo "missing numa_balancing_scan_period_scale knob under ${cg}" >&2
+    exit 1
+  fi
+  if ! write_knob "${cg}" numa_balancing_hot_threshold_ms "${hot_th}"; then
+    echo "missing numa_balancing_hot_threshold_ms knob under ${cg}" >&2
+    exit 1
+  fi
+}
+
+run_workload_pair() {
+  local cg_a="$1"
+  local cg_b="$2"
+  local outdir="$3"
+  local cmd_a="$4"
+  local cmd_b="$5"
+
+  local proc_a="${cg_a}/cgroup.procs"
+  local proc_b="${cg_b}/cgroup.procs"
+
+  bash -lc "echo \$$ > '${proc_a}'; exec /usr/bin/time -f 'execution time %e (s)' ${cmd_a}" \
+    > "${outdir}/A.runner.txt" 2>&1 &
+  pid_a=$!
+
+  bash -lc "echo \$$ > '${proc_b}'; exec /usr/bin/time -f 'execution time %e (s)' ${cmd_b}" \
+    > "${outdir}/B.runner.txt" 2>&1 &
+  pid_b=$!
+
+  wait "${pid_a}"
+  wait "${pid_b}"
+}
+
+run_case() {
+  local case_name="$1"
+  local scale_a="$2"
+  local scale_b="$3"
+  local hot_a="$4"
+  local hot_b="$5"
+  local case_dir="${OUTDIR}/${case_name}"
+  local cg_a="${CGROOT}/${CG_A}-${case_name}-A"
+  local cg_b="${CGROOT}/${CG_B}-${case_name}-B"
+  local cpu_mems
+
+  mkdir -p "${case_dir}"
+  build_split_cpu_sets "${CPU_NODE}"
+  cpu_mems="$(read_cpuset_value "${CGROOT}/cpuset.mems")"
+
+  setup_cgroup "${cg_a}" "${CPUSET_A}" "${NODE_BALANCING_MODE_A}" "${cpu_mems}" "${scale_a}" "${hot_a}"
+  setup_cgroup "${cg_b}" "${CPUSET_B}" "${NODE_BALANCING_MODE_B}" "${cpu_mems}" "${scale_b}" "${hot_b}"
+  write_case_metadata "${case_dir}" "${case_name}" "${cg_a}" "${cg_b}" \
+    "${scale_a}" "${scale_b}" "${hot_a}" "${hot_b}"
+
+  echo "[case:${case_name}] A scale=${scale_a} hot_threshold_ms=${hot_a}"
+  echo "[case:${case_name}] B scale=${scale_b} hot_threshold_ms=${hot_b}"
+  echo "[case:${case_name}] A cpus=${CPUSET_A}"
+  echo "[case:${case_name}] B cpus=${CPUSET_B}"
+
+  snapshot_cgroup_stats "${cg_a}" "${case_dir}/A.before"
+  snapshot_cgroup_stats "${cg_b}" "${case_dir}/B.before"
+  snapshot_vmstat "${case_dir}/vmstat.before"
+
+  run_workload_pair "${cg_a}" "${cg_b}" "${case_dir}" "${CMD_A}" "${CMD_B}"
+
+  snapshot_cgroup_stats "${cg_a}" "${case_dir}/A.after"
+  snapshot_cgroup_stats "${cg_b}" "${case_dir}/B.after"
+  snapshot_vmstat "${case_dir}/vmstat.after"
+
+  write_diff "${case_dir}/A.before" "${case_dir}/A.after" "${case_dir}/A.diff"
+  write_diff "${case_dir}/B.before" "${case_dir}/B.after" "${case_dir}/B.diff"
+  write_diff "${case_dir}/vmstat.before" "${case_dir}/vmstat.after" "${case_dir}/vmstat.diff"
+  summary_report "${case_dir}/A.diff" "${case_dir}/B.diff" \
+    "${case_dir}/A.runner.txt" "${case_dir}/B.runner.txt" \
+    "${case_dir}/summary.csv"
+
+  echo "[case:${case_name}] summary:"
+  cat "${case_dir}/summary.csv"
+
+  reset_cgroup_dir "${cg_a}"
+  reset_cgroup_dir "${cg_b}"
+}
+
+main() {
+  enable_controllers
+
+  if [[ -f /sys/kernel/mm/numa/demotion_enabled ]]; then
+    echo true > /sys/kernel/mm/numa/demotion_enabled
+  fi
+
+  if [[ -f /sys/kernel/mm/numa/demotion_target ]]; then
+    echo "${DEMOTION_SRC_NODE} ${DEMOTION_DST_NODE}" > /sys/kernel/mm/numa/demotion_target
+  fi
+
+  echo 0 > /proc/sys/kernel/numa_balancing
+  echo 2 > /proc/sys/kernel/numa_balancing
+
+  case "${CASE}" in
+    all)
+      run_case "scan-scale" "${SCAN_PERIOD_SCALE_A}" "${SCAN_PERIOD_SCALE_B}" 0 0
+      run_case "hot-threshold" 100 100 "${HOT_THRESHOLD_MS_A}" "${HOT_THRESHOLD_MS_B}"
+      ;;
+    scan-scale)
+      run_case "scan-scale" "${SCAN_PERIOD_SCALE_A}" "${SCAN_PERIOD_SCALE_B}" 0 0
+      ;;
+    hot-threshold)
+      run_case "hot-threshold" 100 100 "${HOT_THRESHOLD_MS_A}" "${HOT_THRESHOLD_MS_B}"
+      ;;
+    *)
+      echo "unknown CASE: ${CASE}" >&2
+      exit 1
+      ;;
+  esac
+
+  echo "[done] output directory: ${OUTDIR}"
+}
+
+main "$@"
diff --git a/scripts/kernel/validate_memcg_scoped_numa_balancing.sh b/scripts/kernel/validate_memcg_scoped_numa_balancing.sh
new file mode 100755
index 000000000..9cc3336d9
