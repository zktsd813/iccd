+  case "$1" in
+    --rootfs)
+      ROOTFS_IMAGE="${2:-}"; shift 2 ;;
+    --rootfs-format)
+      ROOTFS_FORMAT="${2:-}"; shift 2 ;;
+    --kernel-image)
+      KERNEL_IMAGE="${2:-}"; shift 2 ;;
+    --kernel-dir)
+      KERNEL_DIR="${2:-}"; shift 2 ;;
+    --root-device)
+      ROOT_DEVICE="${2:-}"; shift 2 ;;
+    --drive-if)
+      DRIVE_IF="${2:-}"; shift 2 ;;
+    --local-dram)
+      LOCAL_DRAM="${2:-}"; shift 2 ;;
+    --remote-mem)
+      REMOTE_MEM="${2:-}"; shift 2 ;;
+    --host-cpu-node)
+      HOST_CPU_NODE="${2:-}"; shift 2 ;;
+    --host-fast-mem-node)
+      HOST_FAST_MEM_NODE="${2:-}"; shift 2 ;;
+    --host-slow-mem-node)
+      HOST_SLOW_MEM_NODE="${2:-}"; shift 2 ;;
+    --name)
+      VM_NAME="${2:-}"; shift 2 ;;
+    --serial-log)
+      SERIAL_LOG="${2:-}"; shift 2 ;;
+    --cmdline)
+      CMDLINE="${2:-}"; shift 2 ;;
+    --qemu-bin)
+      QEMU_BIN="${2:-}"; shift 2 ;;
+    --daemonize)
+      DAEMONIZE="1"; shift ;;
+    --dry-run)
+      DRY_RUN="1"; shift ;;
+    -h|--help)
+      usage; exit 0 ;;
+    *)
+      echo "Unknown option: $1" >&2
+      usage >&2
+      exit 1 ;;
+  esac
+done
+
+if [[ -z "${KERNEL_IMAGE}" ]]; then
+  KERNEL_IMAGE="${KERNEL_DIR}/arch/x86/boot/bzImage"
+fi
+
+if [[ ! -f "${ROOTFS_IMAGE}" ]]; then
+  echo "rootfs image not found: ${ROOTFS_IMAGE}" >&2
+  exit 1
+fi
+
+if [[ ! -f "${KERNEL_IMAGE}" ]]; then
+  echo "kernel image not found: ${KERNEL_IMAGE}" >&2
+  exit 1
+fi
+
+if ! command -v "${QEMU_BIN}" >/dev/null 2>&1; then
+  echo "qemu binary not found: ${QEMU_BIN}" >&2
+  exit 1
+fi
+
+if [[ -r /dev/kvm && -w /dev/kvm ]]; then
+  RUN_PREFIX=()
+elif sudo -n test -r /dev/kvm -a -w /dev/kvm 2>/dev/null; then
+  RUN_PREFIX=( sudo -n )
+else
+  echo "KVM is required for this launcher but /dev/kvm is not accessible" >&2
+  exit 1
+fi
+
+HOST_CPU_LIST="$(<"/sys/devices/system/node/node${HOST_CPU_NODE}/cpulist")"
+if [[ -z "${HOST_CPU_LIST}" ]]; then
+  echo "host node ${HOST_CPU_NODE} has no CPUs" >&2
+  exit 1
+fi
+
+GUEST_CPUS="$(
+  python3 - "${HOST_CPU_LIST}" <<'PY'
+import sys
+
+count = 0
+for part in sys.argv[1].split(','):
+    if '-' in part:
+        lo, hi = part.split('-', 1)
+        count += int(hi) - int(lo) + 1
+    elif part:
+        count += 1
+print(count)
+PY
+)"
+if [[ -z "${GUEST_CPUS}" || "${GUEST_CPUS}" == "0" ]]; then
+  echo "failed to derive guest CPU count from host cpulist ${HOST_CPU_LIST}" >&2
+  exit 1
+fi
+
+if [[ -z "${CMDLINE}" ]]; then
+  CMDLINE="console=ttyS0 root=${ROOT_DEVICE} rw loglevel=7 nokaslr"
+fi
+
+TOTAL_MEM="$(
+  python3 - "${LOCAL_DRAM}" "${REMOTE_MEM}" <<'PY'
+import sys
+
+units = {"K": 1024, "M": 1024**2, "G": 1024**3, "T": 1024**4}
+
+def parse(value: str) -> int:
+    value = value.strip().upper()
+    if value[-1] in units:
+        return int(value[:-1]) * units[value[-1]]
+    return int(value)
+
+total_bytes = parse(sys.argv[1]) + parse(sys.argv[2])
+if total_bytes % (1024 ** 4) == 0:
+    print(f"{total_bytes // (1024 ** 4)}T")
+elif total_bytes % (1024 ** 3) == 0:
+    print(f"{total_bytes // (1024 ** 3)}G")
+elif total_bytes % (1024 ** 2) == 0:
+    print(f"{total_bytes // (1024 ** 2)}M")
+else:
+    print(str(total_bytes))
+PY
+)"
+
+LOG_DIR="${SCRIPT_DIR}/qemu-logs"
+mkdir -p "${LOG_DIR}"
+STAMP="$(date +%Y%m%d_%H%M%S)"
+if [[ -z "${SERIAL_LOG}" ]]; then
+  SERIAL_LOG="${LOG_DIR}/${VM_NAME}_${STAMP}.serial.log"
+fi
+
+TASKSET_BIN="$(command -v taskset)"
+
+QEMU_CMD=(
+  "${QEMU_BIN}"
+  -name "${VM_NAME}"
+  -machine q35
+  -accel kvm
+  -cpu host
+  -smp "${GUEST_CPUS}"
+  -m "${TOTAL_MEM}"
+  -kernel "${KERNEL_IMAGE}"
+  -append "${CMDLINE}"
+  -drive "file=${ROOTFS_IMAGE},if=${DRIVE_IF},format=${ROOTFS_FORMAT}"
+  -object "memory-backend-ram,id=mem0,size=${LOCAL_DRAM},host-nodes=${HOST_FAST_MEM_NODE},policy=bind"
+  -object "memory-backend-ram,id=mem1,size=${REMOTE_MEM},host-nodes=${HOST_SLOW_MEM_NODE},policy=bind"
+  -numa "node,nodeid=0,cpus=0-$((GUEST_CPUS - 1)),memdev=mem0"
+  -numa "node,nodeid=1,memdev=mem1"
+  -serial "file:${SERIAL_LOG}"
+  -display none
+  -monitor none
+)
+
+if [[ "${DAEMONIZE}" == "1" ]]; then
+  QEMU_CMD+=( -daemonize )
+fi
+
+FULL_CMD=( "${RUN_PREFIX[@]}" "${TASKSET_BIN}" -c "${HOST_CPU_LIST}" "${QEMU_CMD[@]}" )
+
+echo "Paper VM launch plan"
+echo "  kernel       : ${KERNEL_IMAGE}"
+echo "  rootfs       : ${ROOTFS_IMAGE}"
+echo "  host cpu node: ${HOST_CPU_NODE}"
+echo "  host cpus    : ${HOST_CPU_LIST}"
+echo "  guest cpus   : ${GUEST_CPUS}"
+echo "  guest memory : ${TOTAL_MEM}"
+echo "  guest node0  : ${LOCAL_DRAM} on host node ${HOST_FAST_MEM_NODE}"
+echo "  guest node1  : ${REMOTE_MEM} on host node ${HOST_SLOW_MEM_NODE}"
+echo "  serial log   : ${SERIAL_LOG}"
+if [[ "${DAEMONIZE}" == "1" ]]; then
+  echo "  daemonize    : enabled"
+fi
+if (( ${#RUN_PREFIX[@]} > 0 )); then
+  echo "  qemu user    : sudo -n"
+fi
+echo
+printf 'Command:\n  '
+printf '%q ' "${FULL_CMD[@]}"
+echo
+
+if [[ "${DRY_RUN}" == "1" ]]; then
+  exit 0
+fi
+
+exec "${FULL_CMD[@]}"
diff --git a/scripts/kernel/prepare_paper_workloads_overlay.sh b/scripts/kernel/prepare_paper_workloads_overlay.sh
