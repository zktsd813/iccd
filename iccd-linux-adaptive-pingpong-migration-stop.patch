+void mem_cgroup_numa_reset_earlystop(struct mem_cgroup *memcg, bool running)
+{
+	struct memcg_numa_earlystop_data *data;
+	unsigned long flags;
+
+	if (!memcg)
+		return;
+
+	data = &memcg->numa_earlystop;
+	spin_lock_irqsave(&data->lock, flags);
+	data->previous_slope = 0;
+	atomic_long_set(&data->current_demote_promoted, 0);
+	data->previous_demote_promoted = 0;
+	data->threshold = MEMCG_NUMA_EARLYSTOP_THRESHOLD;
+	data->earlystop_cnt = 0;
+	data->previous_point = 0;
+	data->slope_max = MEMCG_NUMA_EARLYSTOP_SLOPE_MAX;
+	data->slope_cnt = 0;
+	data->ignore = 0;
+	memset(data->delta, 0, sizeof(data->delta));
+	data->delta_cnt = 0;
+	memset(&memcg->numa_restart, 0, sizeof(memcg->numa_restart));
+	WRITE_ONCE(memcg->numa_page_migration_running, running);
+	spin_unlock_irqrestore(&data->lock, flags);
+}
