config=tiering_0x2
workload=bc
local_size_gib=32
workload_command_kind=bc
numa_balancing=2
demotion_enabled=true
demotion_target=0 1
placement=numactl --cpunodebind=0 
command=numactl --cpunodebind=0 /root/benchmark/gapbs/bc -f /root/gapbs_graphs/kron_g29.sg -i 1 -n 8 
controller_enabled=0
cpu_node=0
omp_threads=32
timeout_sec=21600
sample_interval_sec=5
thp_mode=
thp_defrag=
realworld_size_profile=rss60
gapbs_graph_mode=prebuilt
gapbs_graph_scale=29
gapbs_graph_path=/root/gapbs_graphs/kron_g29.sg
graph=/root/gapbs_graphs/kron_g29.sg
graph_build_included=0
pr_trials=8
bc_trials=8
pr_iterations=20
bc_iterations=1
pr_tolerance=1e-4
