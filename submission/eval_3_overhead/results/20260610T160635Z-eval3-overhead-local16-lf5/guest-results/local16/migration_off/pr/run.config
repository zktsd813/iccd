config=migration_off
workload=pr
local_size_gib=16
workload_command_kind=pr
numa_balancing=0
demotion_enabled=false
demotion_target=0 -1
numa_scan_size_mb=256
numa_scan_period_min_ms=1000
local_fault_rate_override=5
remote_fault_rate_override=0
local_fault_scan_period_ms_override=1000
local_fault_scan_size_mb_override=256
remote_fault_scan_period_ms_override=1000
remote_fault_scan_size_mb_override=256
placement=numactl --cpunodebind=0 
command=numactl --cpunodebind=0 /root/benchmark/gapbs/pr -f /root/gapbs_graphs/kron_g29.sg -i 20 -t 1e-4 -n 8 
controller_enabled=0
cpu_node=0
omp_threads=32
timeout_sec=21600
sample_interval_sec=5
thp_mode=
thp_defrag=
realworld_size_profile=rss60
trace_bc_trial_promotions=0
gapbs_graph_mode=prebuilt
gapbs_graph_scale=29
gapbs_graph_path=/root/gapbs_graphs/kron_g29.sg
graph=/root/gapbs_graphs/kron_g29.sg
graph_build_included=0
pr_trials=8
bc_trials=8
pr_iterations=20
bc_iterations=1
pr_tolerance=1e-4
